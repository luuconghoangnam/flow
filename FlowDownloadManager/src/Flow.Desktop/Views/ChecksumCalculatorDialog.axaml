<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrls="using:Flow.Desktop.Controls"
        x:Class="Flow.Desktop.Views.ChecksumCalculatorDialog"
        Title="File Checksum"
        Width="440" Height="370"
        CanResize="False"
        Background="#0A0A0A"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/icon.ico"
        RequestedThemeVariant="Dark">

    <Grid>
        <ctrls:CyberGridBackground GridSpacing="24" GridColor="#151515" />

        <DockPanel Margin="20">
            <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,*,Auto" Margin="0,16,0,0">
                <!-- Calculate button on left (matching main app's [Start] [Close] pattern) -->
                <ctrls:CyberBorder Grid.Column="0" ChamferSize="6" BorderBrush="#E64A00" BorderThickness="1" Background="#E64A00">
                    <Button Classes="cyber-primary" Content="Calculate" Click="OnCalculateClick" BorderThickness="0" Background="Transparent" Height="36" Width="120" HorizontalContentAlignment="Center"/>
                </ctrls:CyberBorder>
                <Button Grid.Column="2" Classes="cyber" Content="Close" Click="OnDismissClick" Height="36" Width="100" HorizontalContentAlignment="Center"/>
            </Grid>

            <StackPanel Spacing="16">
                <StackPanel Spacing="4">
                    <TextBlock Text="Target File" 
                               FontFamily="JetBrains Mono" 
                               FontSize="11" 
                               Foreground="#888888" 
                               FontWeight="Bold"/>
                    <TextBlock Name="FileNameTextBlock" 
                               Text="file.bin"
                               FontFamily="JetBrains Mono" 
                               FontSize="13" 
                               FontWeight="Bold" 
                               Foreground="#E5E7EB"
                               TextWrapping="Wrap"/>
                    <TextBlock Name="FilePathTextBlock" 
                               Text="C:\Downloads\file.bin"
                               FontFamily="JetBrains Mono" 
                               FontSize="10" 
                               Foreground="#555555"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Algorithm" 
                               FontFamily="JetBrains Mono" 
                               FontSize="11" 
                               Foreground="#888888" 
                               FontWeight="Bold"/>
                    <StackPanel Orientation="Horizontal" Spacing="20">
                        <RadioButton Name="Md5Radio" Content="MD5" IsChecked="True" FontFamily="JetBrains Mono" Foreground="#E5E7EB" Checked="OnAlgorithmChecked"/>
                        <RadioButton Name="Sha1Radio" Content="SHA-1" FontFamily="JetBrains Mono" Foreground="#E5E7EB" Checked="OnAlgorithmChecked"/>
                        <RadioButton Name="Sha256Radio" Content="SHA-256" FontFamily="JetBrains Mono" Foreground="#E5E7EB" Checked="OnAlgorithmChecked"/>
                    </StackPanel>
                </StackPanel>

                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto" Margin="0,4,0,0">
                    <ProgressBar Grid.Column="0" 
                                 Name="CalculationProgressBar" 
                                 Minimum="0" 
                                 Maximum="100" 
                                 Value="0"
                                 Background="#1A1A1A" 
                                 Foreground="#E64A00" 
                                 Height="4" 
                                 CornerRadius="0"
                                 VerticalAlignment="Center"
                                 Margin="0,0,16,0"/>
                    <TextBlock Grid.Column="1" 
                               Name="ProgressPercentTextBlock" 
                               Text="0%" 
                               FontFamily="JetBrains Mono" 
                               FontSize="12" 
                               Foreground="#E5E7EB" 
                               VerticalAlignment="Center"/>
                </Grid>

                <StackPanel Spacing="6">
                    <TextBlock Text="Checksum" 
                               FontFamily="JetBrains Mono" 
                               FontSize="11" 
                               Foreground="#888888" 
                               FontWeight="Bold"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Grid.Column="0" 
                                 Name="CalculatedHashTextBox" 
                                 Classes="cyber" 
                                 IsReadOnly="True"
                                 Watermark="Calculating..."
                                 Height="36" 
                                 Padding="12,8"
                                 Margin="0,0,8,0"/>
                        <Button Grid.Column="1" 
                                Name="CopyButton"
                                Classes="cyber" 
                                Content="Copy" 
                                Click="OnCopyClick"
                                IsEnabled="False"
                                Height="36" 
                                Padding="16,0"
                                HorizontalContentAlignment="Center"/>
                    </Grid>
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Compare with expected" 
                               FontFamily="JetBrains Mono" 
                               FontSize="11" 
                               Foreground="#888888" 
                               FontWeight="Bold"/>
                    <TextBox Name="CompareTextBox" 
                             Classes="cyber" 
                             Watermark="Paste expected checksum..."
                             Height="36" 
                             Padding="12,8"
                             TextChanged="OnCompareTextChanged"/>
                </StackPanel>

                <Border Name="ResultBorder" BorderThickness="1" Padding="12,8" IsVisible="False">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Name="ResultIconTextBlock" 
                                   Text="✓" 
                                   FontFamily="JetBrains Mono" 
                                   FontSize="12" 
                                   FontWeight="Bold" 
                                   VerticalAlignment="Center"/>
                        <TextBlock Name="ResultTextBlock" 
                                   Text="MATCH" 
                                   FontFamily="JetBrains Mono" 
                                   FontSize="11" 
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
