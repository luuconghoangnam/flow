<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrls="using:Flow.Desktop.Controls"
        x:Class="Flow.Desktop.Views.AddDownloadDialog"
        Title="Add Download"
        Width="460" Height="250"
        CanResize="False"
        Background="#0A0A0A"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/icon.ico"
        RequestedThemeVariant="Dark">

    <Grid>
        <ctrls:CyberGridBackground GridSpacing="24" GridColor="#151515" />

        <DockPanel Margin="20">
            <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,*,Auto" Margin="0,16,0,0">
                <ctrls:CyberBorder Grid.Column="0" ChamferSize="6" BorderBrush="#E64A00" BorderThickness="1" Background="#E64A00">
                    <Button Classes="cyber-primary" Content="Add" Click="OnOkClick" BorderThickness="0" Background="Transparent" Height="36" Width="130" HorizontalContentAlignment="Center"/>
                </ctrls:CyberBorder>
                <Button Grid.Column="2" Classes="cyber" Content="Cancel" Click="OnCancelClick" Height="36" Width="100" HorizontalContentAlignment="Center"/>
            </Grid>

            <StackPanel Spacing="16">
                <StackPanel Spacing="6">
                    <TextBlock Text="Download Link" 
                               FontFamily="JetBrains Mono" 
                               FontSize="11" 
                               Foreground="#888888" 
                               FontWeight="Bold"/>
                    <TextBox Name="UrlTextBox" 
                             Classes="cyber" 
                             Watermark="https://example.com/file.bin"
                             Height="36" 
                             Padding="12,8"
                             TextWrapping="NoWrap"/>
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Filename (optional)" 
                               FontFamily="JetBrains Mono" 
                               FontSize="11" 
                               Foreground="#888888" 
                               FontWeight="Bold"/>
                    <TextBox Name="NameTextBox" 
                             Classes="cyber" 
                             Watermark="file.bin"
                             Height="36" 
                             Padding="12,8"/>
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Save Folder" 
                               FontFamily="JetBrains Mono" 
                               FontSize="11" 
                               Foreground="#888888" 
                               FontWeight="Bold"/>
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto">
                        <TextBox Grid.Column="0" 
                                 Name="FolderTextBox" 
                                 Classes="cyber" 
                                 Watermark="D:\Downloads"
                                 Height="36" 
                                 Padding="12,8"
                                 Margin="0,0,8,0"/>
                        <Button Grid.Column="1" 
                                Classes="cyber" 
                                Content="Browse" 
                                Click="OnBrowseClick"
                                Height="36" 
                                Padding="16,0"
                                HorizontalContentAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
