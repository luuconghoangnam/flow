<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Flow.Desktop.ViewModels"
             xmlns:ctrls="using:Flow.Desktop.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="Flow.Desktop.Views.SettingsView"
             x:DataType="vm:SettingsViewModel"
             Background="Transparent">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TITLE BAR -->
        <Border Grid.Row="0" BorderBrush="#3A3A3A" BorderThickness="0,0,0,1" Padding="0,0,0,16" Margin="0,0,0,16">
            <StackPanel Spacing="4">
                <TextBlock Text="SYSTEM REGISTRY CONFIGURATION" FontFamily="JetBrains Mono" FontSize="16" FontWeight="Bold" Foreground="#E64A00"/>
                <TextBlock Text="Modify parameters of download pipelines and IO structures" FontFamily="JetBrains Mono" FontSize="11" Foreground="#555555"/>
            </StackPanel>
        </Border>

        <!-- FORM CONTROLS -->
        <ScrollViewer Grid.Row="1" Margin="0,0,0,16">
            <StackPanel Spacing="24" MaxWidth="600" HorizontalAlignment="Left">
                
                <!-- DEFAULT DIRECTORY -->
                <StackPanel Spacing="6">
                    <TextBlock Text="DEFAULT DOWNLOAD SECTOR DIRECTORY" FontFamily="JetBrains Mono" FontSize="11" Foreground="#888888" FontWeight="Bold"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Grid.Column="0" Text="{Binding DefaultDownloadFolder}" Classes="cyber" Height="36" Padding="12,8" Margin="0,0,8,0"/>
                        <Button Grid.Column="1" Classes="cyber" Content="LOCATE" Click="OnLocateClick" Height="36" Padding="16,0"/>
                    </Grid>
                </StackPanel>

                <!-- THREAD COUNT -->
                <StackPanel Spacing="6">
                    <TextBlock Text="DEFAULT CONCURRENT CONNECTIONS (THREADS)" FontFamily="JetBrains Mono" FontSize="11" Foreground="#888888" FontWeight="Bold"/>
                    <TextBox Text="{Binding DefaultThreadCount}" Classes="cyber" Height="36" Padding="12,8" Width="120" HorizontalAlignment="Left"/>
                </StackPanel>

                <!-- SPEED LIMIT -->
                <StackPanel Spacing="6">
                    <TextBlock Text="GLOBAL BANDWIDTH CEILING SPEED LIMIT (BYTES/S, 0 = UNLIMITED)" FontFamily="JetBrains Mono" FontSize="11" Foreground="#888888" FontWeight="Bold"/>
                    <TextBox Text="{Binding GlobalSpeedLimit}" Classes="cyber" Height="36" Padding="12,8" Width="200" HorizontalAlignment="Left"/>
                </StackPanel>

                <!-- FEATURE TOGGLES -->
                <StackPanel Spacing="12">
                    <TextBlock Text="PIPELINE SUB-SYSTEM SWITCHES" FontFamily="JetBrains Mono" FontSize="11" Foreground="#888888" FontWeight="Bold" Margin="0,0,0,4"/>
                    
                    <CheckBox IsChecked="{Binding DynamicPartCreationMode}" Content="DYNAMIC MULTI-THREAD SEGMENT ALLOCATION" FontFamily="JetBrains Mono" FontSize="12"/>
                    <CheckBox IsChecked="{Binding UseSparseFileAllocation}" Content="USE SPARSE FILES (INSTANT ALLOCATION WITHOUT PRE-ALLOC FILL)" FontFamily="JetBrains Mono" FontSize="12"/>
                    <CheckBox IsChecked="{Binding UseServerLastModifiedTime}" Content="SYNCHRONIZE LOCAL TIMESTAMPS WITH SERVER DATE-MODIFIED" FontFamily="JetBrains Mono" FontSize="12"/>
                    <CheckBox IsChecked="{Binding AppendExtensionToIncompleteDownloads}" Content="APPEND '.DOWNLOADING' SUFFIX TO ACTIVE FILES" FontFamily="JetBrains Mono" FontSize="12"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- ACTIONS ROW -->
        <Border Grid.Row="2" BorderBrush="#3A3A3A" BorderThickness="0,1,0,0" Padding="0,16,0,0">
            <StackPanel Orientation="Horizontal" Spacing="16">
                <!-- Apply primary button -->
                <ctrls:CyberBorder ChamferSize="8" BorderBrush="#E64A00" BorderThickness="1" Background="#E64A00">
                    <Button Command="{Binding SaveCommand}" Classes="cyber-primary" Content="APPLY CONFIG CHANGES" BorderThickness="0" Background="Transparent" Height="36" Padding="24,0"/>
                </ctrls:CyberBorder>
                
                <TextBlock Text="* CONFIG CHANGES WILL TAKE EFFECT ON SUBSEQUENT INSTANCES" FontFamily="JetBrains Mono" FontSize="10" Foreground="#555555" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

    </Grid>
</UserControl>
