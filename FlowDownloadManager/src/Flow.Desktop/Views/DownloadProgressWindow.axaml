<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Flow.Desktop.ViewModels"
        xmlns:ctrls="using:Flow.Desktop.Controls"
        xmlns:monitor="clr-namespace:Flow.Monitor;assembly=Flow.Monitor"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="560" d:DesignHeight="420"
        x:Class="Flow.Desktop.Views.DownloadProgressWindow"
        x:DataType="vm:DownloadProgressViewModel"
        Title="{Binding Name, StringFormat='Flow — {0}'}"
        Icon="/Assets/icon.ico"
        Background="#0A0A0A"
        Width="500" Height="400"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        SizeToContent="Manual">

    <Window.Styles>
        <Style Selector="TextBlock.lbl">
            <Setter Property="FontFamily" Value="JetBrains Mono, Courier New, monospace"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="TextBlock.val">
            <Setter Property="FontFamily" Value="JetBrains Mono, Courier New, monospace"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#E5E7EB"/>
        </Style>
        <Style Selector="TextBlock.val-hi">
            <Setter Property="FontFamily" Value="JetBrains Mono, Courier New, monospace"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#E64A00"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </Window.Styles>

    <Grid>
        <!-- Blueprint background -->
        <ctrls:CyberGridBackground GridSpacing="24" GridColor="#111111"/>

        <DockPanel Margin="20" LastChildFill="True">

            <!-- ── TOP HEADER: file name + status tag ── -->
            <Border DockPanel.Dock="Top"
                    BorderBrush="#2A2A2A" BorderThickness="0,0,0,1"
                    Padding="0,0,0,14" Margin="0,0,0,14">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="{Binding Name}"
                                   FontFamily="JetBrains Mono, Courier New, monospace"
                                   FontSize="15" FontWeight="Bold"
                                   Foreground="#E5E7EB"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Url}"
                                   FontFamily="JetBrains Mono, Courier New, monospace"
                                   FontSize="10" Foreground="#444444"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <!-- Status badge -->
                    <Border Grid.Column="1"
                            Background="#1A0800" BorderBrush="#E64A00"
                            BorderThickness="1" Padding="10,4"
                            VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="{Binding StatusText}"
                                   FontFamily="JetBrains Mono, Courier New, monospace"
                                   FontSize="10" FontWeight="Bold"
                                   Foreground="#E64A00"/>
                    </Border>
                </Grid>
            </Border>

            <!-- ── BOTTOM BUTTONS ── -->
            <Border DockPanel.Dock="Bottom"
                    BorderBrush="#2A2A2A" BorderThickness="0,1,0,0"
                    Padding="0,14,0,0" Margin="0,14,0,0">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <!-- Left controls -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                        <Button Classes="cyber-primary"
                                Content="Resume"
                                Command="{Binding ResumeCommand}"
                                IsVisible="{Binding CanResume}"
                                Height="34" Padding="16,0"
                                FontFamily="JetBrains Mono, Courier New, monospace"
                                FontSize="11"/>
                        <Button Classes="cyber"
                                Content="Pause"
                                Command="{Binding PauseCommand}"
                                IsVisible="{Binding CanPause}"
                                Height="34" Padding="16,0"
                                FontFamily="JetBrains Mono, Courier New, monospace"
                                FontSize="11"/>
                        <Button Classes="cyber"
                                Content="Open Folder"
                                Command="{Binding OpenFolderCommand}"
                                IsVisible="{Binding IsCompleted}"
                                Height="34" Padding="16,0"
                                FontFamily="JetBrains Mono, Courier New, monospace"
                                FontSize="11"/>
                    </StackPanel>

                    <!-- Right: close -->
                    <Button Grid.Column="2"
                            Classes="cyber"
                            Content="Close"
                            Click="OnCloseClick"
                            Height="34" Padding="16,0"
                            FontFamily="JetBrains Mono, Courier New, monospace"
                            FontSize="11"/>
                </Grid>
            </Border>

            <!-- ── MIDDLE CONTENT ── -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16">

                    <!-- ── MAIN PROGRESS BAR ── -->
                    <StackPanel Spacing="8">
                        <!-- Percent row -->
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
                            <ProgressBar Grid.Column="0"
                                         Minimum="0" Maximum="100"
                                         Value="{Binding Percent}"
                                         Background="#1A1A1A"
                                         Foreground="#E64A00"
                                         Height="16"
                                         CornerRadius="0"
                                         VerticalAlignment="Center"/>

                            <TextBlock Grid.Column="1"
                                       Text="{Binding Percent, StringFormat='{}{0}%'}"
                                       Classes="val-hi"
                                       VerticalAlignment="Center"
                                       Margin="12,0,0,0"/>
                        </Grid>

                        <!-- Stats row: Downloaded / Total / Speed / Time -->
                        <Grid ColumnDefinitions="*,*,*,*" Margin="0,4,0,0">
                            <StackPanel Grid.Column="0" Spacing="3">
                                <TextBlock Classes="lbl" Text="Downloaded"/>
                                <TextBlock Classes="val" Text="{Binding DownloadedText}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="3">
                                <TextBlock Classes="lbl" Text="Total"/>
                                <TextBlock Classes="val" Text="{Binding TotalSizeText}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="3">
                                <TextBlock Classes="lbl" Text="Speed"/>
                                <TextBlock Classes="val-hi" Text="{Binding SpeedText}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3" Spacing="3">
                                <TextBlock Classes="lbl" Text="Time Left"/>
                                <TextBlock Classes="val" Text="{Binding TimeLeftText}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- ── DIVIDER ── -->
                    <Border Height="1" Background="#222222"/>

                    <!-- ── FILE INFO ── -->
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" Margin="0,0,0,4">
                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="3">
                            <TextBlock Classes="lbl" Text="Save Folder"/>
                            <TextBlock Classes="val"
                                       Text="{Binding SaveFolder}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Spacing="3">
                            <TextBlock Classes="lbl" Text="Resume"/>
                            <TextBlock Classes="val" Text="{Binding ResumeSupportText}"/>
                        </StackPanel>
                    </Grid>

                    <!-- ── DIVIDER ── -->
                    <Border Height="1" Background="#222222"/>

                    <!-- ── SEGMENTS (connection threads) ── -->
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0"
                                       Text="Threads"
                                       FontFamily="JetBrains Mono, Courier New, monospace"
                                       FontSize="11" FontWeight="Bold"
                                       Foreground="#E64A00"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Parts.Count, StringFormat='× {0} streams'}"
                                       Classes="lbl"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Segment rows -->
                        <ItemsControl ItemsSource="{Binding Parts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="monitor:IUiPart">
                                    <Grid ColumnDefinitions="28,*,52,52"
                                          Margin="0,2">
                                        <!-- Thread # -->
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Id}"
                                                   FontFamily="JetBrains Mono, Courier New, monospace"
                                                   FontSize="10" Foreground="#444444"
                                                   VerticalAlignment="Center"/>
                                        <!-- Mini progress bar -->
                                        <ProgressBar Grid.Column="1"
                                                     Minimum="0" Maximum="100"
                                                     Value="{Binding Percent, FallbackValue=0}"
                                                     Height="6"
                                                     CornerRadius="0"
                                                     Background="#1A1A1A"
                                                     VerticalAlignment="Center">
                                            <ProgressBar.Styles>
                                                <Style Selector="ProgressBar">
                                                    <Setter Property="Foreground" Value="#E64A00"/>
                                                </Style>
                                            </ProgressBar.Styles>
                                        </ProgressBar>

                                        <!-- Percent -->
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Percent, StringFormat='{}{0}%'}"
                                                   FontFamily="JetBrains Mono, Courier New, monospace"
                                                   FontSize="10" Foreground="#888888"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0"/>

                                        <!-- Status dot -->
                                        <Border Grid.Column="3"
                                                Width="10" Height="10"
                                                CornerRadius="5"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Center"
                                                ToolTip.Tip="{Binding Status}">
                                            <Border.Background>
                                                <SolidColorBrush>
                                                    <SolidColorBrush.Color>
                                                        <MultiBinding Converter="{StaticResource PartStatusToColorConverter}">
                                                            <Binding Path="Status"/>
                                                        </MultiBinding>
                                                    </SolidColorBrush.Color>
                                                </SolidColorBrush>
                                            </Border.Background>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Legend -->
                        <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,4,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Border Width="10" Height="10" CornerRadius="5" Background="#22C55E"/>
                                <TextBlock Classes="lbl" Text="Done" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Border Width="10" Height="10" CornerRadius="5" Background="#E64A00"/>
                                <TextBlock Classes="lbl" Text="Active" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Border Width="10" Height="10" CornerRadius="5" Background="#3A3A3A"/>
                                <TextBlock Classes="lbl" Text="Idle" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

        </DockPanel>
    </Grid>
</Window>
