<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrls="using:Flow.Desktop.Controls"
        x:Class="Flow.Desktop.Views.MessageDialog"
        Title="Flow"
        Width="400" Height="200"
        CanResize="False"
        Background="#0A0A0A"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/icon.ico"
        RequestedThemeVariant="Dark"
        Topmost="True">

    <Grid>
        <ctrls:CyberGridBackground GridSpacing="24" GridColor="#151515" />

        <DockPanel Margin="20">
            <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto,Auto" Margin="0,16,0,0">
                <Button Grid.Column="1" Name="CancelButton" Classes="cyber" Content="Cancel" Click="OnCancelClick" Height="34" Width="100" Margin="0,0,8,0" HorizontalContentAlignment="Center"/>
                <Button Grid.Column="2" Name="OkButton" Classes="cyber-primary" Content="OK" Click="OnOkClick" Height="34" Width="100" HorizontalContentAlignment="Center"/>
            </Grid>

            <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,16">
                <TextBlock Grid.Column="0" Name="IconTextBlock" Text="i" FontFamily="JetBrains Mono" FontSize="28" FontWeight="Bold" VerticalAlignment="Top" Margin="0,0,16,0"/>
                <StackPanel Grid.Column="1" Spacing="8">
                    <TextBlock Name="TitleTextBlock" Text="Title" FontFamily="JetBrains Mono" FontSize="14" FontWeight="Bold" Foreground="#E5E7EB" TextWrapping="Wrap"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock Name="MessageTextBlock" Text="Message" FontFamily="JetBrains Mono" FontSize="12" Foreground="#888888" TextWrapping="Wrap"/>
                    </ScrollViewer>
                </StackPanel>
            </Grid>
        </DockPanel>
    </Grid>
</Window>
