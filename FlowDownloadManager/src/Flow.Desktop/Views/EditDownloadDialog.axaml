<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrls="using:Flow.Desktop.Controls"
        x:Class="Flow.Desktop.Views.EditDownloadDialog"
        Title="Edit Download"
        Width="440" Height="310"
        CanResize="False"
        Background="#0A0A0A"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/icon.ico"
        RequestedThemeVariant="Dark">

    <Grid>
        <ctrls:CyberGridBackground GridSpacing="24" GridColor="#151515" />

        <DockPanel Margin="16">
            <!-- Bottom action buttons: [Save] spacer [Cancel] (primary left, cancel right) -->
            <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,*,Auto" Margin="0,12,0,0">
                <ctrls:CyberBorder Grid.Column="0" ChamferSize="6" BorderBrush="#E64A00" BorderThickness="1" Background="#E64A00">
                    <Button Classes="cyber-primary" Content="Save" Click="OnOkClick" BorderThickness="0" Background="Transparent" Height="34" Width="120" HorizontalContentAlignment="Center"/>
                </ctrls:CyberBorder>
                <Button Grid.Column="2" Classes="cyber" Content="Cancel" Click="OnCancelClick" Height="34" Width="100" HorizontalContentAlignment="Center"/>
            </Grid>

            <ScrollViewer>
                <StackPanel Spacing="12">
                    <!-- URL field (full width at top, like main app) -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Download Link" 
                                   FontFamily="JetBrains Mono" 
                                   FontSize="11" 
                                   Foreground="#888888" 
                                   FontWeight="Bold"/>
                        <TextBox Name="UrlTextBox" 
                                 Classes="cyber" 
                                 Watermark="https://example.com/file.bin"
                                 Height="34" Padding="10,6"
                                 TextWrapping="NoWrap"/>
                    </StackPanel>

                    <!-- Two-column layout below URL (like main app left/right pattern) -->
                    <Grid ColumnDefinitions="*,16,*">
                        <!-- LEFT COLUMN: Name + Location -->
                        <StackPanel Grid.Column="0" Spacing="10">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Filename" 
                                           FontFamily="JetBrains Mono" 
                                           FontSize="11" 
                                           Foreground="#888888" 
                                           FontWeight="Bold"/>
                                <TextBox Name="NameTextBox" 
                                         Classes="cyber" 
                                         Watermark="file.bin"
                                         Height="34" Padding="10,6"/>
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Save Folder" 
                                           FontFamily="JetBrains Mono" 
                                           FontSize="11" 
                                           Foreground="#888888" 
                                           FontWeight="Bold"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox Grid.Column="0" 
                                             Name="FolderTextBox" 
                                             Classes="cyber" 
                                             Watermark="D:\Downloads"
                                             Height="34" Padding="10,6"
                                             Margin="0,0,6,0"/>
                                    <Button Grid.Column="1" 
                                            Classes="cyber" 
                                            Content="Browse" 
                                            Click="OnBrowseClick"
                                            Height="34" Padding="12,0"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>

                        <!-- RIGHT COLUMN: Threads + Speed + Checksum (like main app's file info panel) -->
                        <StackPanel Grid.Column="2" Spacing="10">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Threads" 
                                           FontFamily="JetBrains Mono" 
                                           FontSize="11" 
                                           Foreground="#888888" 
                                           FontWeight="Bold"/>
                                <TextBox Name="ThreadCountTextBox" 
                                         Classes="cyber" 
                                         Watermark="0 (default)"
                                         Height="34" Padding="10,6"/>
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Speed Limit" 
                                           FontFamily="JetBrains Mono" 
                                           FontSize="11" 
                                           Foreground="#888888" 
                                           FontWeight="Bold"/>
                                <TextBox Name="SpeedLimitTextBox" 
                                         Classes="cyber" 
                                         Watermark="0 (unlimited)"
                                         Height="34" Padding="10,6"/>
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Checksum" 
                                           FontFamily="JetBrains Mono" 
                                           FontSize="11" 
                                           Foreground="#888888" 
                                           FontWeight="Bold"/>
                                <TextBox Name="ChecksumTextBox" 
                                         Classes="cyber" 
                                         Watermark="algorithm:hashvalue"
                                         Height="34" Padding="10,6"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
