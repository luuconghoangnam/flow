<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Flow.Desktop.ViewModels"
             xmlns:ctrls="using:Flow.Desktop.Controls"
             xmlns:views="using:Flow.Desktop.Views"
             xmlns:monitor="using:Flow.Monitor"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="Flow.Desktop.Views.DownloadsView"
             x:DataType="vm:DownloadsViewModel"
             Background="Transparent">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOP BAR: Add + Batch + Search + Speed (like main app's layout) -->
        <Border Grid.Row="0" BorderBrush="#3A3A3A" BorderThickness="0,0,0,1" Padding="0,0,0,10" Margin="0,0,0,8">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                <!-- New Download button -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                    <ctrls:CyberBorder ChamferSize="6" BorderBrush="#E64A00" BorderThickness="1" Background="#1E1E1E">
                        <Button Classes="cyber" Click="OnAddDownloadClick" BorderThickness="0" Background="Transparent" Height="30" Padding="12,0">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="+" FontWeight="Bold" Foreground="#E64A00" VerticalAlignment="Center" FontSize="13"/>
                                <TextBlock Text="New Download" FontFamily="JetBrains Mono" VerticalAlignment="Center" FontSize="12"/>
                            </StackPanel>
                        </Button>
                    </ctrls:CyberBorder>

                    <ctrls:CyberBorder ChamferSize="6" BorderBrush="#3B82F6" BorderThickness="1" Background="#1E1E1E">
                        <Button Classes="cyber" Click="OnAddBatchClick" BorderThickness="0" Background="Transparent" Height="30" Padding="10,0">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="++" FontWeight="Bold" Foreground="#3B82F6" VerticalAlignment="Center" FontSize="12"/>
                                <TextBlock Text="Batch" FontFamily="JetBrains Mono" VerticalAlignment="Center" FontSize="12"/>
                            </StackPanel>
                        </Button>
                    </ctrls:CyberBorder>
                </StackPanel>

                <!-- Search box (like main app's search) -->
                <TextBox Grid.Column="2" Name="SearchBox" Classes="cyber" Watermark="Search downloads..."
                         Height="30" Padding="10,0" Margin="16,0" HorizontalAlignment="Stretch"
                         Text="{Binding SearchText, Mode=TwoWay}"/>

                <!-- Action buttons (like main app's Actions toolbar) -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Button Classes="cyber" Content="Pause All" Click="OnPauseAllClick" Height="26" Padding="10,0" FontSize="10"/>
                </StackPanel>

                <!-- Global speed (like main app's DashboardStatsHeader) -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="Speed:" FontFamily="JetBrains Mono" Foreground="#888888" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding GlobalSpeedText}" FontFamily="JetBrains Mono" Foreground="#E64A00" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- STATUS FILTER CHIPS (horizontal row like main app's StatusFilterRow) -->
        <Border Grid.Row="1" BorderBrush="#2A2A2A" BorderThickness="0,0,0,1" Padding="0,0,0,8" Margin="0,0,0,8">
            <ListBox ItemsSource="{Binding StatusFilters}"
                     SelectedItem="{Binding SelectedStatusFilter}"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     Height="28">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="12,4" />
                        <Setter Property="Margin" Value="0,0,6,0" />
                        <Setter Property="Background" Value="#181818" />
                        <Setter Property="BorderBrush" Value="#333333" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="CornerRadius" Value="0" />
                        <Setter Property="FontFamily" Value="JetBrains Mono" />
                        <Setter Property="FontSize" Value="11" />
                    </Style>
                    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                        <Setter Property="Background" Value="#222222" />
                        <Setter Property="BorderBrush" Value="#E64A00" />
                    </Style>
                    <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
                        <Setter Property="Background" Value="#1A1512" />
                        <Setter Property="BorderBrush" Value="#E64A00" />
                        <Setter Property="Foreground" Value="#E64A00" />
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>
        </Border>

        <!-- DOWNLOAD LIST (full width, no sidebar) -->
        <ListBox Grid.Row="2" 
                 ItemsSource="{Binding Downloads}" 
                 SelectedItem="{Binding SelectedDownload}"
                 Background="Transparent" 
                 BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 DoubleTapped="OnListItemDoubleTapped">
            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="Background" Value="#101010" />
                    <Setter Property="BorderBrush" Value="#222222" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="Padding" Value="12" />
                    <Setter Property="Margin" Value="0,0,0,8" />
                    <Setter Property="CornerRadius" Value="0" />
                </Style>
                <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Background" Value="#181818" />
                    <Setter Property="BorderBrush" Value="#E64A00" />
                </Style>
                <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Background" Value="#1A1512" />
                    <Setter Property="BorderBrush" Value="#E64A00" />
                </Style>
            </ListBox.Styles>
            
            <ListBox.DataTemplates>
                <DataTemplate DataType="monitor:CompletedDownloadItemState">
                    <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto">
                        <Grid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Open File" Click="OnOpenFileClick"/>
                                <MenuItem Header="Open Folder" Click="OnOpenFolderClick"/>
                                <Separator/>
                                <MenuItem Header="Copy Link" Click="OnCopyLinkClick"/>
                                <MenuItem Header="Checksum" Click="OnChecksumClick"/>
                                <Separator/>
                                <MenuItem Header="Delete" Click="OnDeleteClick"/>
                            </ContextMenu>
                        </Grid.ContextMenu>
                        
                        <!-- FILE INFO -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="3">
                            <TextBlock Text="{Binding Name}" 
                                       FontFamily="JetBrains Mono" 
                                       FontSize="13" 
                                       FontWeight="Bold" 
                                       Foreground="#E5E7EB"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding DownloadLink}" 
                                       FontFamily="JetBrains Mono" 
                                       FontSize="10" 
                                       Foreground="#555555"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <!-- CONNECTION BADGE -->
                        <Border Grid.Row="0" Grid.Column="1" 
                                BorderThickness="1" 
                                Background="#122E1A"
                                BorderBrush="#22C55E" 
                                Padding="6,1" 
                                VerticalAlignment="Top">
                            <TextBlock Text="HTTP" 
                                       FontFamily="JetBrains Mono" 
                                       FontSize="8" 
                                       FontWeight="Bold" 
                                       Foreground="#22C55E" />
                        </Border>

                        <!-- TASK PROGRESS -->
                        <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10" ColumnDefinitions="*,Auto">
                            <ProgressBar Grid.Column="0" 
                                         Minimum="0" Maximum="100" 
                                         Value="100"
                                         Background="#1A1A1A" 
                                         Foreground="#22C55E" 
                                         Height="3" 
                                         CornerRadius="0"
                                         VerticalAlignment="Center"
                                         Margin="0,0,12,0"/>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="100%" 
                                           FontFamily="JetBrains Mono" 
                                           FontSize="11" 
                                           FontWeight="Bold" 
                                           Foreground="#22C55E" 
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="Finished" 
                                           FontFamily="JetBrains Mono" 
                                           FontSize="11" 
                                           Foreground="#22C55E" 
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <!-- ACTIONS PANEL -->
                        <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnDefinitions="Auto,*">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                <Button Classes="cyber" Content="Open Folder" 
                                        Click="OnOpenFolderClick"
                                        Height="24" FontSize="10" Padding="6,0"/>
                                <Button Classes="cyber" Content="Checksum" 
                                        Click="OnChecksumClick"
                                        Height="24" FontSize="10" Padding="6,0"/>
                                <Button Classes="cyber" Content="Delete" 
                                        Click="OnDeleteClick"
                                        Height="24" FontSize="10" Padding="6,0"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </DataTemplate>
                
                <DataTemplate DataType="monitor:IProcessingDownloadItemState">
                    <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto">
                        <Grid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Resume" 
                                          Command="{Binding $parent[UserControl].((vm:DownloadsViewModel)DataContext).ResumeDownloadCommand}" 
                                          CommandParameter="{Binding}"
                                          IsEnabled="{Binding Status.CanBeResumed}"/>
                                <MenuItem Header="Pause" 
                                          Command="{Binding $parent[UserControl].((vm:DownloadsViewModel)DataContext).PauseDownloadCommand}" 
                                          CommandParameter="{Binding}"
                                          IsEnabled="{Binding Status.IsActive}"/>
                                <MenuItem Header="Reset" 
                                          Command="{Binding $parent[UserControl].((vm:DownloadsViewModel)DataContext).ResetDownloadCommand}" 
                                          CommandParameter="{Binding}"
                                          IsEnabled="{Binding Status.CanBeResumed}"/>
                                <Separator/>
                                <MenuItem Header="Open File" Click="OnOpenFileClick"/>
                                <MenuItem Header="Open Folder" Click="OnOpenFolderClick"/>
                                <Separator/>
                                <MenuItem Header="Copy Link" Click="OnCopyLinkClick"/>
                                <MenuItem Header="Edit" Click="OnEditClick"/>
                                <MenuItem Header="Checksum" Click="OnChecksumClick"/>
                                <MenuItem Header="Details" Click="OnShowDetailsClick"/>
                                <Separator/>
                                <MenuItem Header="Delete" Click="OnDeleteClick"/>
                            </ContextMenu>
                        </Grid.ContextMenu>
                        
                        <!-- FILE INFO -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="3">
                            <TextBlock Text="{Binding Name}" 
                                       FontFamily="JetBrains Mono" 
                                       FontSize="13" 
                                       FontWeight="Bold" 
                                       Foreground="#E5E7EB"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding DownloadLink}" 
                                       FontFamily="JetBrains Mono" 
                                       FontSize="10" 
                                       Foreground="#555555"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <!-- CONNECTION BADGE -->
                        <Border Grid.Row="0" Grid.Column="1" 
                                BorderThickness="1" 
                                Background="#122E1A"
                                BorderBrush="#22C55E" 
                                Padding="6,1" 
                                VerticalAlignment="Top">
                            <TextBlock Text="HTTP" 
                                       FontFamily="JetBrains Mono" 
                                       FontSize="8" 
                                       FontWeight="Bold" 
                                       Foreground="#22C55E" />
                        </Border>

                        <!-- TASK PROGRESS -->
                        <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10" ColumnDefinitions="*,Auto,Auto">
                            <!-- Progress Bar -->
                            <ProgressBar Grid.Column="0" 
                                         Minimum="0" Maximum="100" 
                                         Value="{Binding Percent, FallbackValue=0}"
                                         Background="#1A1A1A" 
                                         Foreground="#E64A00" 
                                         Height="3" 
                                         CornerRadius="0"
                                         VerticalAlignment="Center"
                                         Margin="0,0,12,0"/>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="0,0,12,0">
                                <TextBlock Text="{Binding Percent, StringFormat='{}{0}%'}" 
                                           FontFamily="JetBrains Mono" 
                                           FontSize="11" 
                                           FontWeight="Bold" 
                                           Foreground="#E5E7EB" 
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Speed, Converter={x:Static ctrls:FormatHelpers.SpeedConverter}}" 
                                           FontFamily="JetBrains Mono" 
                                           FontSize="11" 
                                           Foreground="#FF8547" 
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock Grid.Column="2" 
                                       Text="{Binding Status}" 
                                       FontFamily="JetBrains Mono" 
                                       FontSize="10" 
                                       FontWeight="Bold" 
                                       Foreground="#555555" 
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <!-- ACTIONS PANEL -->
                        <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnDefinitions="Auto,*">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                <Button Classes="cyber" Content="Resume" 
                                        Command="{Binding $parent[UserControl].((vm:DownloadsViewModel)DataContext).ResumeDownloadCommand}" 
                                        CommandParameter="{Binding}"
                                        IsVisible="{Binding Status.CanBeResumed}"
                                        Height="24" FontSize="10" Padding="6,0"/>
                                <Button Classes="cyber" Content="Pause" 
                                        Command="{Binding $parent[UserControl].((vm:DownloadsViewModel)DataContext).PauseDownloadCommand}" 
                                        CommandParameter="{Binding}"
                                        IsVisible="{Binding Status.IsActive}"
                                        Height="24" FontSize="10" Padding="6,0"/>
                                <Button Classes="cyber" Content="Delete" 
                                        Click="OnDeleteClick"
                                        Height="24" FontSize="10" Padding="6,0"/>
                            </StackPanel>

                        <Button Grid.Column="1" Classes="cyber" Content="Details" 
                                Click="OnShowDetailsClick"
                                HorizontalAlignment="Right"
                                Height="24" FontSize="10" Padding="6,0"/>
                        </Grid>

                    </Grid>
                </DataTemplate>
            </ListBox.DataTemplates>
        </ListBox>

    </Grid>
</UserControl>
