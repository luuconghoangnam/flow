<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrls="using:Flow.Desktop.Controls"
        x:Class="Flow.Desktop.Views.DeleteConfirmationDialog"
        Title="DELETE TRANSACTION"
        Width="400" Height="240"
        CanResize="False"
        Background="#0A0A0A"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/icon.ico"
        RequestedThemeVariant="Dark">

    <Grid>
        <!-- Background Grid -->
        <ctrls:CyberGridBackground GridSpacing="24" GridColor="#151515" />

        <DockPanel Margin="20">
            <!-- Dialog Actions -->
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12" Margin="0,16,0,0">
                <Button Classes="cyber" Content="ABORT" Click="OnCancelClick" Height="36" Width="100" HorizontalContentAlignment="Center"/>
                <ctrls:CyberBorder ChamferSize="6" BorderBrush="#E64A00" BorderThickness="1" Background="#E64A00">
                    <Button Classes="cyber-primary" Content="CONFIRM DELETE" Click="OnOkClick" BorderThickness="0" Background="Transparent" Height="36" Width="150" HorizontalContentAlignment="Center"/>
                </ctrls:CyberBorder>
            </StackPanel>

            <!-- Main Content -->
            <StackPanel Spacing="16">
                <!-- WARNING HEADER -->
                <Border BorderBrush="#EAB308" BorderThickness="1" Background="#261F00" Padding="12,8">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="⚠ WARNING" 
                                   FontFamily="JetBrains Mono" 
                                   FontSize="12" 
                                   FontWeight="Bold" 
                                   Foreground="#EAB308"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="ACTION CANNOT BE UNDONE" 
                                   FontFamily="JetBrains Mono" 
                                   FontSize="11" 
                                   Foreground="#EAB308"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- DESCRIPTION -->
                <StackPanel Spacing="6">
                    <TextBlock Text="CONFIRM REMOVAL OF THE FOLLOWING TARGET TRANSACTION:" 
                               FontFamily="JetBrains Mono" 
                               FontSize="11" 
                               Foreground="#888888" 
                               FontWeight="Bold"
                               TextWrapping="Wrap"/>
                    <TextBlock Name="FileNameTextBlock" 
                               Text="filename.bin"
                               FontFamily="JetBrains Mono" 
                               FontSize="13" 
                               FontWeight="Bold" 
                               Foreground="#E64A00"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <!-- CHECKBOX TO DELETE FILE ON DISK -->
                <CheckBox Name="DeleteFileCheckBox" 
                          Classes="cyber"
                          IsChecked="False"
                          Content="DELETE FILE FROM PHYSICAL DISK"
                          Margin="0,4,0,0" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>