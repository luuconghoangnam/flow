<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrls="using:Flow.Desktop.Controls"
        x:Class="Flow.Desktop.Views.DeleteConfirmationDialog"
        Title="Delete Download"
        Width="360" Height="160"
        CanResize="False"
        Background="#0A0A0A"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/icon.ico"
        RequestedThemeVariant="Dark">

    <Grid>
        <ctrls:CyberGridBackground GridSpacing="24" GridColor="#151515" />

        <DockPanel Margin="20">
            <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,*,Auto" Margin="0,16,0,0">
                <!-- Delete button on left with error color (matching main app's error color for destructive action) -->
                <ctrls:CyberBorder Grid.Column="0" ChamferSize="6" BorderBrush="#DC2626" BorderThickness="1" Background="#DC2626">
                    <Button Classes="cyber-primary" Content="Delete" Click="OnOkClick" BorderThickness="0" Background="Transparent" Height="36" Width="120" HorizontalContentAlignment="Center" Foreground="White"/>
                </ctrls:CyberBorder>
                <Button Grid.Column="2" Classes="cyber" Content="Cancel" Click="OnCancelClick" Height="36" Width="100" HorizontalContentAlignment="Center"/>
            </Grid>

            <StackPanel Spacing="16">
                <StackPanel Spacing="6">
                    <TextBlock Text="Are you sure you want to delete this download?" 
                               FontFamily="JetBrains Mono" 
                               FontSize="12" 
                               Foreground="#E5E7EB" 
                               FontWeight="Bold"
                               TextWrapping="Wrap"/>
                    <TextBlock Name="FileNameTextBlock" 
                               Text="filename.bin"
                               FontFamily="JetBrains Mono" 
                               FontSize="11" 
                               Foreground="#E64A00"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <CheckBox Name="DeleteFileCheckBox" 
                          Classes="cyber"
                          IsChecked="False"
                          Content="Also delete file from disk"
                          Margin="0,4,0,0" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>