<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrls="using:Flow.Desktop.Controls"
        x:Class="Flow.Desktop.Views.BatchDownloadDialog"
        Title="Batch Download"
        Width="460" Height="380"
        CanResize="False"
        Background="#0A0A0A"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/icon.ico"
        RequestedThemeVariant="Dark">

    <Grid>
        <ctrls:CyberGridBackground GridSpacing="24" GridColor="#151515" />

        <DockPanel Margin="20">
            <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,*,Auto" Margin="0,16,0,0">
                <ctrls:CyberBorder Grid.Column="0" ChamferSize="6" BorderBrush="#E64A00" BorderThickness="1" Background="#E64A00">
                    <Button Name="InjectButton" Classes="cyber-primary" Content="Add Batch" Click="OnOkClick" BorderThickness="0" Background="Transparent" Height="36" Width="140" HorizontalContentAlignment="Center"/>
                </ctrls:CyberBorder>
                <Button Grid.Column="2" Classes="cyber" Content="Cancel" Click="OnCancelClick" Height="36" Width="100" HorizontalContentAlignment="Center"/>
            </Grid>

            <StackPanel Spacing="16">
                <StackPanel Spacing="6">
                    <TextBlock Text="URL Template (use * for sequence)" 
                               FontFamily="JetBrains Mono" 
                               FontSize="11" 
                               Foreground="#888888" 
                               FontWeight="Bold"/>
                    <TextBox Name="UrlTemplateTextBox" 
                             Classes="cyber" 
                             Watermark="https://example.com/ep_*.mp4"
                             Height="36" 
                             Padding="12,8"
                             TextWrapping="NoWrap"
                             TextChanged="OnInputsChanged"/>
                </StackPanel>

                <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" Margin="0,4,0,0">
                    <StackPanel Grid.Column="0" Spacing="6" Margin="0,0,8,0">
                        <TextBlock Text="Start Index" 
                                   FontFamily="JetBrains Mono" 
                                   FontSize="11" 
                                   Foreground="#888888" 
                                   FontWeight="Bold"/>
                        <TextBox Name="StartIndexTextBox" 
                                 Classes="cyber" 
                                 Text="1"
                                 Height="36" 
                                 Padding="12,8"
                                 TextChanged="OnInputsChanged"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="6" Margin="0,0,8,0">
                        <TextBlock Text="End Index" 
                                   FontFamily="JetBrains Mono" 
                                   FontSize="11" 
                                   Foreground="#888888" 
                                   FontWeight="Bold"/>
                        <TextBox Name="EndIndexTextBox" 
                                 Classes="cyber" 
                                 Text="10"
                                 Height="36" 
                                 Padding="12,8"
                                 TextChanged="OnInputsChanged"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Spacing="6">
                        <TextBlock Text="Padding" 
                                   FontFamily="JetBrains Mono" 
                                   FontSize="11" 
                                   Foreground="#888888" 
                                   FontWeight="Bold"/>
                        <ComboBox Name="PaddingComboBox"
                                  Height="36"
                                  CornerRadius="0"
                                  HorizontalAlignment="Stretch"
                                  SelectionChanged="OnPaddingChanged">
                            <ComboBoxItem Content="Auto (01, 02)"/>
                            <ComboBoxItem Content="None (1, 2)"/>
                            <ComboBoxItem Content="Fixed 3 digits (001)"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <StackPanel Spacing="6">
                    <TextBlock Text="Save Folder" 
                               FontFamily="JetBrains Mono" 
                               FontSize="11" 
                               Foreground="#888888" 
                               FontWeight="Bold"/>
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto">
                        <TextBox Grid.Column="0" 
                                 Name="FolderTextBox" 
                                 Classes="cyber" 
                                 Watermark="D:\Downloads"
                                 Height="36" 
                                 Padding="12,8"
                                 Margin="0,0,8,0"/>
                        <Button Grid.Column="1" 
                                Classes="cyber" 
                                Content="Browse" 
                                Click="OnBrowseClick"
                                Height="36" 
                                Padding="16,0"
                                HorizontalContentAlignment="Center"/>
                    </Grid>
                </StackPanel>

                <Border BorderBrush="#3A3A3A" BorderThickness="1" Background="#141414" Padding="12" Margin="0,8,0,0">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Preview" 
                                   FontFamily="JetBrains Mono" 
                                   FontSize="11" 
                                   Foreground="#E64A00" 
                                   FontWeight="Bold"/>
                        
                        <Grid ColumnDefinitions="Auto,*" Margin="0,4,0,0">
                            <TextBlock Grid.Column="0" Text="First: " FontFamily="JetBrains Mono" FontSize="11" Foreground="#666666"/>
                            <TextBlock Grid.Column="1" Name="FirstUrlTextBlock" Text="-" FontFamily="JetBrains Mono" FontSize="11" Foreground="#E5E7EB" TextTrimming="CharacterEllipsis"/>
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*" Margin="0,2,0,0">
                            <TextBlock Grid.Column="0" Text="Last:  " FontFamily="JetBrains Mono" FontSize="11" Foreground="#666666"/>
                            <TextBlock Grid.Column="1" Name="LastUrlTextBlock" Text="-" FontFamily="JetBrains Mono" FontSize="11" Foreground="#E5E7EB" TextTrimming="CharacterEllipsis"/>
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*" Margin="0,2,0,0">
                            <TextBlock Grid.Column="0" Text="Total: " FontFamily="JetBrains Mono" FontSize="11" Foreground="#666666"/>
                            <TextBlock Grid.Column="1" Name="TotalCountTextBlock" Text="0 items" FontFamily="JetBrains Mono" FontSize="11" Foreground="#22C55E" FontWeight="Bold"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
