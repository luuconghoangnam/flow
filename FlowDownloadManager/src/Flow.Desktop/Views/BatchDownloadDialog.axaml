<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Flow.Desktop.Views.BatchDownloadDialog"
             Width="500" Background="Transparent">

    <StackPanel Spacing="16" Margin="8,16,8,8">
        
        <!-- TARGET URI INPUT WITH WILDCARD -->
        <StackPanel Spacing="6">
            <TextBlock Text="WILDCARD URL TEMPLATE // USE '*' FOR SEQUENCE" 
                       FontFamily="JetBrains Mono" 
                       FontSize="11" 
                       Foreground="#888888" 
                       FontWeight="Bold"/>
            <TextBox Name="UrlTemplateTextBox" 
                     Classes="cyber" 
                     Watermark="https://example.com/episodes/ep_*.mp4"
                     Height="36" 
                     Padding="12,8"
                     TextWrapping="NoWrap"
                     TextChanged="OnInputsChanged"/>
        </StackPanel>

        <!-- RANGE CONFIGURATION -->
        <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" Margin="0,4,0,0">
            <!-- Start Index -->
            <StackPanel Grid.Column="0" Spacing="6" Margin="0,0,8,0">
                <TextBlock Text="START INDEX" 
                           FontFamily="JetBrains Mono" 
                           FontSize="11" 
                           Foreground="#888888" 
                           FontWeight="Bold"/>
                <TextBox Name="StartIndexTextBox" 
                         Classes="cyber" 
                         Text="1"
                         Height="36" 
                         Padding="12,8"
                         TextChanged="OnInputsChanged"/>
            </StackPanel>

            <!-- End Index -->
            <StackPanel Grid.Column="1" Spacing="6" Margin="0,0,8,0">
                <TextBlock Text="END INDEX" 
                           FontFamily="JetBrains Mono" 
                           FontSize="11" 
                           Foreground="#888888" 
                           FontWeight="Bold"/>
                <TextBox Name="EndIndexTextBox" 
                         Classes="cyber" 
                         Text="10"
                         Height="36" 
                         Padding="12,8"
                         TextChanged="OnInputsChanged"/>
            </StackPanel>

            <!-- Wildcard Padding -->
            <StackPanel Grid.Column="2" Spacing="6">
                <TextBlock Text="PADDING LENGTH" 
                           FontFamily="JetBrains Mono" 
                           FontSize="11" 
                           Foreground="#888888" 
                           FontWeight="Bold"/>
                <ComboBox Name="PaddingComboBox"
                          Height="36"
                          CornerRadius="0"
                          HorizontalAlignment="Stretch"
                          SelectionChanged="OnPaddingChanged">
                    <ComboBoxItem Content="AUTO (e.g. 01, 02)"/>
                    <ComboBoxItem Content="RAW (e.g. 1, 2)"/>
                    <ComboBoxItem Content="FIXED (e.g. 001, 002)"/>
                </ComboBox>
            </StackPanel>
        </Grid>

        <!-- SAVE LOCATION INPUT -->
        <StackPanel Spacing="6">
            <TextBlock Text="SAVE SECTOR PATH // FOLDER" 
                       FontFamily="JetBrains Mono" 
                       FontSize="11" 
                       Foreground="#888888" 
                       FontWeight="Bold"/>
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto">
                <TextBox Grid.Column="0" 
                         Name="FolderTextBox" 
                         Classes="cyber" 
                         Watermark="D:\Downloads"
                         Height="36" 
                         Padding="12,8"
                         Margin="0,0,8,0"/>
                <Button Grid.Column="1" 
                        Classes="cyber" 
                        Content="BROWSE" 
                        Click="OnBrowseClick"
                        Height="36" 
                        Padding="16,0"/>
            </Grid>
        </StackPanel>

        <!-- GENERATED PREVIEW SECTION -->
        <Border BorderBrush="#3A3A3A" BorderThickness="1" Background="#141414" Padding="12" Margin="0,8,0,0">
            <StackPanel Spacing="8">
                <TextBlock Text="GENERATED INJECTION PREVIEW" 
                           FontFamily="JetBrains Mono" 
                           FontSize="11" 
                           Foreground="#E64A00" 
                           FontWeight="Bold"/>
                
                <Grid ColumnDefinitions="Auto,*" Margin="0,4,0,0">
                    <TextBlock Grid.Column="0" Text="FIRST: " FontFamily="JetBrains Mono" FontSize="11" Foreground="#666666"/>
                    <TextBlock Grid.Column="1" Name="FirstUrlTextBlock" Text="-" FontFamily="JetBrains Mono" FontSize="11" Foreground="#E5E7EB" TextTrimming="CharacterEllipsis"/>
                </Grid>

                <Grid ColumnDefinitions="Auto,*" Margin="0,2,0,0">
                    <TextBlock Grid.Column="0" Text="LAST:  " FontFamily="JetBrains Mono" FontSize="11" Foreground="#666666"/>
                    <TextBlock Grid.Column="1" Name="LastUrlTextBlock" Text="-" FontFamily="JetBrains Mono" FontSize="11" Foreground="#E5E7EB" TextTrimming="CharacterEllipsis"/>
                </Grid>

                <Grid ColumnDefinitions="Auto,*" Margin="0,2,0,0">
                    <TextBlock Grid.Column="0" Text="TOTAL: " FontFamily="JetBrains Mono" FontSize="11" Foreground="#666666"/>
                    <TextBlock Grid.Column="1" Name="TotalCountTextBlock" Text="0 items" FontFamily="JetBrains Mono" FontSize="11" Foreground="#22C55E" FontWeight="Bold"/>
                </Grid>
            </StackPanel>
        </Border>

    </StackPanel>
</UserControl>
