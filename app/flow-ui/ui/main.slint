import { LineEdit, ScrollView } from "std-widgets.slint";

export struct DownloadRow {
    checked: bool,
    name: string,
    category: string,
    size: string,
    status: string,
    speed: string,
    time-left: string,
    date-added: string,
    description: string,
    progress: int,
    has-progress: bool,
    is-error: bool,
}

export struct DownloadsMenuRow {
    title: string,
    enabled: bool,
    command_id: string,
    target_index: int,
    row_kind: string,
    icon: string,
    shortcut: string,
}

export struct FileChecksumRow {
    file_name: string,
    expected: string,
    actual: string,
    result: string,
}

global Palette {
    // Premium graphite palette tuned for a desktop download manager.
    out property <color> bg: #0B1020;
    out property <color> surface: #111827;
    out property <color> panel: #182235;
    out property <color> panel-raised: #202C44;
    out property <color> border: #2E3B55;
    out property <color> text-primary: #F3F7FF;
    out property <color> text-muted: #A9B7D0;
    out property <color> text-light: #71809A;
    out property <color> accent-primary: #7C5CFF;
    out property <color> accent-secondary: #00D5FF;
    out property <color> accent-hover: #273653;
    out property <color> accent-active: #33476E;
    out property <color> success: #42E6A4;
    out property <color> warning: #FFD166;
    out property <color> error: #FF6B8A;
    out property <color> selection-bg: #25375D;
    out property <color> selection-border: #8EA2FF;
    out property <color> row-odd: #0F1728;
    out property <color> row-even: #121D31;
}

component IconAdd inherits Rectangle {
    width: 24px; height: 24px;
    Rectangle { width: 12px; height: 2px; y: 11px; x: 6px; background: #4A9EFF; }
    Rectangle { width: 2px; height: 12px; x: 11px; y: 6px; background: #4A9EFF; }
}

component IconResume inherits Rectangle {
    width: 24px; height: 24px;
    Path {
        viewbox-width: 100; viewbox-height: 100;
        commands: "M 30,20 L 80,50 L 30,80 Z";
        fill: #48C774;
    }
}

component IconStop inherits Rectangle {
    width: 24px; height: 24px;
    Rectangle { width: 10px; height: 10px; x: 7px; y: 7px; background: #FF5353; }
}

component IconStopAll inherits Rectangle {
    width: 24px; height: 24px;
    Rectangle { x: 3px; width: 8px; height: 10px; background: #FF5353; }
    Rectangle { x: 13px; width: 8px; height: 10px; background: #FF5353; }
}

component IconDelete inherits Rectangle {
    width: 24px; height: 24px;
    Path {
        viewbox-width: 100; viewbox-height: 100;
        commands: "M 20,20 L 80,80 M 80,20 L 20,80";
        stroke: #FF5353;
        stroke-width: 6px;
    }
}

component IconCleanup inherits Rectangle {
    width: 24px; height: 24px;
    Rectangle { width: 12px; height: 3px; background: #999999; y: 17px; x: 6px; }
    Rectangle { width: 8px; height: 8px; background: #666666; y: 8px; x: 8px; }
}

component IconOptions inherits Rectangle {
    width: 24px; height: 24px;
    Rectangle { width: 3px; height: 3px; background: #4A9EFF; x: 2px; y: 10px; }
    Rectangle { width: 3px; height: 3px; background: #4A9EFF; x: 10px; y: 10px; }
    Rectangle { width: 3px; height: 3px; background: #4A9EFF; x: 18px; y: 10px; }
}

component IconScheduler inherits Rectangle {
    width: 24px; height: 24px;
    Rectangle { width: 14px; height: 14px; border-width: 2px; border-color: #4A9EFF; x: 5px; y: 5px; }
    Rectangle { width: 1px; height: 4px; background: #4A9EFF; y: 7px; x: 11px; }
    Rectangle { width: 3px; height: 1px; background: #4A9EFF; x: 13px; y: 12px; }
}

component IconOpen inherits Rectangle {
    width: 24px; height: 24px;
    Path {
        viewbox-width: 100; viewbox-height: 100;
        commands: "M 30,20 L 30,70 L 80,70 L 80,35 L 65,20 Z M 65,20 L 65,35 L 80,35";
        stroke: #4A9EFF;
        stroke-width: 3px;
    }
}

component IconFolder inherits Rectangle {
    width: 24px; height: 24px;
    Path {
        viewbox-width: 100; viewbox-height: 100;
        commands: "M 10,30 L 10,80 L 90,80 L 90,35 L 40,35 L 30,20 L 10,20 Z";
        stroke: #4A9EFF;
        stroke-width: 3px;
    }
}

component IconUp inherits Rectangle {
    width: 24px; height: 24px;
    Path {
        viewbox-width: 100; viewbox-height: 100;
        commands: "M 50,20 L 30,50 L 40,50 L 40,80 L 60,80 L 60,50 L 70,50 Z";
        fill: #999999;
    }
}

component IconDown inherits Rectangle {
    width: 24px; height: 24px;
    Path {
        viewbox-width: 100; viewbox-height: 100;
        commands: "M 50,80 L 30,50 L 40,50 L 40,20 L 60,20 L 60,50 L 70,50 Z";
        fill: #999999;
    }
}

component IconRetry inherits Rectangle {
    width: 24px; height: 24px;
    Path {
        viewbox-width: 100; viewbox-height: 100;
        commands: "M 70,30 L 80,30 L 75,15 L 65,25 L 70,25 A 30,30 0 1 0 30,60";
        stroke: #48C774;
        stroke-width: 3px;
    }
}

component IconPlus inherits Rectangle {
    width: 24px; height: 24px;
    Rectangle { width: 12px; height: 2px; y: 11px; x: 6px; background: #4A9EFF; }
    Rectangle { width: 2px; height: 12px; x: 11px; y: 6px; background: #4A9EFF; }
}

component IconMinus inherits Rectangle {
    width: 24px; height: 24px;
    Rectangle { width: 12px; height: 2px; y: 11px; x: 6px; background: #FF5353; }
}

component ToolbarButton inherits Rectangle {
    in property <string> text;
    in property <bool> active: false;
    in property <bool> enabled: true;
    in property <string> icon-type;
    callback clicked;
    height: 56px;
    min-width: 64px;
    
    background: !enabled ? transparent : (active ? #2D3D66 : (ta.pressed ? Palette.accent-active : (ta.has-hover ? Palette.accent-hover : transparent)));
    border-radius: 10px;
    border-width: active ? 1px : 0px;
    border-color: active ? Palette.selection-border : transparent;

    VerticalLayout {
        alignment: center;
        spacing: 2px;
        padding: 4px;
        Rectangle {
            height: 24px; width: 24px;
            opacity: root.enabled ? 1.0 : 0.4;
            if icon-type == "add": IconAdd {}
            if icon-type == "resume": IconResume {}
            if icon-type == "stop": IconStop {}
            if icon-type == "stop-all": IconStopAll {}
            if icon-type == "delete": IconDelete {}
            if icon-type == "cleanup": IconCleanup {}
            if icon-type == "options": IconOptions {}
            if icon-type == "scheduler": IconScheduler {}
            if icon-type == "open": IconOpen {}
            if icon-type == "folder": IconFolder {}
            if icon-type == "up": IconUp {}
            if icon-type == "down": IconDown {}
            if icon-type == "retry": IconRetry {}
            if icon-type == "plus": IconPlus {}
            if icon-type == "minus": IconMinus {}
        }
        if text != "": Text { 
            text: root.text; 
            color: !enabled ? Palette.text-light : Palette.text-primary; 
            font-size: 9px; 
            font-weight: 500;
            horizontal-alignment: center; 
        }
    }
    
    ta := TouchArea { 
        width: 100%; height: 100%; 
        clicked => { if root.enabled { root.clicked(); } } 
    }
}

component MenuItem inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked;
    callback hover;
    height: 20px;
    background: ta.pressed ? #3B3D40 : (ta.has-hover ? #323437 : transparent);
    
    HorizontalLayout {
        padding-left: 9px; padding-right: 8px;
        alignment: start;
        Text {
            text: root.text;
            color: root.enabled ? #ECE9D8 : #8C8A80;
            font-size: 10px;
            font-weight: 400;
            vertical-alignment: center;
        }
    }
    
    ta := TouchArea {
        width: 100%; height: 100%;
        clicked => { if root.enabled { root.clicked(); } }
        moved => { root.hover(); }
    }
}

component DownloadsMenuEntry inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <string> shortcut;
    in property <bool> enabled: true;
    in property <bool> submenu: false;
    callback clicked;
    callback hover;
    height: 20px;
    background: ta.pressed ? #3A3C3F : (ta.has-hover ? #2F3134 : transparent);

    function icon-source(name: string) -> image {
        name == "edit" ? @image-url("assets/menu_edit.svg") :
        (name == "refresh" ? @image-url("assets/menu_refresh.svg") :
        (name == "info" ? @image-url("assets/menu_info.svg") :
        (name == "copy" ? @image-url("assets/menu_copy.svg") :
        (name == "queue" ? @image-url("assets/menu_queue.svg") :
        (name == "category" ? @image-url("assets/menu_category.svg") :
        (name == "next" ? @image-url("assets/menu_next.svg") : @image-url("assets/menu_info.svg")))))))
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 7px;
        spacing: 6px;
        alignment: start;

        Rectangle {
            width: 16px;
            height: 18px;
            background: transparent;
            Image {
                x: 1px;
                y: 2px;
                width: 14px;
                height: 14px;
                source: icon-source(root.icon);
                image-fit: contain;
            }
        }
        Text {
            text: root.text;
            color: root.enabled ? #ECE9D8 : #8C8A80;
            font-size: 10px;
            font-weight: 400;
            vertical-alignment: center;
        }
        Rectangle { width: 100%; }
        Rectangle {
            width: 44px;
            height: 18px;
            background: transparent;
            if root.shortcut != "": Text {
                text: root.shortcut;
                color: root.enabled ? #C4BFAD : #706D66;
                font-size: 8px;
                vertical-alignment: center;
                horizontal-alignment: right;
            }
        }
        Rectangle {
            width: 12px;
            height: 18px;
            background: transparent;
            if root.submenu: Image {
                x: 1px;
                y: 3px;
                width: 10px;
                height: 10px;
                source: icon-source("next");
                image-fit: contain;
            }
        }
    }

    ta := TouchArea {
        width: 100%; height: 100%;
        clicked => { if root.enabled { root.clicked(); } }
        moved => { root.hover(); }
    }
}

component DownloadsMenuPopup inherits Rectangle {
    in property <[DownloadsMenuRow]> rows;
    in property <[DownloadsMenuRow]> submenu_rows;
    in-out property <int> submenu_parent_index: -1;

    callback select-all();
    callback clear-selection();
    callback invoke(command-id: string, target-index: int);
    callback open-submenu(parent-index: int);
    callback sort-name();
    callback sort-size();
    callback sort-status();
    callback sort-date-added();

    background: #1F2123;
    border-color: #686A6D;
    border-width: 1px;
    border-radius: 6px;
    clip: true;

    Rectangle {
        x: 3px;
        y: 3px;
        width: parent.width;
        height: parent.height;
        background: #00000028;
        border-radius: 6px;
    }

    Rectangle {
        width: parent.width;
        height: parent.height;
        background: #242628;
        border-color: #56585B;
        border-width: 1px;
        border-radius: 6px;

        Rectangle {
            width: parent.width;
            height: 1px;
            background: #3B3D40;
        }

        HorizontalLayout {
            spacing: 0px;

            Rectangle {
                width: 205px;
                background: transparent;
                VerticalLayout {
                    spacing: 0px;
                    MenuItem { text: "Select All"; clicked => { root.select-all(); } hover => { root.submenu_parent_index = -1; } }
                    MenuItem { text: "Clear Selection"; clicked => { root.clear-selection(); } hover => { root.submenu_parent_index = -1; } }
                    Rectangle { height: 1px; background: #5A5B5E; }
                    for item[index] in root.rows: Rectangle {
                        height: item.row_kind == "separator" ? 5px : 20px;
                        background: transparent;
                        if item.row_kind == "separator": Rectangle {
                            y: 2px;
                            height: 1px;
                            width: 100%;
                            background: #5A5B5E;
                        }
                        if item.row_kind != "separator": DownloadsMenuEntry {
                            width: 100%;
                            text: item.title;
                            icon: item.icon == "" ? "info" : item.icon;
                            shortcut: item.shortcut;
                            enabled: item.enabled;
                            submenu: item.row_kind == "submenu";
                            hover => {
                                if item.row_kind == "submenu" {
                                    root.submenu_parent_index = index;
                                    root.open-submenu(index);
                                } else {
                                    root.submenu_parent_index = -1;
                                }
                            }
                            clicked => {
                                if item.row_kind == "submenu" {
                                    root.submenu_parent_index = index;
                                    root.open-submenu(index);
                                } else {
                                    root.invoke(item.command_id, item.target_index);
                                }
                            }
                        }
                    }
                    Rectangle { height: 1px; background: #5A5B5E; }
                    MenuItem { text: "Sort by Name"; clicked => { root.sort-name(); } hover => { root.submenu_parent_index = -1; } }
                    MenuItem { text: "Sort by Size"; clicked => { root.sort-size(); } hover => { root.submenu_parent_index = -1; } }
                    MenuItem { text: "Sort by Status"; clicked => { root.sort-status(); } hover => { root.submenu_parent_index = -1; } }
                    MenuItem { text: "Sort by Date Added"; clicked => { root.sort-date-added(); } hover => { root.submenu_parent_index = -1; } }
                }
            }

            if root.submenu_parent_index >= 0 && root.submenu_rows.length > 0: Rectangle {
                width: 185px;
                background: #242628;
                border-color: #56585B;
                border-width: 1px;
                border-radius: 6px;
                Rectangle {
                    x: 3px;
                    y: 3px;
                    width: parent.width;
                    height: parent.height;
                    background: #00000022;
                    border-radius: 6px;
                }
                VerticalLayout {
                    spacing: 0px;
                    for sub_item in root.submenu_rows: Rectangle {
                        height: sub_item.row_kind == "separator" ? 5px : 20px;
                        background: transparent;
                        if sub_item.row_kind == "separator": Rectangle {
                            y: 2px;
                            height: 1px;
                            width: 100%;
                            background: #5A5B5E;
                        }
                        if sub_item.row_kind != "separator": DownloadsMenuEntry {
                            width: 100%;
                            text: sub_item.title;
                            icon: sub_item.icon == "" ? "info" : sub_item.icon;
                            shortcut: sub_item.shortcut;
                            enabled: sub_item.enabled;
                            submenu: false;
                            hover => { }
                            clicked => {
                                root.submenu_parent_index = -1;
                                root.invoke(sub_item.command_id, sub_item.target_index);
                            }
                        }
                    }
                }
            }
        }
    }
}

component TreeItem inherits Rectangle {
    in property <string> text;
    in property <bool> active: false;
    in property <string> icon-type;
    callback clicked <=> ta.clicked;
    height: 24px;
    background: active ? Palette.selection-bg : (ta.has-hover ? Palette.accent-hover : transparent);
    
    Rectangle {
        x: 0; width: 3px; height: 100%;
        background: active ? Palette.accent-primary : transparent;
    }

    HorizontalLayout {
        padding-left: 8px; padding-right: 6px;
        spacing: 8px;
        alignment: start;
        Rectangle { 
            width: 14px; height: 14px; 
            VerticalLayout {
                alignment: center;
                if icon-type == "all": Rectangle { width: 10px; height: 10px; border-width: 1px; border-color: Palette.accent-primary; }
                if icon-type == "unfinished": Rectangle { width: 10px; height: 10px; background: Palette.warning; }
                if icon-type == "finished": Rectangle { width: 10px; height: 10px; background: Palette.success; }
                if icon-type == "queue": Rectangle { width: 10px; height: 10px; border-width: 1px; border-color: Palette.text-muted; }
            }
        }
        Text { 
            text: root.text; 
            color: Palette.text-primary; 
            vertical-alignment: center; 
            font-size: 11px; 
            font-weight: active ? 600 : 400;
        }
    }
    ta := TouchArea { width: 100%; height: 100%; }
}

component StandardInput inherits Rectangle {
    in property <string> text;
    in property <string> placeholder;
    callback edited(string);
    height: 32px;
    background: Palette.panel;
    border-color: editor.has-focus ? Palette.accent-primary : Palette.border;
    border-width: editor.has-focus ? 2px : 1px;
    
    editor := LineEdit { 
        x: 8px; y: 0; width: parent.width - 16px; height: parent.height;
        text: root.text; 
        placeholder-text: root.placeholder;
        edited(t) => { root.edited(t); } 
    }
}

export component MainWindow inherits Window {
    width: 1120px;
    height: 680px;
    title: "Flow Download Manager";
    background: Palette.bg;
    default-font-family: "Segoe UI";

    in property <[DownloadRow]> download-rows: [];
    in property <[string]> queue-groups: ["Main"];
    in property <int> selected-queue-index: 0;
    in property <string> queue-config-summary: "";
    in property <string> queue-name-text: "Main";
    in property <string> browser-extension-id-text: "";
    in property <string> default-folder-text: "";
    in property <int> selected-download-index: -1;
    in-out property <int> selected-category-index: 0;
    in property <string> status-message: "Ready";
    in property <bool> show-delete-confirm: false;
    in property <bool> can-open-selected: false;
    in property <bool> can-open-selected-folder: false;
    in property <bool> can-delete-selected: false;
    in property <bool> can-resume-selected: false;
    in property <bool> can-stop-selected: false;
    in property <bool> can-move-selected-up: false;
    in property <bool> can-move-selected-down: false;
    in property <bool> can-requeue-selected: false;
    in property <int> footer-active-count: 0;
    in property <string> footer-speed-text: "0 B";
    in property <string> footer-total-text: "0";
    in property <[string]> move-queue-labels: [];
    in property <[string]> move-category-labels: [];
    in-out property <bool> show-properties-dialog: false;
    in-out property <string> properties-summary: "";
    in-out property <bool> show-file-checksum-dialog: false;
    in-out property <string> file-checksum-summary: "";
    in-out property <[DownloadsMenuRow]> downloads-menu-rows: [];
    in-out property <[DownloadsMenuRow]> downloads-submenu-rows: [];
    
    // Settings properties
    in property <int> thread-count: 4;
    in property <int> max-concurrent: 2;
    in property <bool> auto-start-enabled: false;
    in property <bool> system-tray-enabled: false;
    in property <bool> browser-integration-enabled: false;
    in property <bool> clipboard-monitoring-enabled: false;
    in property <int> proxy-mode: 0; // 0: Direct, 1: System, 2: Manual

    callback retry-failed(); callback cleanup-finished(); callback select-queue(index: int); callback select-category(index: int); callback create-queue();
    callback toggle-queue(); callback delete-queue(); callback select-download(index: int); callback move-download-up();
    callback move-download-down(); callback requeue-download(); callback queue-max-minus(); callback queue-max-plus();
    callback queue-toggle-stop-on-empty(); callback queue-name-changed(value: string); callback toggle-auto-start();
    callback add-url(); callback resume-selected(); callback stop-selected(); callback stop-all(); callback delete-selected();
    callback request-delete-selected(); callback confirm-delete-selected(); callback cancel-delete-selected();
    callback open-selected(); callback open-selected-folder(); callback retry-selected();
    callback toggle-system-tray(); callback toggle-browser-integration(); callback toggle-clipboard-monitoring();
    callback settings-thread-minus(); callback settings-thread-plus(); callback settings-max-minus(); callback settings-max-plus();
    callback settings-use-downloads-folder(); callback register-browser-host();
    callback queue-create-new(); callback queue-rename(); callback queue-delete-confirm();
    callback proxy-mode-changed(mode: int); callback proxy-test-connection();
    callback queue-schedule-toggle-enabled(); callback queue-schedule-start-minus(); callback queue-schedule-start-plus();
    callback queue-schedule-stop-minus(); callback queue-schedule-stop-plus(); callback queue-schedule-toggle-day(day: int);
    callback tasks-start-all(); callback tasks-pause-all();
    callback file-batch-download(); callback app-exit();
    callback downloads-select-all(); callback downloads-clear-selection(); callback toggle-download-checked(index: int); callback downloads-sort-by-name();
    callback downloads-sort-by-size(); callback downloads-sort-by-status(); callback downloads-sort-by-date-added();
    callback view-refresh(); callback view-toggle-toolbar(); callback view-toggle-status-bar();
    callback tools-browser-integration(); callback tools-per-host-settings(); callback tools-open-settings();
    callback help-about(); callback help-check-updates(); callback help-online-help(); callback help-donate(); callback help-translators();
    callback menu-tasks(); callback menu-file(); callback menu-downloads(); callback menu-view(); callback menu-tools(); callback menu-help();
    callback tasks-delete-finished(); callback tasks-delete-unfinished(); callback tasks-delete-current-queue();
    callback file-open-add-url(); callback file-open-batch-download(); callback file-open-settings();
    callback move-selection-to-queue(index: int); callback move-selection-to-category(index: int);
    callback copy-selected-links(); callback copy-selected-as-curl(); callback show-selected-properties(); callback close-properties-dialog();
    callback restart-selected-downloads(); callback edit-selected-download(); callback show-file-checksum(); callback close-file-checksum-dialog();
    callback downloads-menu-command(command-id: string, target-index: int);
    callback downloads-menu-open-submenu(parent-index: int);

    in-out property <int> current-tab: 0; // 0 downloads, 1 scheduler, 2 settings
    in-out property <bool> queue-stop-on-empty: false;
    in-out property <bool> queue-schedule-enabled: false;
    in-out property <string> queue-schedule-start: "08:00";
    in-out property <string> queue-schedule-stop: "18:00";
    in-out property <bool> queue-day-sun: true;
    in-out property <bool> queue-day-mon: true;
    in-out property <bool> queue-day-tue: true;
    in-out property <bool> queue-day-wed: true;
    in-out property <bool> queue-day-thu: true;
    in-out property <bool> queue-day-fri: true;
    in-out property <bool> queue-day-sat: true;
    in-out property <int> active-menu: -1;
    property <length> menu-popup-width: 180px;
    property <length> menu-popup-x: 6px + (active-menu * 72px);
    property <length> menu-popup-height: active-menu == 0 ? 150px : (active-menu == 2 ? 176px : (active-menu == 5 ? 152px : 94px));
    in-out property <bool> toolbar-visible: true;
    in-out property <bool> status-bar-visible: true;
    in-out property <bool> merge-topbar-with-titlebar: false;
    in-out property <length> categories-panel-width: 200px;
    in-out property <bool> show-overlay-notification: false;
    in-out property <string> overlay-notification-text: "";
    in-out property <bool> drag-overlay-visible: false;
    in-out property <string> drag-overlay-text: "Drop URLs to queue download";
    callback categories-width-delta(delta: length);

    VerticalLayout {
        spacing: 0;

        // Menu Bar (hidden when merged into titlebar region)
        if !root.merge-topbar-with-titlebar: Rectangle {
            height: 22px; background: Palette.surface;
            HorizontalLayout { padding-left: 0px; padding-right: 0px; spacing: 0px;
                MenuItem { text: "Tasks"; clicked => { if root.active-menu == 0 { root.active-menu = -1; } else { root.menu-tasks(); } } hover => { if root.active-menu >= 0 { root.active-menu = 0; } } }
                MenuItem { text: "File"; clicked => { if root.active-menu == 1 { root.active-menu = -1; } else { root.menu-file(); } } hover => { if root.active-menu >= 0 { root.active-menu = 1; } } }
                MenuItem { text: "Downloads"; clicked => { if root.active-menu == 2 { root.active-menu = -1; } else { root.menu-downloads(); } } hover => { if root.active-menu >= 0 { root.active-menu = 2; } } }
                MenuItem { text: "View"; clicked => { if root.active-menu == 3 { root.active-menu = -1; } else { root.menu-view(); } } hover => { if root.active-menu >= 0 { root.active-menu = 3; } } }
                MenuItem { text: "Tools"; clicked => { if root.active-menu == 4 { root.active-menu = -1; } else { root.menu-tools(); } } hover => { if root.active-menu >= 0 { root.active-menu = 4; } } }
                MenuItem { text: "Help"; clicked => { if root.active-menu == 5 { root.active-menu = -1; } else { root.menu-help(); } } hover => { if root.active-menu >= 0 { root.active-menu = 5; } } }
                Rectangle { width: 100%; }
            }
            Rectangle { y: parent.height - 1px; width: 100%; height: 1px; background: Palette.border; }
        }

        if root.merge-topbar-with-titlebar: Rectangle { height: 4px; background: Palette.bg; }

        // Toolbar - grouped actions and visible page switches
        if root.toolbar-visible: Rectangle {
            height: 64px; background: Palette.panel;
            HorizontalLayout {
                padding-left: 4px; padding-right: 4px;
                spacing: 2px;
                alignment: start;

                ToolbarButton { text: "Add URL"; icon-type: "add"; clicked => { root.add-url(); current-tab = 0; } }
                Rectangle { width: 1px; height: 32px; background: Palette.border; y: 10px; }

                ToolbarButton { text: "Resume"; icon-type: "resume"; enabled: root.can-resume-selected; clicked => { root.resume-selected(); current-tab = 0; } }
                ToolbarButton { text: "Stop"; icon-type: "stop"; enabled: root.can-stop-selected; clicked => { root.stop-selected(); current-tab = 0; } }
                ToolbarButton { text: "Stop All"; icon-type: "stop-all"; clicked => { root.stop-all(); current-tab = 0; } }
                Rectangle { width: 1px; height: 32px; background: Palette.border; y: 10px; }

                ToolbarButton { text: "Delete"; icon-type: "delete"; enabled: root.can-delete-selected; clicked => { root.request-delete-selected(); current-tab = 0; } }
                ToolbarButton { text: "Cleanup"; icon-type: "cleanup"; clicked => { root.cleanup-finished(); current-tab = 0; } }
                Rectangle { width: 1px; height: 32px; background: Palette.border; y: 10px; }

                ToolbarButton { text: "Open"; icon-type: "open"; enabled: root.can-open-selected; clicked => { root.open-selected(); } }
                ToolbarButton { text: "Folder"; icon-type: "folder"; enabled: root.can-open-selected-folder; clicked => { root.open-selected-folder(); } }
                Rectangle { width: 1px; height: 32px; background: Palette.border; y: 10px; }

                ToolbarButton { text: "Scheduler"; icon-type: "scheduler"; active: current-tab == 1; clicked => { current-tab = 1; } }
                ToolbarButton { text: "Settings"; icon-type: "options"; active: current-tab == 2; clicked => { current-tab = 2; } }

                Rectangle { width: 100%; }
            }
            Rectangle { y: parent.height - 1px; width: 100%; height: 1px; background: Palette.border; }
        }

        HorizontalLayout {
            // Sidebar
            Rectangle {
                width: root.categories-panel-width; background: Palette.surface;
                Rectangle {
                    x: 0; y: 0; width: 100%; height: 100%;
                    background: @linear-gradient(180deg, #17233A 0%, #0F1728 100%);
                }
                VerticalLayout {
                    padding-left: 5px; padding-right: 5px; padding-top: 6px; padding-bottom: 6px;
                    spacing: 2px;
                    
                    Text { text: "CATEGORIES"; font-size: 10px; font-weight: 700; color: Palette.text-light; letter-spacing: 0.5px; }
                    TreeItem { text: "All Downloads"; icon-type: "all"; active: root.selected-category-index == 0; clicked => { root.selected-category-index = 0; root.select-category(0); } }
                    TreeItem { text: "Unfinished"; icon-type: "unfinished"; active: root.selected-category-index == 1; clicked => { root.selected-category-index = 1; root.select-category(1); } }
                    TreeItem { text: "Finished"; icon-type: "finished"; active: root.selected-category-index == 2; clicked => { root.selected-category-index = 2; root.select-category(2); } }
                    
                    Rectangle { height: 8px; }
                    
                    HorizontalLayout {
                        spacing: 4px; alignment: start;
                        Text { text: "QUEUES"; font-size: 10px; font-weight: 700; color: Palette.text-light; letter-spacing: 0.5px; }
                        Rectangle { width: 100%; }
                    }
                    
                    ScrollView {
                        VerticalLayout {
                            spacing: 1px;
                            for q[i] in root.queue-groups: Rectangle {
                                height: 28px;
                                background: i == root.selected-queue-index ? Palette.selection-bg : transparent;
                                border-color: i == root.selected-queue-index ? Palette.accent-primary : transparent;
                                border-width: i == root.selected-queue-index ? 1px : 0px;
                                
                                HorizontalLayout {
                                    padding-left: 6px; padding-right: 6px; spacing: 6px;
                                    Rectangle { 
                                        width: 12px; height: 12px; 
                                        VerticalLayout { alignment: center;
                                            Rectangle { width: 8px; height: 8px; border-width: 1px; border-color: Palette.text-muted; }
                                        }
                                    }
                                    Text { 
                                        text: q; 
                                        color: Palette.text-primary; 
                                        vertical-alignment: center; 
                                        font-size: 11px; 
                                        font-weight: i == root.selected-queue-index ? 700 : 500;
                                        width: 100%;
                                    }
                                }
                                TouchArea { clicked => { root.select-queue(i); } }
                            }
                        }
                    }
                }
                Rectangle { x: parent.width - 1px; y: 0; width: 1px; height: 100%; background: Palette.border; }
            }

            // Splitter handle (IDM-style side/content divider)
            Rectangle {
                width: 5px;
                background: Palette.bg;
                Rectangle { x: 2px; y: 0; width: 1px; height: parent.height; background: Palette.border; }
                TouchArea {
                    moved => {
                        root.categories-width-delta(self.mouse-x - self.pressed-x);
                    }
                }
            }

            // Main Content Area
            Rectangle {
                background: Palette.bg;
                VerticalLayout {
                    padding-left: 0px; padding-right: 0px; padding-top: 0px; padding-bottom: 0px;
                    spacing: 0px;
                if current-tab == 0: VerticalLayout {
                    padding-left: 2px; padding-right: 2px; padding-top: 0px; padding-bottom: 0px;
                    spacing: 0px;
                    Rectangle { height: 2px; background: transparent; }
                    // Header for Table
                    Rectangle {
                        height: 22px; background: Palette.panel;
                        HorizontalLayout {
                            padding-left: 6px; padding-right: 6px; spacing: 0;
                            Rectangle {
                                width: 28px;
                            }
                            Rectangle {
                                width: 272px;
                                Text { text: "File Name"; width: 100%; font-size: 10px; font-weight: 600; color: Palette.text-muted; vertical-alignment: center; }
                                TouchArea { clicked => { root.downloads-sort-by-name(); } }
                            }
                            Rectangle { width: 1px; background: Palette.border; }
                            Rectangle {
                                width: 80px;
                                Text { text: "Size"; width: 100%; font-size: 10px; font-weight: 600; color: Palette.text-muted; vertical-alignment: center; horizontal-alignment: center; }
                                TouchArea { clicked => { root.downloads-sort-by-size(); } }
                            }
                            Rectangle { width: 1px; background: Palette.border; }
                            Rectangle {
                                width: 100px;
                                Text { text: "Status"; width: 100%; font-size: 10px; font-weight: 600; color: Palette.text-muted; vertical-alignment: center; horizontal-alignment: center; }
                                TouchArea { clicked => { root.downloads-sort-by-status(); } }
                            }
                            Rectangle { width: 1px; background: Palette.border; }
                            Text { text: "Speed"; width: 80px; font-size: 10px; font-weight: 600; color: Palette.text-muted; vertical-alignment: center; horizontal-alignment: center; }
                            Rectangle { width: 1px; background: Palette.border; }
                            Text { text: "Time Left"; width: 80px; font-size: 10px; font-weight: 600; color: Palette.text-muted; vertical-alignment: center; horizontal-alignment: center; }
                            Rectangle { width: 1px; background: Palette.border; }
                            Rectangle {
                                width: 130px;
                                Text { text: "Date Added"; width: 100%; font-size: 10px; font-weight: 600; color: Palette.text-muted; vertical-alignment: center; horizontal-alignment: center; }
                                TouchArea { clicked => { root.downloads-sort-by-date-added(); } }
                            }
                            Rectangle { width: 100%; }
                        }
                        Rectangle { y: parent.height - 1px; width: 100%; height: 1px; background: Palette.border; }
                    }

                    // Table Body
                    ScrollView {
                        HorizontalLayout {
                            padding-left: 2px; padding-right: 2px; spacing: 0px;
                            VerticalLayout {
                                padding: 0; spacing: 0;
                            if root.download-rows.length == 0: Rectangle {
                                height: 116px;
                                background: transparent;
                                VerticalLayout {
                                    alignment: center;
                                    Text {
                                        text: root.selected-category-index == 1 ? "No unfinished downloads" : (root.selected-category-index == 2 ? "No finished downloads" : "No downloads yet");
                                        font-size: 12px;
                                        color: Palette.text-muted;
                                    }
                                }
                            }
                            for row[i] in root.download-rows: Rectangle {
                                height: 34px;
                                background: i == root.selected-download-index ? Palette.selection-bg : (ta.has-hover ? #1B2942 : (Math.mod(i, 2) == 1 ? Palette.row-even : Palette.row-odd));
                                border-radius: 8px;
                                border-width: i == root.selected-download-index ? 1px : 0px;
                                border-color: i == root.selected-download-index ? Palette.selection-border : transparent;
                                Rectangle { y: parent.height - 1px; width: 100%; height: 1px; background: #20304A; }
                                
                                HorizontalLayout {
                                    padding-left: 6px; padding-right: 6px; spacing: 0;
                                    Rectangle {
                                        width: 28px;
                                        Rectangle {
                                            x: 8px;
                                            y: 4px;
                                            width: 11px;
                                            height: 11px;
                                            border-width: 1px;
                                            border-color: row.checked ? Palette.accent-primary : Palette.border;
                                            background: row.checked ? Palette.accent-primary : Palette.panel;
                                            if row.checked: Text {
                                                text: "✓";
                                                color: Palette.bg;
                                                font-size: 8px;
                                                font-weight: 700;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                        TouchArea { clicked => { root.toggle-download-checked(i); } }
                                    }
                                    Text { text: row.name; width: 272px; font-size: 10px; vertical-alignment: center; color: Palette.text-primary; overflow: elide; }
                                    Text { text: row.size; width: 80px; font-size: 10px; vertical-alignment: center; horizontal-alignment: right; color: Palette.text-muted; }
                                    VerticalLayout {
                                        width: 100px; alignment: center; padding-left: 8px; padding-right: 8px;
                                        Text { text: row.status; font-size: 9px; font-weight: 600; color: (row.is-error ? Palette.error : Palette.success); horizontal-alignment: center; }
                                        if row.has-progress: Rectangle {
                                            height: 2px; background: Palette.border;
                                            Rectangle { x: 0; width: parent.width * row.progress / 100; background: Palette.accent-primary; height: 100%; }
                                        }
                                    }
                                    Text { text: row.speed; width: 80px; font-size: 10px; vertical-alignment: center; horizontal-alignment: center; color: Palette.text-muted; }
                                    Text { text: row.time-left; width: 80px; font-size: 10px; vertical-alignment: center; horizontal-alignment: center; color: Palette.text-muted; }
                                    Text { text: row.date-added; width: 130px; font-size: 10px; vertical-alignment: center; horizontal-alignment: center; color: Palette.text-muted; }
                                    Rectangle { width: 100%; }
                                }
                                ta := TouchArea { clicked => { root.select-download(i); } }
                            }
                            }
                        }
                    }
                }
                
                if current-tab == 1: VerticalLayout {
                    padding: 0px; spacing: 8px;
                    ScrollView {
                        VerticalLayout {
                            padding: 0; spacing: 10px;
                            Rectangle {
                                height: 64px; background: Palette.panel;
                                border-color: Palette.border;
                                border-width: 1px;
                                HorizontalLayout {
                                    padding-left: 14px; padding-right: 14px;
                                    alignment: center;
                                    VerticalLayout {
                                        spacing: 2px;
                                        Text { text: "Queue Scheduler"; font-size: 16px; font-weight: 700; color: Palette.text-primary; }
                                        Text { text: root.queue-name-text; font-size: 11px; color: Palette.text-muted; }
                                    }
                                    Rectangle { width: 100%; }
                                    Text { text: root.queue-config-summary; font-size: 10px; color: Palette.text-muted; horizontal-alignment: right; }
                                }
                            }

                            VerticalLayout {
                                spacing: 8px;
                                Text { text: "Queue Controls"; font-size: 11px; font-weight: 700; color: Palette.text-light; letter-spacing: 0.3px; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    ToolbarButton { text: "Start Queue"; icon-type: "resume"; height: 34px; clicked => { root.toggle-queue(); } }
                                    ToolbarButton { text: "Delete Queue"; icon-type: "delete"; height: 34px; clicked => { root.queue-delete-confirm(); } }
                                    ToolbarButton { text: "Rename"; height: 34px; clicked => { root.queue-rename(); } }
                                }
                            }

                            VerticalLayout {
                                spacing: 8px;
                                Text { text: "Selected Item Controls"; font-size: 11px; font-weight: 700; color: Palette.text-light; letter-spacing: 0.3px; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    ToolbarButton { text: "Move Up"; icon-type: "up"; enabled: root.can-move-selected-up; height: 34px; clicked => { root.move-download-up(); } }
                                    ToolbarButton { text: "Move Down"; icon-type: "down"; enabled: root.can-move-selected-down; height: 34px; clicked => { root.move-download-down(); } }
                                    ToolbarButton { text: "Requeue"; icon-type: "retry"; enabled: root.can-requeue-selected; height: 34px; clicked => { root.requeue-download(); } }
                                }
                            }

                            VerticalLayout {
                                spacing: 8px;
                                Text { text: "Queue Configuration"; font-size: 11px; font-weight: 700; color: Palette.text-light; letter-spacing: 0.3px; }
                                HorizontalLayout {
                                    spacing: 12px; alignment: start;
                                    Text { text: "Max Concurrent:"; width: 120px; vertical-alignment: center; font-size: 11px; color: Palette.text-muted; }
                                    ToolbarButton { text: "-"; min-width: 32px; icon-type: "minus"; height: 26px; clicked => { root.queue-max-minus(); } }
                                    Text { text: root.max-concurrent; width: 40px; vertical-alignment: center; horizontal-alignment: center; font-size: 11px; font-weight: 600; color: Palette.text-primary; }
                                    ToolbarButton { text: "+"; min-width: 32px; icon-type: "plus"; height: 26px; clicked => { root.queue-max-plus(); } }
                                }
                                HorizontalLayout {
                                    spacing: 12px; alignment: start;
                                    Text { text: "Stop on Empty:"; width: 120px; vertical-alignment: center; font-size: 11px; color: Palette.text-muted; }
                                    Rectangle {
                                        width: 40px; height: 20px; border-width: 1px; border-color: Palette.border;
                                        background: root.queue-stop-on-empty ? Palette.accent-primary : Palette.panel;
                                        TouchArea { clicked => { root.queue-stop-on-empty = !root.queue-stop-on-empty; root.queue-toggle-stop-on-empty(); } }
                                    }
                                }
                            }

                            VerticalLayout {
                                spacing: 8px;
                                Text { text: "Scheduler"; font-size: 11px; font-weight: 700; color: Palette.text-light; letter-spacing: 0.3px; }
                                HorizontalLayout {
                                    spacing: 12px; alignment: start;
                                    Text { text: "Enable Schedule:"; width: 120px; vertical-alignment: center; font-size: 11px; color: Palette.text-muted; }
                                    Rectangle {
                                        width: 50px; height: 20px; border-width: 1px; border-color: Palette.border;
                                        background: root.queue-schedule-enabled ? Palette.success : Palette.panel;
                                        TouchArea { clicked => { root.queue-schedule-enabled = !root.queue-schedule-enabled; root.queue-schedule-toggle-enabled(); } }
                                        Text { text: root.queue-schedule-enabled ? "ON" : "OFF"; horizontal-alignment: center; vertical-alignment: center; font-size: 10px; color: Palette.text-primary; }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 12px; alignment: start;
                                    Text { text: "Start Time:"; width: 120px; vertical-alignment: center; font-size: 11px; color: Palette.text-muted; }
                                    ToolbarButton { text: "-"; min-width: 32px; icon-type: "minus"; height: 26px; clicked => { root.queue-schedule-start-minus(); } }
                                    Text { text: root.queue-schedule-start; width: 64px; vertical-alignment: center; horizontal-alignment: center; font-size: 11px; font-weight: 600; color: Palette.text-primary; }
                                    ToolbarButton { text: "+"; min-width: 32px; icon-type: "plus"; height: 26px; clicked => { root.queue-schedule-start-plus(); } }
                                    Text { text: "Stop Time:"; width: 80px; vertical-alignment: center; font-size: 11px; color: Palette.text-muted; }
                                    ToolbarButton { text: "-"; min-width: 32px; icon-type: "minus"; height: 26px; clicked => { root.queue-schedule-stop-minus(); } }
                                    Text { text: root.queue-schedule-stop; width: 64px; vertical-alignment: center; horizontal-alignment: center; font-size: 11px; font-weight: 600; color: Palette.text-primary; }
                                    ToolbarButton { text: "+"; min-width: 32px; icon-type: "plus"; height: 26px; clicked => { root.queue-schedule-stop-plus(); } }
                                }
                                HorizontalLayout {
                                    spacing: 6px; alignment: start;
                                    Text { text: "Active Days:"; width: 120px; vertical-alignment: center; font-size: 11px; color: Palette.text-muted; }
                                    Rectangle { width: 34px; height: 24px; border-width: 1px; border-color: root.queue-day-sun ? Palette.accent-primary : Palette.border; background: root.queue-day-sun ? Palette.selection-bg : Palette.panel; TouchArea { clicked => { root.queue-day-sun = !root.queue-day-sun; root.queue-schedule-toggle-day(0); } } Text { text: "Su"; horizontal-alignment: center; vertical-alignment: center; font-size: 10px; color: Palette.text-primary; } }
                                    Rectangle { width: 34px; height: 24px; border-width: 1px; border-color: root.queue-day-mon ? Palette.accent-primary : Palette.border; background: root.queue-day-mon ? Palette.selection-bg : Palette.panel; TouchArea { clicked => { root.queue-day-mon = !root.queue-day-mon; root.queue-schedule-toggle-day(1); } } Text { text: "Mo"; horizontal-alignment: center; vertical-alignment: center; font-size: 10px; color: Palette.text-primary; } }
                                    Rectangle { width: 34px; height: 24px; border-width: 1px; border-color: root.queue-day-tue ? Palette.accent-primary : Palette.border; background: root.queue-day-tue ? Palette.selection-bg : Palette.panel; TouchArea { clicked => { root.queue-day-tue = !root.queue-day-tue; root.queue-schedule-toggle-day(2); } } Text { text: "Tu"; horizontal-alignment: center; vertical-alignment: center; font-size: 10px; color: Palette.text-primary; } }
                                    Rectangle { width: 34px; height: 24px; border-width: 1px; border-color: root.queue-day-wed ? Palette.accent-primary : Palette.border; background: root.queue-day-wed ? Palette.selection-bg : Palette.panel; TouchArea { clicked => { root.queue-day-wed = !root.queue-day-wed; root.queue-schedule-toggle-day(3); } } Text { text: "We"; horizontal-alignment: center; vertical-alignment: center; font-size: 10px; color: Palette.text-primary; } }
                                    Rectangle { width: 34px; height: 24px; border-width: 1px; border-color: root.queue-day-thu ? Palette.accent-primary : Palette.border; background: root.queue-day-thu ? Palette.selection-bg : Palette.panel; TouchArea { clicked => { root.queue-day-thu = !root.queue-day-thu; root.queue-schedule-toggle-day(4); } } Text { text: "Th"; horizontal-alignment: center; vertical-alignment: center; font-size: 10px; color: Palette.text-primary; } }
                                    Rectangle { width: 34px; height: 24px; border-width: 1px; border-color: root.queue-day-fri ? Palette.accent-primary : Palette.border; background: root.queue-day-fri ? Palette.selection-bg : Palette.panel; TouchArea { clicked => { root.queue-day-fri = !root.queue-day-fri; root.queue-schedule-toggle-day(5); } } Text { text: "Fr"; horizontal-alignment: center; vertical-alignment: center; font-size: 10px; color: Palette.text-primary; } }
                                    Rectangle { width: 34px; height: 24px; border-width: 1px; border-color: root.queue-day-sat ? Palette.accent-primary : Palette.border; background: root.queue-day-sat ? Palette.selection-bg : Palette.panel; TouchArea { clicked => { root.queue-day-sat = !root.queue-day-sat; root.queue-schedule-toggle-day(6); } } Text { text: "Sa"; horizontal-alignment: center; vertical-alignment: center; font-size: 10px; color: Palette.text-primary; } }
                                }
                            }

                            Rectangle { height: 100%; background: transparent; }
                        }
                    }
                }

                if current-tab == 2: VerticalLayout {
                    padding: 0px; spacing: 8px;
                    ScrollView {
                        VerticalLayout {
                            padding: 0; spacing: 14px;
                            Rectangle {
                                height: 64px; background: Palette.panel;
                                border-color: Palette.border;
                                border-width: 1px;
                                HorizontalLayout {
                                    padding-left: 14px; padding-right: 14px;
                                    alignment: center;
                                    VerticalLayout {
                                        spacing: 2px;
                                        Text { text: "Options / Settings"; font-size: 16px; font-weight: 700; color: Palette.text-primary; }
                                        Text { text: "Application, browser, clipboard, and proxy controls"; font-size: 10px; color: Palette.text-muted; }
                                    }
                                    Rectangle { width: 100%; }
                                }
                            }
                            
                            // Application Settings Section
                            VerticalLayout {
                                spacing: 10px;
                                Text { text: "Application Settings"; font-size: 11px; font-weight: 700; color: Palette.text-light; letter-spacing: 0.3px; }
                                
                                HorizontalLayout {
                                    alignment: start; spacing: 12px;
                                    Text { text: "Auto-Start:"; width: 140px; vertical-alignment: center; font-size: 11px; color: Palette.text-muted; }
                                    Rectangle {
                                        width: 50px; height: 20px; border-width: 1px; border-color: Palette.border;
                                        background: root.auto-start-enabled ? Palette.success : Palette.panel;
                                        TouchArea { clicked => { root.toggle-auto-start(); } }
                                        Text { text: root.auto-start-enabled ? "ON" : "OFF"; horizontal-alignment: center; vertical-alignment: center; font-size: 10px; color: Palette.text-primary; }
                                    }
                                }
                                
                                HorizontalLayout {
                                    alignment: start; spacing: 12px;
                                    Text { text: "System Tray:"; width: 140px; vertical-alignment: center; font-size: 11px; color: Palette.text-muted; }
                                    Rectangle {
                                        width: 50px; height: 20px; border-width: 1px; border-color: Palette.border;
                                        background: root.system-tray-enabled ? Palette.success : Palette.panel;
                                        TouchArea { clicked => { root.toggle-system-tray(); } }
                                        Text { text: root.system-tray-enabled ? "ON" : "OFF"; horizontal-alignment: center; vertical-alignment: center; font-size: 10px; color: Palette.text-primary; }
                                    }
                                }
                            }
                            
                            // Download Settings Section
                            VerticalLayout {
                                spacing: 10px;
                                Text { text: "Download Settings"; font-size: 11px; font-weight: 700; color: Palette.text-light; letter-spacing: 0.3px; }
                                
                                HorizontalLayout {
                                    alignment: start; spacing: 12px;
                                    Text { text: "Default Folder:"; width: 140px; vertical-alignment: center; font-size: 11px; color: Palette.text-muted; }
                                    StandardInput { width: 350px; text: root.default-folder-text; placeholder: "Select download folder..."; }
                                    ToolbarButton { text: "..."; min-width: 40px; height: 26px; clicked => { root.settings-use-downloads-folder(); } }
                                }
                                
                                HorizontalLayout {
                                    alignment: start; spacing: 12px;
                                    Text { text: "Thread Count:"; width: 140px; vertical-alignment: center; font-size: 11px; color: Palette.text-muted; }
                                    ToolbarButton { text: "-"; min-width: 32px; icon-type: "minus"; height: 26px; clicked => { root.settings-thread-minus(); } }
                                    Text { text: root.thread-count; width: 40px; vertical-alignment: center; horizontal-alignment: center; font-size: 11px; font-weight: 600; color: Palette.text-primary; }
                                    ToolbarButton { text: "+"; min-width: 32px; icon-type: "plus"; height: 26px; clicked => { root.settings-thread-plus(); } }
                                    Text { text: "(1-32)"; width: 80px; vertical-alignment: center; font-size: 10px; color: Palette.text-muted; }
                                }
                                
                                HorizontalLayout {
                                    alignment: start; spacing: 12px;
                                    Text { text: "Max Concurrent:"; width: 140px; vertical-alignment: center; font-size: 11px; color: Palette.text-muted; }
                                    ToolbarButton { text: "-"; min-width: 32px; icon-type: "minus"; height: 26px; clicked => { root.settings-max-minus(); } }
                                    Text { text: root.max-concurrent; width: 40px; vertical-alignment: center; horizontal-alignment: center; font-size: 11px; font-weight: 600; color: Palette.text-primary; }
                                    ToolbarButton { text: "+"; min-width: 32px; icon-type: "plus"; height: 26px; clicked => { root.settings-max-plus(); } }
                                    Text { text: "(1-10)"; width: 80px; vertical-alignment: center; font-size: 10px; color: Palette.text-muted; }
                                }
                            }
                            
                            // Browser Integration Section
                            VerticalLayout {
                                spacing: 10px;
                                Text { text: "Browser Integration"; font-size: 11px; font-weight: 700; color: Palette.text-light; letter-spacing: 0.3px; }
                                
                                HorizontalLayout {
                                    alignment: start; spacing: 12px;
                                    Text { text: "Enable Integration:"; width: 140px; vertical-alignment: center; font-size: 11px; color: Palette.text-muted; }
                                    Rectangle {
                                        width: 50px; height: 20px; border-width: 1px; border-color: Palette.border;
                                        background: root.browser-integration-enabled ? Palette.success : Palette.panel;
                                        TouchArea { clicked => { root.toggle-browser-integration(); } }
                                        Text { text: root.browser-integration-enabled ? "ON" : "OFF"; horizontal-alignment: center; vertical-alignment: center; font-size: 10px; color: Palette.text-primary; }
                                    }
                                }
                                
                                HorizontalLayout {
                                    alignment: start; spacing: 12px;
                                    Text { text: "Extension ID:"; width: 140px; vertical-alignment: center; font-size: 11px; color: Palette.text-muted; }
                                    StandardInput { width: 350px; text: root.browser-extension-id-text; placeholder: "Enter extension ID..."; }
                                }
                                
                                HorizontalLayout {
                                    alignment: start; spacing: 12px; padding-left: 152px;
                                    ToolbarButton { text: "Register Host"; height: 26px; clicked => { root.register-browser-host(); } }
                                }
                            }
                            
                            // Clipboard Monitoring Section
                            VerticalLayout {
                                spacing: 10px;
                                Text { text: "Clipboard Monitoring"; font-size: 11px; font-weight: 700; color: Palette.text-light; letter-spacing: 0.3px; }
                                
                                HorizontalLayout {
                                    alignment: start; spacing: 12px;
                                    Text { text: "Enable Monitoring:"; width: 140px; vertical-alignment: center; font-size: 11px; color: Palette.text-muted; }
                                    Rectangle {
                                        width: 50px; height: 20px; border-width: 1px; border-color: Palette.border;
                                        background: root.clipboard-monitoring-enabled ? Palette.success : Palette.panel;
                                        TouchArea { clicked => { root.toggle-clipboard-monitoring(); } }
                                        Text { text: root.clipboard-monitoring-enabled ? "ON" : "OFF"; horizontal-alignment: center; vertical-alignment: center; font-size: 10px; color: Palette.text-primary; }
                                    }
                                }
                                
                                Text { text: "Automatically detect URLs in clipboard and show a download confirmation dialog."; font-size: 10px; color: Palette.text-muted; }
                            }
                            
                            // Proxy Settings Section
                            VerticalLayout {
                                spacing: 10px;
                                Text { text: "Proxy Settings"; font-size: 11px; font-weight: 700; color: Palette.text-light; letter-spacing: 0.3px; }
                                
                                HorizontalLayout {
                                    alignment: start; spacing: 12px;
                                    Text { text: "Proxy Mode:"; width: 140px; vertical-alignment: center; font-size: 11px; color: Palette.text-muted; }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Rectangle {
                                            width: 80px; height: 26px; border-width: 1px; border-color: root.proxy-mode == 0 ? Palette.accent-primary : Palette.border;
                                            background: root.proxy-mode == 0 ? Palette.selection-bg : Palette.panel;
                                            TouchArea { clicked => { root.proxy-mode-changed(0); } }
                                            Text { text: "Direct"; horizontal-alignment: center; vertical-alignment: center; font-size: 11px; color: Palette.text-primary; }
                                        }
                                        Rectangle {
                                            width: 80px; height: 26px; border-width: 1px; border-color: root.proxy-mode == 1 ? Palette.accent-primary : Palette.border;
                                            background: root.proxy-mode == 1 ? Palette.selection-bg : Palette.panel;
                                            TouchArea { clicked => { root.proxy-mode-changed(1); } }
                                            Text { text: "System"; horizontal-alignment: center; vertical-alignment: center; font-size: 11px; color: Palette.text-primary; }
                                        }
                                        Rectangle {
                                            width: 80px; height: 26px; border-width: 1px; border-color: root.proxy-mode == 2 ? Palette.accent-primary : Palette.border;
                                            background: root.proxy-mode == 2 ? Palette.selection-bg : Palette.panel;
                                            TouchArea { clicked => { root.proxy-mode-changed(2); } }
                                            Text { text: "Manual"; horizontal-alignment: center; vertical-alignment: center; font-size: 11px; color: Palette.text-primary; }
                                        }
                                    }
                                }
                                
                                if root.proxy-mode == 2: VerticalLayout {
                                    spacing: 8px;
                                    HorizontalLayout {
                                        alignment: start; spacing: 12px;
                                        Text { text: "Proxy Host:"; width: 140px; vertical-alignment: center; font-size: 11px; color: Palette.text-muted; }
                                        StandardInput { width: 200px; placeholder: "Enter proxy host..."; }
                                    }
                                    HorizontalLayout {
                                        alignment: start; spacing: 12px;
                                        Text { text: "Proxy Port:"; width: 140px; vertical-alignment: center; font-size: 11px; color: Palette.text-muted; }
                                        StandardInput { width: 100px; placeholder: "8080"; }
                                        ToolbarButton { text: "Test Connection"; height: 26px; clicked => { root.proxy-test-connection(); } }
                                    }
                                }
                            }
                            
                            Rectangle { height: 32px; background: transparent; }
                        }
                    }
                }

                // Right-column footer stats strip (IDM ordering: toolbar/list/separator/footer)
                Rectangle {
                    height: 2px;
                    background: Palette.border;
                }
                if root.status-bar-visible: Rectangle {
                    height: 22px; background: Palette.panel;
                    HorizontalLayout {
                        padding-left: 10px; padding-right: 10px; spacing: 12px;
                        Text { text: root.status-message; font-size: 10px; vertical-alignment: center; color: Palette.text-primary; font-weight: 400; }
                        Rectangle { width: 1px; background: Palette.border; height: 12px; y: 5px; }
                        Rectangle { width: 100%; }
                        Text { text: "Active: " + footer-active-count; font-size: 10px; vertical-alignment: center; color: Palette.text-muted; }
                        Text { text: "Downloaded: " + footer-speed-text; font-size: 10px; vertical-alignment: center; color: Palette.text-muted; }
                        Text { text: "Total: " + footer-total-text; font-size: 10px; vertical-alignment: center; color: Palette.text-muted; }
                    }
                }
            }
            }
        }

    }

    // Overlay stack: notifications -> drag overlay -> menu/popup -> dialogs
    if root.show-overlay-notification: Rectangle {
        x: root.width - 290px;
        y: 58px;
        width: 270px;
        height: 34px;
        background: #2A2E31EE;
        border-color: Palette.border;
        border-width: 1px;
        border-radius: 6px;
        HorizontalLayout {
            padding-left: 12px; padding-right: 12px;
            Text {
                text: root.overlay-notification-text;
                color: Palette.text-primary;
                font-size: 10px;
                vertical-alignment: center;
            }
        }
    }

    if root.drag-overlay-visible: Rectangle {
        x: 0; y: 0; width: root.width; height: root.height;
        background: #0B0D1088;
        Rectangle {
            x: (parent.width - 260px) / 2;
            y: (parent.height - 96px) / 2;
            width: 260px;
            height: 96px;
            background: #24282CDD;
            border-color: Palette.accent-primary;
            border-width: 1px;
            border-radius: 10px;
            VerticalLayout {
                alignment: center;
                Text {
                    text: root.drag-overlay-text;
                    color: Palette.text-primary;
                    font-size: 14px;
                    font-weight: 700;
                    horizontal-alignment: center;
                }
                Text {
                    text: "Release to add items to the active queue";
                    color: Palette.text-muted;
                    font-size: 10px;
                    horizontal-alignment: center;
                }
            }
        }
    }

    if active-menu >= 0: Rectangle {
        x: 0; y: 0; width: root.width; height: root.height;
        background: #00000000;
        TouchArea { clicked => { root.active-menu = -1; } }
    }

    if active-menu >= 0: Rectangle {
        x: root.menu-popup-x; y: 28px;
        width: root.menu-popup-width; height: root.menu-popup-height;
        background: Palette.surface;
        border-color: Palette.border;
        border-width: 1px;

        VerticalLayout {
            padding-left: 4px; padding-right: 4px; padding-top: 4px; padding-bottom: 4px;
            spacing: 2px;

            if active-menu == 0: VerticalLayout {
                spacing: 2px;
                MenuItem { text: "Start All"; clicked => { root.tasks-start-all(); root.active-menu = -1; } }
                MenuItem { text: "Pause All"; clicked => { root.tasks-pause-all(); root.active-menu = -1; } }
                MenuItem { text: "Stop All"; clicked => { root.stop-all(); root.active-menu = -1; } }
                MenuItem { text: "Retry Failed"; clicked => { root.retry-failed(); root.active-menu = -1; } }
                MenuItem { text: "Delete Finished"; clicked => { root.tasks-delete-finished(); root.active-menu = -1; } }
                MenuItem { text: "Delete Unfinished"; clicked => { root.tasks-delete-unfinished(); root.active-menu = -1; } }
                MenuItem { text: "Delete Current Queue"; clicked => { root.tasks-delete-current-queue(); root.active-menu = -1; } }
                MenuItem { text: "Cleanup"; clicked => { root.cleanup-finished(); root.active-menu = -1; } }
            }

            if active-menu == 1: VerticalLayout {
                spacing: 2px;
                MenuItem { text: "Add URL"; clicked => { root.file-open-add-url(); current-tab = 0; root.active-menu = -1; } }
                MenuItem { text: "Batch Download"; clicked => { root.file-open-batch-download(); root.active-menu = -1; } }
                MenuItem { text: "Settings"; clicked => { root.file-open-settings(); current-tab = 2; root.active-menu = -1; } }
                MenuItem { text: "Exit"; clicked => { root.app-exit(); root.active-menu = -1; } }
            }
            if active-menu == 2: DownloadsMenuPopup {
                rows: root.downloads-menu-rows;
                submenu_rows: root.downloads-submenu-rows;

                select-all => { root.downloads-select-all(); root.active-menu = -1; }
                clear-selection => { root.downloads-clear-selection(); root.active-menu = -1; }
                open-submenu(parent-index) => { root.downloads-menu-open-submenu(parent-index); }
                invoke(command-id, target-index) => { root.downloads-menu-command(command-id, target-index); root.active-menu = -1; }
                sort-name => { root.downloads-sort-by-name(); root.active-menu = -1; }
                sort-size => { root.downloads-sort-by-size(); root.active-menu = -1; }
                sort-status => { root.downloads-sort-by-status(); root.active-menu = -1; }
                sort-date-added => { root.downloads-sort-by-date-added(); root.active-menu = -1; }
            }

            if active-menu == 3: VerticalLayout {
                spacing: 2px;
                MenuItem { text: "Refresh"; clicked => { root.view-refresh(); root.active-menu = -1; } }
                MenuItem { text: "Sort by Name"; clicked => { root.downloads-sort-by-name(); root.active-menu = -1; } }
                MenuItem { text: "Sort by Size"; clicked => { root.downloads-sort-by-size(); root.active-menu = -1; } }
                MenuItem { text: "Show Toolbar"; clicked => { root.view-toggle-toolbar(); root.active-menu = -1; } }
                MenuItem { text: "Show Status Bar"; clicked => { root.view-toggle-status-bar(); root.active-menu = -1; } }
            }

            if active-menu == 4: VerticalLayout {
                spacing: 2px;
                MenuItem { text: "Browser Integration"; clicked => { current-tab = 2; root.tools-browser-integration(); root.active-menu = -1; } }
                MenuItem { text: "Per-host Settings"; clicked => { current-tab = 2; root.tools-per-host-settings(); root.active-menu = -1; } }
                MenuItem { text: "Settings"; clicked => { current-tab = 2; root.tools-open-settings(); root.active-menu = -1; } }
            }

            if active-menu == 5: VerticalLayout {
                spacing: 2px;
                MenuItem { text: "About"; clicked => { root.help-about(); root.active-menu = -1; } }
                MenuItem { text: "Check Updates"; clicked => { root.help-check-updates(); root.active-menu = -1; } }
                MenuItem { text: "Donate"; clicked => { root.help-donate(); root.active-menu = -1; } }
                MenuItem { text: "Translators"; clicked => { root.help-translators(); root.active-menu = -1; } }
                MenuItem { text: "Online Help"; clicked => { root.help-online-help(); root.active-menu = -1; } }
            }
        }
    }

    if root.show-delete-confirm || root.show-properties-dialog || root.show-file-checksum-dialog: Rectangle {
        x: 0; y: 0; width: root.width; height: root.height;
        background: #00000088;

        if root.show-delete-confirm: Rectangle {
            x: (parent.width - 420px) / 2;
            y: (parent.height - 180px) / 2;
            width: 420px; height: 180px;
            background: Palette.surface; border-color: Palette.border; border-width: 1px;
            VerticalLayout {
                padding: 24px; spacing: 18px;
                Text { text: "Confirm Delete"; font-size: 16px; font-weight: 700; color: Palette.text-primary; }
                Text { text: "Are you sure you want to remove the selected download task from the list?"; font-size: 13px; color: Palette.text-muted; }
                HorizontalLayout {
                    spacing: 12px; alignment: end;
                    ToolbarButton { text: "Yes, Delete"; height: 36px; clicked => { root.confirm-delete-selected(); } }
                    ToolbarButton { text: "No, Keep"; height: 36px; clicked => { root.cancel-delete-selected(); } }
                }
            }
        }

        if root.show-properties-dialog: Rectangle {
            x: (parent.width - 520px) / 2;
            y: (parent.height - 280px) / 2;
            width: 520px; height: 280px;
            background: Palette.surface; border-color: Palette.border; border-width: 1px;
            VerticalLayout {
                padding: 20px; spacing: 12px;
                Text { text: "Download Properties"; font-size: 16px; font-weight: 700; color: Palette.text-primary; }
                Rectangle {
                    border-width: 1px; border-color: Palette.border; background: Palette.panel;
                    height: 180px;
                    Text {
                        x: 12px; y: 12px; width: parent.width - 24px;
                        text: root.properties-summary;
                        color: Palette.text-primary;
                        font-size: 11px;
                        wrap: word-wrap;
                    }
                }
                HorizontalLayout {
                    spacing: 12px; alignment: end;
                    ToolbarButton { text: "Close"; height: 36px; clicked => { root.close-properties-dialog(); } }
                }
            }
        }

        if root.show-file-checksum-dialog: Rectangle {
            x: (parent.width - 540px) / 2;
            y: (parent.height - 300px) / 2;
            width: 540px; height: 300px;
            background: Palette.surface; border-color: Palette.border; border-width: 1px;
            VerticalLayout {
                padding: 20px; spacing: 12px;
                Text { text: "File Checksum"; font-size: 16px; font-weight: 700; color: Palette.text-primary; }
                Rectangle {
                    border-width: 1px; border-color: Palette.border; background: Palette.panel;
                    height: 200px;
                    Text {
                        x: 12px; y: 12px; width: parent.width - 24px;
                        text: root.file-checksum-summary;
                        color: Palette.text-primary;
                        font-size: 11px;
                        wrap: word-wrap;
                    }
                }
                HorizontalLayout {
                    spacing: 12px; alignment: end;
                    ToolbarButton { text: "Close"; height: 36px; clicked => { root.close-file-checksum-dialog(); } }
                }
            }
        }
    }
}


export component AddUrlDialog inherits Window {
    width: 560px; height: 380px;
    title: "Confirm Download";
    background: Palette.bg;
    
    in-out property <string> url: "";
    in-out property <string> file-name: "";
    in-out property <string> output-dir: "";
    in property <string> resolved-file-name: "download.bin";
    in property <string> resolved-output-dir: "";
    in property <string> category-hint: "General";
    in property <string> dialog-hint: "Paste a direct HTTP or HTTPS link.";
    in property <bool> url-valid: true;
    in property <[string]> queue-options: ["Main"];
    in-out property <int> queue-index: 0;
    in-out property <string> category: "General";
    private property <bool> can-submit: root.url != "";

    callback download_later(string, string, string, int, string);
    callback start_now(string, string, string, int, string);
    callback choose-folder();
    callback cancel();
    callback preview_update(string, string, string, string);

    VerticalLayout {
        padding: 0; spacing: 0;
        
        // Header
        Rectangle {
            height: 48px; background: Palette.panel;
            HorizontalLayout {
                padding-left: 20px; padding-right: 20px;
                alignment: center;
                Text { text: "Confirm Download"; font-size: 14px; font-weight: 700; color: Palette.text-primary; }
                Rectangle { width: 100%; }
            }
            Rectangle { y: parent.height - 1px; width: 100%; height: 1px; background: Palette.border; }
        }

        // Content
        VerticalLayout {
            padding: 20px; spacing: 14px;

            Rectangle {
                height: 64px;
                background: Palette.panel;
                border-color: root.url-valid ? Palette.border : Palette.error;
                border-width: 1px;
                VerticalLayout {
                    padding-left: 12px; padding-right: 12px; padding-top: 8px; padding-bottom: 8px;
                    spacing: 4px;
                    Text { text: root.dialog-hint; font-size: 11px; font-weight: 600; color: root.url-valid ? Palette.text-primary : Palette.error; overflow: elide; }
                    Text { text: "Resolved file: " + root.resolved-file-name; font-size: 10px; color: Palette.text-muted; overflow: elide; }
                    Text { text: "Save to: " + root.resolved-output-dir + "  •  Category: " + root.category-hint; font-size: 10px; color: Palette.text-muted; overflow: elide; }
                }
            }
            
            // URL Input
            VerticalLayout {
                spacing: 6px;
                Text { text: "Download URL"; font-size: 11px; font-weight: 600; color: Palette.text-light; letter-spacing: 0.3px; }
                StandardInput { 
                    width: 100%; 
                    text: root.url; 
                    placeholder: "https://example.com/file.zip"; 
                    edited(t) => { root.url = t; root.preview_update(root.url, root.file-name, root.output-dir, root.category); } 
                }
            }

            // Category
            VerticalLayout {
                spacing: 6px;
                Text { text: "Category"; font-size: 11px; font-weight: 600; color: Palette.text-light; letter-spacing: 0.3px; }
                StandardInput {
                    width: 100%;
                    text: root.category;
                    placeholder: "General";
                    edited(t) => { root.category = t; root.preview_update(root.url, root.file-name, root.output-dir, root.category); }
                }
            }

            // Queue Selection
            VerticalLayout {
                spacing: 6px;
                Text { text: "Queue"; font-size: 11px; font-weight: 600; color: Palette.text-light; letter-spacing: 0.3px; }
                HorizontalLayout {
                    spacing: 8px;
                    ToolbarButton {
                        text: "-";
                        min-width: 38px;
                        height: 32px;
                        icon-type: "minus";
                        enabled: root.queue-index > 0;
                        clicked => { root.queue-index -= 1; }
                    }
                    Rectangle {
                        height: 32px;
                        width: 100%;
                        background: Palette.panel;
                        border-color: Palette.border;
                        border-width: 1px;
                        Text {
                            text: root.queue-index >= 0 && root.queue-index < root.queue-options.length ? root.queue-options[root.queue-index] : "Main";
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            font-size: 11px;
                            font-weight: 600;
                            color: Palette.text-primary;
                        }
                    }
                    ToolbarButton {
                        text: "+";
                        min-width: 38px;
                        height: 32px;
                        icon-type: "plus";
                        enabled: root.queue-index + 1 < root.queue-options.length;
                        clicked => { root.queue-index += 1; }
                    }
                }
            }
            
            // File Name
            VerticalLayout {
                spacing: 6px;
                Text { text: "File Name"; font-size: 11px; font-weight: 600; color: Palette.text-light; letter-spacing: 0.3px; }
                StandardInput { 
                    width: 100%; 
                    text: root.file-name; 
                    placeholder: "Auto-detected"; 
                    edited(t) => { root.file-name = t; root.preview_update(root.url, root.file-name, root.output-dir, root.category); } 
                }
            }
            
            // Save Location
            VerticalLayout {
                spacing: 6px;
                Text { text: "Save To"; font-size: 11px; font-weight: 600; color: Palette.text-light; letter-spacing: 0.3px; }
                HorizontalLayout {
                    spacing: 8px;
                    StandardInput { 
                        width: 100%; 
                        text: root.output-dir; 
                        placeholder: "Default Downloads folder"; 
                        edited(t) => { root.output-dir = t; root.preview_update(root.url, root.file-name, root.output-dir, root.category); } 
                    }
                    ToolbarButton { text: "..."; min-width: 38px; height: 32px; icon-type: "open"; clicked => { root.choose-folder(); } }
                }
            }
            
            Rectangle { height: 100%; }
        }

        // Footer with Buttons
        Rectangle {
            height: 52px; background: Palette.panel;
            HorizontalLayout {
                padding-left: 20px; padding-right: 20px; padding-top: 12px; padding-bottom: 12px;
                spacing: 8px;
                alignment: end;
                Rectangle { width: 100%; }
                ToolbarButton { text: "Download Now"; height: 36px; enabled: root.can-submit; clicked => { root.start_now(root.url, root.file-name, root.output-dir, root.queue-index, root.category); } }
                ToolbarButton { text: "Queue Later"; height: 36px; enabled: root.can-submit; clicked => { root.download_later(root.url, root.file-name, root.output-dir, root.queue-index, root.category); } }
                ToolbarButton { text: "Cancel"; height: 36px; clicked => { root.cancel(); } }
            }
            Rectangle { y: 0; width: 100%; height: 1px; background: Palette.border; }
        }
    }

}

export component ClipboardDialog inherits Window {
    width: 560px; height: 340px;
    title: "Download Detected";
    background: Palette.bg;

    in-out property <string> url: "";
    in-out property <string> file-name: "";
    in-out property <string> output-dir: "";
    in property <string> resolved-file-name: "download.bin";
    in property <string> resolved-output-dir: "";
    in property <string> category-hint: "General";
    in property <string> dialog-hint: "Review detected download details before continuing.";
    in property <bool> url-valid: true;
    in property <[string]> queue-options: ["Main"];
    in-out property <int> queue-index: 0;
    in-out property <string> category: "General";

    callback choose-folder();
    callback queue_later(string, string, int, string);
    callback start_now(string, string, int, string);
    callback dismiss();

    VerticalLayout {
        padding: 0; spacing: 0;
        
        // Header
        Rectangle {
            height: 56px; background: Palette.panel;
            HorizontalLayout {
                padding-left: 20px; padding-right: 20px;
                alignment: center;
                VerticalLayout {
                    alignment: center;
                    Text { text: "📋 Clipboard URL Detected"; font-size: 14px; font-weight: 700; color: Palette.accent-primary; }
                    Text { text: "A download link was found in your clipboard"; font-size: 10px; color: Palette.text-muted; }
                }
                Rectangle { width: 100%; }
            }
            Rectangle { y: parent.height - 1px; width: 100%; height: 1px; background: Palette.border; }
        }

        // Content
        ScrollView {
            VerticalLayout {
                padding: 20px; spacing: 14px;

                Rectangle {
                    height: 64px;
                    background: Palette.panel;
                    border-color: root.url-valid ? Palette.border : Palette.error;
                    border-width: 1px;
                    VerticalLayout {
                        padding-left: 12px; padding-right: 12px; padding-top: 8px; padding-bottom: 8px;
                        spacing: 4px;
                        Text { text: root.dialog-hint; font-size: 11px; font-weight: 600; color: root.url-valid ? Palette.text-primary : Palette.error; overflow: elide; }
                        Text { text: "Resolved file: " + root.resolved-file-name; font-size: 10px; color: Palette.text-muted; overflow: elide; }
                        Text { text: "Save to: " + root.resolved-output-dir + "  •  Category: " + root.category-hint; font-size: 10px; color: Palette.text-muted; overflow: elide; }
                    }
                }
                
                // URL Display
                VerticalLayout {
                    spacing: 6px;
                    Text { text: "URL"; font-size: 11px; font-weight: 600; color: Palette.text-light; letter-spacing: 0.3px; }
                    Rectangle {
                        height: 32px; background: Palette.panel;
                        border-color: Palette.border;
                        border-width: 1px;
                        HorizontalLayout {
                            padding: 8px;
                            Text { 
                                text: root.url; 
                                font-size: 10px; 
                                color: Palette.accent-primary; 
                                overflow: elide; 
                                font-family: "Consolas";
                            }
                        }
                    }
                }
                
                // File Name
                VerticalLayout {
                    spacing: 6px;
                    Text { text: "File Name"; font-size: 11px; font-weight: 600; color: Palette.text-light; letter-spacing: 0.3px; }
                    StandardInput { 
                        width: 100%; 
                        text: root.file-name; 
                        placeholder: "Auto-detected from URL";
                        edited(t) => { root.file-name = t; }
                    }
                }
                
                // Category
                VerticalLayout {
                    spacing: 6px;
                    Text { text: "Category"; font-size: 11px; font-weight: 600; color: Palette.text-light; letter-spacing: 0.3px; }
                    StandardInput {
                        width: 100%;
                        text: root.category;
                        placeholder: "General";
                        edited(t) => { root.category = t; }
                    }
                }

                // Queue Selection
                VerticalLayout {
                    spacing: 6px;
                    Text { text: "Queue"; font-size: 11px; font-weight: 600; color: Palette.text-light; letter-spacing: 0.3px; }
                    HorizontalLayout {
                        spacing: 8px;
                        ToolbarButton {
                            text: "-";
                            min-width: 38px;
                            height: 32px;
                            icon-type: "minus";
                            enabled: root.queue-index > 0;
                            clicked => { root.queue-index -= 1; }
                        }
                        Rectangle {
                            height: 32px;
                            width: 100%;
                            background: Palette.panel;
                            border-color: Palette.border;
                            border-width: 1px;
                            Text {
                                text: root.queue-index >= 0 && root.queue-index < root.queue-options.length ? root.queue-options[root.queue-index] : "Main";
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                font-size: 11px;
                                font-weight: 600;
                                color: Palette.text-primary;
                            }
                        }
                        ToolbarButton {
                            text: "+";
                            min-width: 38px;
                            height: 32px;
                            icon-type: "plus";
                            enabled: root.queue-index + 1 < root.queue-options.length;
                            clicked => { root.queue-index += 1; }
                        }
                    }
                }
                
                // Save Location
                VerticalLayout {
                    spacing: 6px;
                    Text { text: "Save To"; font-size: 11px; font-weight: 600; color: Palette.text-light; letter-spacing: 0.3px; }
                    HorizontalLayout {
                        spacing: 8px;
                        StandardInput { 
                            width: 100%; 
                            text: root.output-dir; 
                            placeholder: "Default Downloads folder";
                            edited(t) => { root.output-dir = t; }
                        }
                        ToolbarButton { text: "..."; min-width: 38px; height: 32px; icon-type: "open"; clicked => { root.choose-folder(); } }
                    }
                }
                
                Rectangle { height: 100%; }
            }
        }

        // Footer with Buttons
        Rectangle {
            height: 60px; background: Palette.panel;
            VerticalLayout {
                padding-left: 20px; padding-right: 20px; padding-top: 12px; padding-bottom: 12px;
                spacing: 8px;
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    ToolbarButton { text: "Download Now"; height: 36px; clicked => { root.start_now(root.file-name, root.output-dir, root.queue-index, root.category); } }
                    ToolbarButton { text: "Queue Later"; height: 36px; clicked => { root.queue_later(root.file-name, root.output-dir, root.queue-index, root.category); } }
                    ToolbarButton { text: "Dismiss"; height: 36px; clicked => { root.dismiss(); } }
                }
            }
            Rectangle { y: 0; width: 100%; height: 1px; background: Palette.border; }
        }
    }
}

export component RenameQueueDialog inherits Window {
    width: 420px; height: 196px;
    title: "Rename Queue";
