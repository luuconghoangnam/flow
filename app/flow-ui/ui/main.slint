import { LineEdit, ScrollView } from "std-widgets.slint";

global Palette {
    out property <color> bg: #0A0A0A;
    out property <color> surface: #151515;
    out property <color> panel: #1E1E1E;
    out property <color> border: #3A3A3A;
    out property <color> text-primary: #E5E7EB;
    out property <color> text-muted: #7A808A;
    out property <color> accent-primary: #E64A00;
    out property <string> font-heading: "Orbitron";
    out property <string> font-body: "JetBrains Mono";
}

component CyberButton inherits Rectangle {
    in property <string> text;
    in property <bool> active: false;
    callback clicked <=> ta.clicked;
    height: 34px;
    min-width: 96px;
    background: ta.pressed ? Palette.accent-primary : (active ? #2A2A2A : Palette.panel);
    border-color: active ? Palette.accent-primary : Palette.border;
    border-width: 1px;
    Text { text: root.text; color: Palette.text-primary; font-size: 12px; font-family: Palette.font-body; horizontal-alignment: center; vertical-alignment: center; width: parent.width; height: parent.height; }
    ta := TouchArea { width: 100%; height: 100%; }
}

component TreeItem inherits Rectangle {
    in property <string> text;
    in property <bool> active: false;
    callback clicked <=> ta.clicked;
    height: 28px;
    background: active ? #252525 : transparent;
    if active: Rectangle { x: 0; y: 0; width: 2px; height: parent.height; background: Palette.accent-primary; }
    Text { text: root.text; x: 10px; color: active ? Palette.text-primary : Palette.text-muted; vertical-alignment: center; font-size: 12px; }
    ta := TouchArea { width: 100%; height: 100%; }
}

component CyberInput inherits Rectangle {
    in property <string> text;
    in property <string> placeholder;
    callback edited(string);
    height: 32px;
    background: Palette.panel;
    border-color: Palette.border;
    border-width: 1px;
    editor := LineEdit { x: 8px; width: parent.width - 16px; text: root.text; placeholder-text: root.placeholder; edited(t) => { root.edited(t); } }
}

export component MainWindow inherits Window {
    width: 1220px;
    height: 760px;
    title: "Flow Download Manager";
    background: Palette.bg;
    default-font-family: Palette.font-body;

    in property <string> hero-title: "Fast native downloads, clean control.";
    in property <[string]> download-items: ["No downloads yet"];
    in property <[string]> queue-groups: ["Main"];
    in property <int> selected-queue-index: 0;
    in property <string> queue-config-summary: "Queue config";
    in property <string> queue-name-text: "Main";
    in property <string> appearance-summary: "Appearance";
    in property <string> engine-summary: "Download Engine";
    in property <string> browser-summary: "Browser Integration";
    in property <string> browser-extension-id-text: "";
    in property <string> queue-event-summary: "Queue events";
    in property <string> proxy-host-text: "127.0.0.1";
    in property <string> proxy-port-text: "2080";
    in property <string> proxy-username-text: "";
    in property <string> proxy-password-text: "";
    in property <string> default-folder-text: "";
    in property <string> perhost-first-text: "";
    in property <string> perhost-thread-text: "";
    in property <string> perhost-user-text: "";
    in property <string> perhost-pass-text: "";
    in property <string> global-speed-limit-text: "";
    in property <string> proxy-pac-text: "";
    in property <int> selected-download-index: -1;

    callback retry-failed(); callback cleanup-finished(); callback select-queue(index: int); callback create-queue();
    callback toggle-queue(); callback delete-queue(); callback select-download(index: int); callback move-download-up();
    callback move-download-down(); callback requeue-download(); callback queue-max-minus(); callback queue-max-plus();
    callback queue-toggle-stop-on-empty(); callback queue-name-changed(value: string); callback toggle-auto-start();
    callback toggle-system-tray(); callback toggle-browser-integration(); callback toggle-clipboard-monitoring();
    callback settings-thread-minus(); callback settings-thread-plus(); callback settings-max-minus(); callback settings-max-plus();
    callback settings-use-downloads-folder(); callback toggle-proxy-mode(); callback proxy-port-minus(); callback proxy-port-plus();
    callback proxy-set-localhost(); callback proxy-set-auth-sample(); callback proxy-clear-auth(); callback perhost-add-sample();
    callback perhost-remove-last(); callback perhost-clear(); callback proxy-host-changed(value: string);
    callback proxy-username-changed(value: string); callback proxy-password-changed(value: string); callback proxy-port-changed(value: string);
    callback perhost-first-changed(value: string); callback perhost-thread-changed(value: string); callback perhost-user-changed(value: string);
    callback perhost-pass-changed(value: string); callback default-folder-changed(value: string); callback global-speed-limit-changed(value: string);
    callback proxy-pac-changed(value: string); callback browser-extension-id-changed(value: string); callback register-browser-host();

    property <int> current-tab: 0; // 0 downloads, 1 scheduler, 2 settings

    VerticalLayout {
        spacing: 0;

        Rectangle { // menu bar
            height: 30px; background: #121212;
            HorizontalLayout { padding-left: 10px; spacing: 18px;
                Text { text: "Tasks"; color: Palette.text-primary; font-size: 12px; }
                Text { text: "File"; color: Palette.text-primary; font-size: 12px; }
                Text { text: "Downloads"; color: Palette.text-primary; font-size: 12px; }
                Text { text: "View"; color: Palette.text-primary; font-size: 12px; }
                Text { text: "Help"; color: Palette.text-primary; font-size: 12px; }
            }
        }

        Rectangle { // command bar
            height: 58px; background: Palette.surface;
            Rectangle { x: 0; y: parent.height - 1px; width: 100%; height: 1px; background: Palette.border; }
            HorizontalLayout { padding-left: 10px; padding-right: 10px; spacing: 8px;
                CyberButton { text: "Add URL"; clicked => { current-tab = 0; } }
                CyberButton { text: "Resume"; clicked => { root.toggle-queue(); current-tab = 0; } }
                CyberButton { text: "Stop"; clicked => { root.toggle-queue(); current-tab = 0; } }
                CyberButton { text: "Stop All"; clicked => { root.toggle-queue(); current-tab = 0; } }
                CyberButton { text: "Delete"; clicked => { root.delete-queue(); current-tab = 0; } }
                CyberButton { text: "Retry"; clicked => { root.retry-failed(); current-tab = 0; } }
                CyberButton { text: "Scheduler"; active: current-tab == 1; clicked => { current-tab = 1; } }
                CyberButton { text: "Settings"; active: current-tab == 2; clicked => { current-tab = 2; } }
                Rectangle { width: 100%; }
                Text { text: root.queue-event-summary; color: Palette.text-muted; font-size: 11px; vertical-alignment: center; }
            }
        }

        if current-tab == 0: HorizontalLayout { // IDM main workspace
            Rectangle {
                width: 220px; background: #111111; border-color: Palette.border; border-width: 1px;
                VerticalLayout { padding: 8px; spacing: 4px;
                    Text { text: "Categories"; color: Palette.text-primary; font-size: 12px; }
                    TreeItem { text: "All Downloads"; active: true; }
                    TreeItem { text: "Unfinished"; }
                    TreeItem { text: "Finished"; }
                    TreeItem { text: "Queues"; }
                    Rectangle { height: 8px; }
                    Text { text: "Queue Groups"; color: Palette.text-primary; font-size: 12px; }
                    for q[i] in root.queue-groups: TreeItem { text: q; active: i == root.selected-queue-index; clicked => { root.select-queue(i); } }
                    CyberButton { text: "+ New Queue"; clicked => { root.create-queue(); } }
                }
            }
            Rectangle {
                background: Palette.bg;
                VerticalLayout {
                    Rectangle { height: 30px; background: Palette.surface; border-color: Palette.border; border-width: 1px;
                        HorizontalLayout { padding-left: 8px; spacing: 14px;
                            Text { text: "File Name"; color: Palette.text-primary; font-size: 11px; }
                            Text { text: "Size"; color: Palette.text-muted; font-size: 11px; }
                            Text { text: "Status"; color: Palette.text-muted; font-size: 11px; }
                            Text { text: "Time left"; color: Palette.text-muted; font-size: 11px; }
                            Text { text: "Transfer rate"; color: Palette.text-muted; font-size: 11px; }
                        }
                    }
                    ScrollView {
                        VerticalLayout { padding: 8px; spacing: 6px;
                            for item[i] in root.download-items: Rectangle {
                                height: 44px; background: i == root.selected-download-index ? #242424 : Palette.panel; border-width: 1px; border-color: Palette.border;
                                TouchArea { clicked => { root.select-download(i); } }
                                Text { text: item; x: 10px; y: 12px; color: Palette.text-primary; font-size: 12px; }
                            }
                        }
                    }
                    Rectangle { height: 42px; background: #111111; border-color: Palette.border; border-width: 1px;
                        HorizontalLayout { padding-left: 8px; spacing: 8px;
                            CyberButton { text: "Up"; clicked => { root.move-download-up(); } }
                            CyberButton { text: "Down"; clicked => { root.move-download-down(); } }
                            CyberButton { text: "Requeue"; clicked => { root.requeue-download(); } }
                            CyberButton { text: "Cleanup"; clicked => { root.cleanup-finished(); } }
                        }
                    }
                }
            }
        }

        if current-tab == 1: Rectangle {
            background: Palette.bg;
            VerticalLayout { padding: 16px; spacing: 10px;
                Text { text: "Scheduler"; color: Palette.accent-primary; font-family: Palette.font-heading; font-size: 20px; }
                Text { text: root.queue-config-summary; color: Palette.text-primary; font-size: 12px; }
                CyberButton { text: "Start / Stop Queue"; clicked => { root.toggle-queue(); } }
            }
        }

        if current-tab == 2: ScrollView {
            VerticalLayout { padding: 16px; spacing: 12px;
                Text { text: "Settings"; color: Palette.accent-primary; font-family: Palette.font-heading; font-size: 20px; }
                HorizontalLayout { spacing: 8px;
                    CyberButton { text: "Auto Start"; clicked => { root.toggle-auto-start(); } }
                    CyberButton { text: "System Tray"; clicked => { root.toggle-system-tray(); } }
                    CyberButton { text: "Clipboard"; clicked => { root.toggle-clipboard-monitoring(); } }
                }
                Text { text: root.appearance-summary; color: Palette.text-muted; font-size: 12px; }
                HorizontalLayout { spacing: 8px;
                    CyberButton { text: "Thr -"; clicked => { root.settings-thread-minus(); } }
                    CyberButton { text: "Thr +"; clicked => { root.settings-thread-plus(); } }
                    CyberButton { text: "Jobs -"; clicked => { root.settings-max-minus(); } }
                    CyberButton { text: "Jobs +"; clicked => { root.settings-max-plus(); } }
                }
                HorizontalLayout { spacing: 8px; Text { text: "Folder"; width: 80px; color: Palette.text-muted; }
                    CyberInput { width: 420px; text: default-folder-text; edited(t) => { root.default-folder-changed(t); } }
                    CyberButton { text: "Use Downloads"; clicked => { root.settings-use-downloads-folder(); } }
                }
                HorizontalLayout { spacing: 8px;
                    CyberButton { text: "Toggle Browser"; clicked => { root.toggle-browser-integration(); } }
                    CyberButton { text: "Register Host"; clicked => { root.register-browser-host(); } }
                }
            }
        }
    }
}

export component ClipboardDialog inherits Window {
    width: 640px;
    height: 290px;
    title: "Download File Info";
    always-on-top: true;
    background: #2f2f2f;

    in property <string> url: "";
    in property <string> file-name: "";
    in property <string> output-dir: "";

    callback queue_later();
    callback start_now();
    callback dismiss();

    Rectangle {
        border-color: #5A5A5A;
        border-width: 1px;
        background: #353535;

        VerticalLayout {
            padding: 14px;
            spacing: 8px;

            HorizontalLayout {
                spacing: 8px;
                Text { text: "URL"; color: #F2F2F2; width: 68px; vertical-alignment: center; horizontal-alignment: right; font-size: 13px; }
                Rectangle { background: #2A2A2A; border-color: #8C8C8C; border-width: 1px; height: 28px;
                    Text { text: root.url; color: #F4F4F4; x: 8px; y: 6px; font-size: 12px; overflow: elide; }
                }
            }

            HorizontalLayout {
                spacing: 8px;
                Text { text: "Category"; color: #F2F2F2; width: 68px; vertical-alignment: center; horizontal-alignment: right; font-size: 13px; }
                Rectangle { width: 180px; height: 28px; background: #2A2A2A; border-color: #8C8C8C; border-width: 1px;
                    Text { text: "Compressed"; color: #EDEDED; x: 8px; y: 6px; font-size: 12px; }
                }
                CyberButton { text: "+"; min-width: 28px; }
            }

            HorizontalLayout {
                spacing: 8px;
                Text { text: "Save As"; color: #F2F2F2; width: 68px; vertical-alignment: center; horizontal-alignment: right; font-size: 13px; }
                Rectangle { background: #2A2A2A; border-color: #8C8C8C; border-width: 1px; height: 28px;
                    Text { text: root.output-dir + "/" + root.file-name; color: #F4F4F4; x: 8px; y: 6px; font-size: 12px; overflow: elide; }
                }
                CyberButton { text: "..."; min-width: 34px; }
            }

            HorizontalLayout {
                spacing: 8px;
                Text { text: ""; width: 68px; }
                Rectangle {
                    height: 28px;
                    background: #2A2A2A;
                    border-color: #8C8C8C;
                    border-width: 1px;
                    Text { text: "Remember this path for this category"; color: #D8D8D8; x: 8px; y: 6px; font-size: 12px; }
                }
            }

            HorizontalLayout {
                spacing: 8px;
                Text { text: "Description"; color: #F2F2F2; width: 68px; vertical-alignment: center; horizontal-alignment: right; font-size: 13px; }
                Rectangle { background: #2A2A2A; border-color: #8C8C8C; border-width: 1px; height: 28px; }
            }

            Rectangle { height: 10px; background: transparent; }

            HorizontalLayout {
                spacing: 12px;
                alignment: center;
                CyberButton { text: "Download Later"; min-width: 140px; clicked => { root.queue_later(); } }
                CyberButton { text: "Start Download"; min-width: 140px; active: true; clicked => { root.start_now(); } }
                CyberButton { text: "Cancel"; min-width: 110px; clicked => { root.dismiss(); } }
            }
        }
    }
}
