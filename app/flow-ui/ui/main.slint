import { LineEdit, ScrollView } from "std-widgets.slint";

export struct DownloadRow {
    checked: bool,
    name: string,
    category: string,
    size: string,
    status: string,
    speed: string,
    time-left: string,
    date-added: string,
    description: string,
    progress: int,
    has-progress: bool,
    is-error: bool,
}

export struct DownloadsMenuRow {
    title: string,
    enabled: bool,
    command_id: string,
    target_index: int,
    row_kind: string,
    icon: string,
    shortcut: string,
}

export struct FileChecksumRow {
    file_name: string,
    expected: string,
    actual: string,
    result: string,
}

global Palette {
    // Premium Cyber-Industrial palette: Deep layers, vibrant accents, refined contrast.
    out property <color> bg: #080808;
    out property <color> surface: #111111;
    out property <color> surface-card: #16161A;
    out property <color> panel: #1A1A1A;
    out property <color> panel-raised: #222222;
    out property <color> border: #2A2A2A;
    out property <color> border-bright: #3A3A3A;
    
    out property <color> text-primary: #F3F4F6;
    out property <color> text-secondary: #D1D5DB;
    out property <color> text-muted: #6B7280;
    out property <color> text-dim: #4B5563;
    
    out property <color> accent-primary: #E64A00;
    out property <color> accent-secondary: #FF6B35;
    out property <color> accent-glow: #E64A0033;
    out property <color> accent-hover: #22140E;
    out property <color> accent-active: #2D1B12;
    
    out property <color> success: #10B981;
    out property <color> success-bg: #10B9811A;
    out property <color> warning: #F59E0B;
    out property <color> warning-bg: #F59E0B1A;
    out property <color> error: #EF4444;
    out property <color> error-bg: #EF44441A;
    
    out property <color> selection-bg: #1E120D;
    out property <color> selection-border: #FF6B35;
    out property <color> row-odd: #0A0A0A;
    out property <color> row-even: #0F0F0F;
    out property <color> row-hover: #161616;

    out property <brush> accent-gradient: @linear-gradient(135deg, #E64A00 0%, #FF6B35 100%);
}

// Custom Font Family aliases for consistency
global Fonts {
    out property <string> main: "Inter";
    out property <string> mono: "JetBrains Mono";
}

component IconAdd inherits Rectangle {
    width: 24px; height: 24px;
    Rectangle { width: 12px; height: 2px; y: 11px; x: 6px; background: #E64A00; }
    Rectangle { width: 2px; height: 12px; x: 11px; y: 6px; background: #E64A00; }
}

component IconResume inherits Rectangle {
    width: 24px; height: 24px;
    Path {
        viewbox-width: 100; viewbox-height: 100;
        commands: "M 30,20 L 80,50 L 30,80 Z";
        fill: #22C55E;
    }
}

component IconStop inherits Rectangle {
    width: 24px; height: 24px;
    Rectangle { width: 10px; height: 10px; x: 7px; y: 7px; background: #EF4444; }
}

component IconStopAll inherits Rectangle {
    width: 24px; height: 24px;
    Rectangle { x: 3px; width: 8px; height: 10px; background: #EF4444; }
    Rectangle { x: 13px; width: 8px; height: 10px; background: #EF4444; }
}

component IconDelete inherits Rectangle {
    width: 24px; height: 24px;
    Path {
        viewbox-width: 100; viewbox-height: 100;
        commands: "M 20,20 L 80,80 M 80,20 L 20,80";
        stroke: #EF4444;
        stroke-width: 6px;
    }
}

component IconCleanup inherits Rectangle {
    width: 24px; height: 24px;
    Rectangle { width: 12px; height: 3px; background: #6B7280; y: 17px; x: 6px; }
    Rectangle { width: 8px; height: 8px; background: #3A3A3A; y: 8px; x: 8px; }
}

component IconOptions inherits Rectangle {
    width: 24px; height: 24px;
    Rectangle { width: 3px; height: 3px; background: #E64A00; x: 2px; y: 10px; }
    Rectangle { width: 3px; height: 3px; background: #E64A00; x: 10px; y: 10px; }
    Rectangle { width: 3px; height: 3px; background: #E64A00; x: 18px; y: 10px; }
}

component IconScheduler inherits Rectangle {
    width: 24px; height: 24px;
    Rectangle { width: 14px; height: 14px; border-width: 2px; border-color: #E64A00; x: 5px; y: 5px; }
    Rectangle { width: 1px; height: 4px; background: #E64A00; y: 7px; x: 11px; }
    Rectangle { width: 3px; height: 1px; background: #E64A00; x: 13px; y: 12px; }
}

component IconOpen inherits Rectangle {
    width: 24px; height: 24px;
    Path {
        viewbox-width: 100; viewbox-height: 100;
        commands: "M 30,20 L 30,70 L 80,70 L 80,35 L 65,20 Z M 65,20 L 65,35 L 80,35";
        stroke: #E64A00;
        stroke-width: 3px;
    }
}

component IconFolder inherits Rectangle {
    width: 24px; height: 24px;
    Path {
        viewbox-width: 100; viewbox-height: 100;
        commands: "M 10,30 L 10,80 L 90,80 L 90,35 L 40,35 L 30,20 L 10,20 Z";
        stroke: #E64A00;
        stroke-width: 3px;
    }
}

component IconUp inherits Rectangle {
    width: 24px; height: 24px;
    Path {
        viewbox-width: 100; viewbox-height: 100;
        commands: "M 50,20 L 30,50 L 40,50 L 40,80 L 60,80 L 60,50 L 70,50 Z";
        fill: #6B7280;
    }
}

component IconDown inherits Rectangle {
    width: 24px; height: 24px;
    Path {
        viewbox-width: 100; viewbox-height: 100;
        commands: "M 50,80 L 30,50 L 40,50 L 40,20 L 60,20 L 60,50 L 70,50 Z";
        fill: #6B7280;
    }
}

component IconRetry inherits Rectangle {
    width: 24px; height: 24px;
    Path {
        viewbox-width: 100; viewbox-height: 100;
        commands: "M 70,30 L 80,30 L 75,15 L 65,25 L 70,25 A 30,30 0 1 0 30,60";
        stroke: #22C55E;
        stroke-width: 3px;
    }
}

component IconPlus inherits Rectangle {
    width: 24px; height: 24px;
    Rectangle { width: 12px; height: 2px; y: 11px; x: 6px; background: #E64A00; }
    Rectangle { width: 2px; height: 12px; x: 11px; y: 6px; background: #E64A00; }
}

component IconMinus inherits Rectangle {
    width: 24px; height: 24px;
    Rectangle { width: 12px; height: 2px; y: 11px; x: 6px; background: #EF4444; }
}

component ToolbarButton inherits Rectangle {
    in property <string> text;
    in property <bool> active: false;
    in property <bool> enabled: true;
    in property <string> icon-type;
    callback clicked;

    height: 64px;
    min-width: root.height <= 40px ? 48px : 82px;
    opacity: !enabled ? 0.35 : 1.0;
    clip: true;
    
    private property <bool> compact: root.height <= 42px;
    private property <bool> has-icon: root.icon-type != "";
    
    background: !enabled ? transparent : (active ? Palette.accent-active : (ta.pressed ? Palette.accent-active : (ta.has-hover ? Palette.accent-hover : transparent)));
    border-radius: 0px;
    
    // Bottom indicator for active state
    if active: Rectangle {
        y: parent.height - 2px;
        height: 2px;
        width: 100%;
        background: Palette.accent-gradient;
    }

    // 45-degree chamfer corner (Top-Left)
    if root.enabled && (ta.has-hover || active): Path {
        viewbox-width: 10;
        viewbox-height: 10;
        width: 10px;
        height: 10px;
        x: 0; y: 0;
        commands: "M 0,0 L 10,0 L 0,10 Z";
        fill: Palette.accent-primary;
    }

    content := HorizontalLayout {
        padding-left: 8px; padding-right: 8px;
        spacing: 6px;
        alignment: center;
        
        if !compact: VerticalLayout {
            spacing: 4px;
            alignment: center;
            if root.has-icon: Rectangle {
                width: 24px; height: 24px;
                if icon-type == "add": IconAdd {}
                if icon-type == "resume": IconResume {}
                if icon-type == "stop": IconStop {}
                if icon-type == "stop-all": IconStopAll {}
                if icon-type == "delete": IconDelete {}
                if icon-type == "cleanup": IconCleanup {}
                if icon-type == "options": IconOptions {}
                if icon-type == "scheduler": IconScheduler {}
                if icon-type == "open": IconOpen {}
                if icon-type == "folder": IconFolder {}
                if icon-type == "up": IconUp {}
                if icon-type == "down": IconDown {}
                if icon-type == "retry": IconRetry {}
                if icon-type == "plus": IconPlus {}
                if icon-type == "minus": IconMinus {}
            }
            if text != "": Text {
                text: root.text;
                color: active ? Palette.accent-secondary : (ta.has-hover ? Palette.text-primary : Palette.text-secondary);
                font-size: 10px;
                font-weight: active ? 800 : 700;
                font-family: Fonts.main;
                letter-spacing: 0.5px;
                horizontal-alignment: center;
                overflow: elide;
            }
        }
        
        if compact: HorizontalLayout {
            spacing: 8px;
            alignment: center;
            if root.has-icon: Rectangle {
                width: 18px; height: 18px;
                if icon-type == "add": IconAdd {}
                if icon-type == "resume": IconResume {}
                if icon-type == "stop": IconStop {}
                if icon-type == "stop-all": IconStopAll {}
                if icon-type == "delete": IconDelete {}
                if icon-type == "cleanup": IconCleanup {}
                if icon-type == "options": IconOptions {}
                if icon-type == "scheduler": IconScheduler {}
                if icon-type == "open": IconOpen {}
                if icon-type == "folder": IconFolder {}
                if icon-type == "up": IconUp {}
                if icon-type == "down": IconDown {}
                if icon-type == "retry": IconRetry {}
                if icon-type == "plus": IconPlus {}
                if icon-type == "minus": IconMinus {}
            }
            if text != "" && text != "+" && text != "-" && text != "...": Text {
                text: root.text;
                color: active ? Palette.accent-secondary : (ta.has-hover ? Palette.text-primary : Palette.text-secondary);
                font-size: 10px;
                font-weight: 700;
                font-family: Fonts.main;
                vertical-alignment: center;
            }
            if text == "+" || text == "-" || text == "...": Text {
                text: root.text;
                color: Palette.text-primary;
                font-size: 14px;
                font-weight: 800;
                font-family: Fonts.mono;
                vertical-alignment: center;
            }
        }
    }
    
    ta := TouchArea {
        clicked => { if root.enabled { root.clicked(); } }
    }
}

component MenuItem inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked;
    callback hover;
    height: 22px;
    background: ta.pressed ? Palette.accent-active : (ta.has-hover ? Palette.accent-hover : transparent);
    border-width: ta.has-hover ? 1px : 0px;
    border-color: ta.has-hover ? Palette.border : transparent;
    
    if ta.has-hover: Rectangle { x: 0px; y: 0px; width: 2px; height: 100%; background: Palette.accent-primary; }

    HorizontalLayout {
        padding-left: 10px; padding-right: 8px;
        alignment: start;
        Text {
            text: root.text;
            color: root.enabled ? Palette.text-primary : Palette.text-muted;
            font-size: 10px;
            font-weight: ta.has-hover ? 700 : 500;
            letter-spacing: 0.5px;
            vertical-alignment: center;
        }
    }
    
    ta := TouchArea {
        width: 100%; height: 100%;
        clicked => { if root.enabled { root.clicked(); } }
        moved => { root.hover(); }
    }
}

component DownloadsMenuEntry inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <string> shortcut;
    in property <bool> enabled: true;
    in property <bool> submenu: false;
    callback clicked;
    callback hover;
    height: 20px;
    background: ta.pressed ? #3A2115 : (ta.has-hover ? #2A1B14 : transparent);

    function icon-source(name: string) -> image {
        name == "edit" ? @image-url("assets/menu_edit.svg") :
        (name == "refresh" ? @image-url("assets/menu_refresh.svg") :
        (name == "info" ? @image-url("assets/menu_info.svg") :
        (name == "copy" ? @image-url("assets/menu_copy.svg") :
        (name == "queue" ? @image-url("assets/menu_queue.svg") :
        (name == "category" ? @image-url("assets/menu_category.svg") :
        (name == "next" ? @image-url("assets/menu_next.svg") : @image-url("assets/menu_info.svg")))))))
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 7px;
        spacing: 6px;
        alignment: start;

        Rectangle {
            width: 16px;
            height: 18px;
            background: transparent;
            Image {
                x: 1px;
                y: 2px;
                width: 14px;
                height: 14px;
                source: icon-source(root.icon);
                image-fit: contain;
            }
        }
        Text {
            text: root.text;
            color: root.enabled ? #E5E7EB : #6B7280;
            font-size: 10px;
            font-weight: 400;
            vertical-alignment: center;
        }
        Rectangle { width: 100%; }
        Rectangle {
            width: 44px;
            height: 18px;
            background: transparent;
            if root.shortcut != "": Text {
                text: root.shortcut;
                color: root.enabled ? #9CA3AF : #4B5563;
                font-size: 8px;
                vertical-alignment: center;
                horizontal-alignment: right;
            }
        }
        Rectangle {
            width: 12px;
            height: 18px;
            background: transparent;
            if root.submenu: Image {
                x: 1px;
                y: 3px;
                width: 10px;
                height: 10px;
                source: icon-source("next");
                image-fit: contain;
            }
        }
    }

    ta := TouchArea {
        width: 100%; height: 100%;
        clicked => { if root.enabled { root.clicked(); } }
        moved => { root.hover(); }
    }
}

component DownloadsMenuPopup inherits Rectangle {
    in property <[DownloadsMenuRow]> rows;
    in property <[DownloadsMenuRow]> submenu_rows;
    in-out property <int> submenu_parent_index: -1;

    callback select-all();
    callback clear-selection();
    callback invoke(command-id: string, target-index: int);
    callback open-submenu(parent-index: int);
    callback sort-name();
    callback sort-size();
    callback sort-status();
    callback sort-date-added();

    background: #0A0A0A;
    border-color: #686A6D;
    border-width: 1px;
    border-radius: 0px;
    clip: true;

    Rectangle {
        x: 3px;
        y: 3px;
        width: parent.width;
        height: parent.height;
        background: #00000028;
        border-radius: 0px;
    }

    Rectangle {
        width: parent.width;
        height: parent.height;
        background: #121212;
        border-color: #3A3A3A;
        border-width: 1px;
        border-radius: 0px;

        Rectangle {
            width: parent.width;
            height: 1px;
            background: #2A1B14;
        }

        HorizontalLayout {
            spacing: 0px;

            Rectangle {
                width: 205px;
                background: transparent;
                VerticalLayout {
                    spacing: 0px;
                    MenuItem { text: "Select All"; clicked => { root.select-all(); } hover => { root.submenu_parent_index = -1; } }
                    MenuItem { text: "Clear Selection"; clicked => { root.clear-selection(); } hover => { root.submenu_parent_index = -1; } }
                    Rectangle { height: 1px; background: #3A3A3A; }
                    for item[index] in root.rows: Rectangle {
                        height: item.row_kind == "separator" ? 5px : 20px;
                        background: transparent;
                        if item.row_kind == "separator": Rectangle {
                            y: 2px;
                            height: 1px;
                            width: 100%;
                            background: #3A3A3A;
                        }
                        if item.row_kind != "separator": DownloadsMenuEntry {
                            width: 100%;
                            text: item.title;
                            icon: item.icon == "" ? "info" : item.icon;
                            shortcut: item.shortcut;
                            enabled: item.enabled;
                            submenu: item.row_kind == "submenu";
                            hover => {
                                if item.row_kind == "submenu" {
                                    root.submenu_parent_index = index;
                                    root.open-submenu(index);
                                } else {
                                    root.submenu_parent_index = -1;
                                }
                            }
                            clicked => {
                                if item.row_kind == "submenu" {
                                    root.submenu_parent_index = index;
                                    root.open-submenu(index);
                                } else {
                                    root.invoke(item.command_id, item.target_index);
                                }
                            }
                        }
                    }
                    Rectangle { height: 1px; background: #3A3A3A; }
                    MenuItem { text: "Sort by Name"; clicked => { root.sort-name(); } hover => { root.submenu_parent_index = -1; } }
                    MenuItem { text: "Sort by Size"; clicked => { root.sort-size(); } hover => { root.submenu_parent_index = -1; } }
                    MenuItem { text: "Sort by Status"; clicked => { root.sort-status(); } hover => { root.submenu_parent_index = -1; } }
                    MenuItem { text: "Sort by Date Added"; clicked => { root.sort-date-added(); } hover => { root.submenu_parent_index = -1; } }
                }
            }

            if root.submenu_parent_index >= 0 && root.submenu_rows.length > 0: Rectangle {
                width: 185px;
                background: #121212;
                border-color: #3A3A3A;
                border-width: 1px;
                border-radius: 0px;
                Rectangle {
                    x: 3px;
                    y: 3px;
                    width: parent.width;
                    height: parent.height;
                    background: #00000022;
                    border-radius: 0px;
                }
                VerticalLayout {
                    spacing: 0px;
                    for sub_item in root.submenu_rows: Rectangle {
                        height: sub_item.row_kind == "separator" ? 5px : 20px;
                        background: transparent;
                        if sub_item.row_kind == "separator": Rectangle {
                            y: 2px;
                            height: 1px;
                            width: 100%;
                            background: #3A3A3A;
                        }
                        if sub_item.row_kind != "separator": DownloadsMenuEntry {
                            width: 100%;
                            text: sub_item.title;
                            icon: sub_item.icon == "" ? "info" : sub_item.icon;
                            shortcut: sub_item.shortcut;
                            enabled: sub_item.enabled;
                            submenu: false;
                            hover => { }
                            clicked => {
                                root.submenu_parent_index = -1;
                                root.invoke(sub_item.command_id, sub_item.target_index);
                            }
                        }
                    }
                }
            }
        }
    }
}

component TreeItem inherits Rectangle {
    in property <string> text;
    in property <bool> active: false;
    in property <string> icon-type;
    in property <int> count: -1;
    callback clicked <=> ta.clicked;
    
    height: 32px;
    background: active ? Palette.accent-active : (ta.has-hover ? Palette.surface-card : transparent);
    
    // Smooth transition bar
    Rectangle {
        x: 0; width: 3px; height: 100%;
        background: active ? Palette.accent-gradient : transparent;
    }

    HorizontalLayout {
        padding-left: 12px; padding-right: 12px;
        spacing: 10px;
        alignment: start;
        
        Rectangle {
            width: 16px; height: 16px;
            VerticalLayout {
                alignment: center;
                if icon-type == "all": Rectangle { width: 10px; height: 10px; border-width: 1.5px; border-color: Palette.accent-primary; border-radius: 2px; }
                if icon-type == "unfinished": Rectangle { width: 10px; height: 10px; background: Palette.warning; border-radius: 2px; }
                if icon-type == "finished": Rectangle { width: 10px; height: 10px; background: Palette.success; border-radius: 2px; }
                if icon-type == "queue": Rectangle { width: 8px; height: 8px; border-width: 1px; border-color: Palette.text-muted; border-radius: 4px; }
            }
        }
        
        Text {
            text: root.text;
            color: active ? Palette.text-primary : (ta.has-hover ? Palette.text-primary : Palette.text-secondary);
            vertical-alignment: center;
            font-size: 11px;
            font-family: Fonts.main;
            font-weight: active ? 700 : 500;
        }
        
        if count >= 0: Rectangle {
            width: 100%;
            HorizontalLayout {
                alignment: end;
                Rectangle {
                    height: 16px;
                    min-width: 16px;
                    background: active ? Palette.accent-primary : Palette.panel;
                    border-radius: 8px;
                    HorizontalLayout {
                        padding-left: 5px;
                        padding-right: 5px;
                        Text {
                            text: root.count;
                            font-size: 9px;
                            font-weight: 800;
                            color: active ? Palette.bg : Palette.text-muted;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }
                    }
                }
            }
        }
    }
    ta := TouchArea { width: 100%; height: 100%; }
}

component ProgressBar inherits Rectangle {
    in property <float> progress: 0.0; // 0.0 to 1.0
    in property <bool> active: true;
    in property <bool> error: false;
    
    height: 6px;
    background: Palette.border;
    border-radius: 3px;
    clip: true;
    
    Rectangle {
        x: 0;
        width: parent.width * Math.max(0.0, Math.min(1.0, root.progress));
        height: 100%;
        background: error ? Palette.error : (active ? Palette.accent-gradient : Palette.text-muted);
        border-radius: 3px;
        
        // Glow effect
        if active && !error: Rectangle {
            width: 100%; height: 100%;
            background: @linear-gradient(90deg, #FFFFFF00 0%, #FFFFFF33 50%, #FFFFFF00 100%);
        }
    }
}

component StatusBadge inherits Rectangle {
    in property <string> text;
    in property <color> text-color;
    in property <color> bg-color;
    
    height: 18px;
    background: bg-color;
    border-radius: 9px;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        Text {
            text: root.text;
            color: root.text-color;
            font-size: 9px;
            font-weight: 800;
            font-family: Fonts.main;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
}

component ToggleSwitch inherits Rectangle {
    in-out property <bool> checked: false;
    in property <bool> enabled: true;
    callback toggled;
    
    width: 36px; height: 18px;
    background: checked ? Palette.success : Palette.panel;
    border-radius: 9px;
    border-width: 1.5px;
    border-color: checked ? Palette.success : Palette.border-bright;
    
    animate background { duration: 150ms; }
    
    Rectangle {
        x: checked ? parent.width - parent.height + 2px : 2px;
        y: 2px;
        width: parent.height - 6px;
        height: parent.height - 6px;
        background: Palette.text-primary;
        border-radius: (parent.height - 6px) / 2;
        
        animate x { duration: 150ms; easing: ease-out; }
    }
    
    ta := TouchArea {
        clicked => { if root.enabled { root.checked = !root.checked; root.toggled(); } }
    }
}

component SectionCard inherits Rectangle {
    in property <string> title;
    in property <string> description;
    in property <bool> active: false;
    
    background: Palette.surface-card;
    border-color: active ? Palette.accent-primary : Palette.border;
    border-width: 1px;

    VerticalLayout {
        padding: 16px;
        spacing: 12px;
        VerticalLayout {
            spacing: 2px;
            Text {
                text: root.title;
                font-size: 13px;
                font-weight: 800;
                color: Palette.text-primary;
                letter-spacing: 0.5px;
            }
            if description != "": Text {
                text: root.description;
                font-size: 10px;
                color: Palette.text-muted;
            }
        }
        @children
    }
}

component StandardInput inherits Rectangle {
    in property <string> text;
    in property <string> placeholder;
    callback edited(string);
    height: 32px;
    background: Palette.surface;
    border-color: editor.has-focus ? Palette.accent-primary : Palette.border;
    border-width: editor.has-focus ? 2px : 1px;
    Rectangle { x: 0px; y: 0px; width: editor.has-focus ? 3px : 1px; height: 100%; background: editor.has-focus ? Palette.accent-primary : Palette.border; }
    
    editor := LineEdit { 
        x: 10px; y: 0; width: parent.width - 18px; height: parent.height;
        text: root.text; 
        placeholder-text: root.placeholder;
        edited(t) => { root.edited(t); } 
    }
}

export component MainWindow inherits Window {
    width: 1120px;
    height: 680px;
    title: "Flow";
    background: Palette.bg;
    default-font-family: Fonts.main;

    in property <[DownloadRow]> download-rows: [];
    in property <[string]> queue-groups: ["Main"];
    in property <int> selected-queue-index: 0;
    in property <string> queue-config-summary: "";
    in property <string> queue-name-text: "Main";
    in property <string> browser-extension-id-text: "";
    in property <string> default-folder-text: "";
    in property <int> selected-download-index: -1;
    in-out property <int> selected-category-index: 0;
    in property <string> status-message: "Ready";
    in property <bool> show-delete-confirm: false;
    in property <bool> can-open-selected: false;
    in property <bool> can-open-selected-folder: false;
    in property <bool> can-delete-selected: false;
    in property <bool> can-resume-selected: false;
    in property <bool> can-stop-selected: false;
    in property <bool> can-move-selected-up: false;
    in property <bool> can-move-selected-down: false;
    in property <bool> can-requeue-selected: false;
    in property <int> footer-active-count: 0;
    in property <string> footer-speed-text: "0 B";
    in property <string> footer-total-text: "0";
    in property <[string]> move-queue-labels: [];
    in property <[string]> move-category-labels: [];
    in-out property <bool> show-properties-dialog: false;
    in-out property <string> properties-summary: "";
    in-out property <bool> show-file-checksum-dialog: false;
    in-out property <string> file-checksum-summary: "";
    in-out property <[DownloadsMenuRow]> downloads-menu-rows: [];
    in-out property <[DownloadsMenuRow]> downloads-submenu-rows: [];
    
    // Settings properties
    in property <int> thread-count: 4;
    in property <int> max-concurrent: 2;
    in property <bool> auto-start-enabled: false;
    in property <bool> system-tray-enabled: false;
    in property <bool> browser-integration-enabled: false;
    in property <bool> clipboard-monitoring-enabled: false;
    in property <int> proxy-mode: 0; // 0: Direct, 1: System, 2: Manual

    callback retry-failed(); callback cleanup-finished(); callback select-queue(index: int); callback select-category(index: int); callback create-queue();
    callback toggle-queue(); callback delete-queue(); callback select-download(index: int); callback move-download-up();
    callback move-download-down(); callback requeue-download(); callback queue-max-minus(); callback queue-max-plus();
    callback queue-toggle-stop-on-empty(); callback queue-name-changed(value: string); callback toggle-auto-start();
    callback add-url(); callback resume-selected(); callback stop-selected(); callback stop-all(); callback delete-selected();
    callback request-delete-selected(); callback confirm-delete-selected(); callback cancel-delete-selected();
    callback open-selected(); callback open-selected-folder(); callback retry-selected();
    callback toggle-system-tray(); callback toggle-browser-integration(); callback toggle-clipboard-monitoring();
    callback settings-thread-minus(); callback settings-thread-plus(); callback settings-max-minus(); callback settings-max-plus();
    callback settings-use-downloads-folder(); callback register-browser-host();
    callback queue-create-new(); callback queue-rename(); callback queue-delete-confirm();
    callback proxy-mode-changed(mode: int); callback proxy-test-connection();
    callback queue-schedule-toggle-enabled(); callback queue-schedule-start-minus(); callback queue-schedule-start-plus();
    callback queue-schedule-stop-minus(); callback queue-schedule-stop-plus(); callback queue-schedule-toggle-day(day: int);
    callback tasks-start-all(); callback tasks-pause-all();
    callback file-batch-download(); callback app-exit();
    callback downloads-select-all(); callback downloads-clear-selection(); callback toggle-download-checked(index: int); callback downloads-sort-by-name();
    callback downloads-sort-by-size(); callback downloads-sort-by-status(); callback downloads-sort-by-date-added();
    callback view-refresh(); callback view-toggle-toolbar(); callback view-toggle-status-bar();
    callback tools-browser-integration(); callback tools-per-host-settings(); callback tools-open-settings();
    callback help-about(); callback help-check-updates(); callback help-online-help(); callback help-donate(); callback help-translators();
    callback menu-tasks(); callback menu-file(); callback menu-downloads(); callback menu-view(); callback menu-tools(); callback menu-help();
    callback tasks-delete-finished(); callback tasks-delete-unfinished(); callback tasks-delete-current-queue();
    callback file-open-add-url(); callback file-open-batch-download(); callback file-open-settings();
    callback move-selection-to-queue(index: int); callback move-selection-to-category(index: int);
    callback copy-selected-links(); callback copy-selected-as-curl(); callback show-selected-properties(); callback close-properties-dialog();
    callback restart-selected-downloads(); callback edit-selected-download(); callback show-file-checksum(); callback close-file-checksum-dialog();
    callback downloads-menu-command(command-id: string, target-index: int);
    callback downloads-menu-open-submenu(parent-index: int);

    in-out property <int> current-tab: 0; // 0 downloads, 1 scheduler, 2 settings
    in-out property <bool> queue-stop-on-empty: false;
    in-out property <bool> queue-schedule-enabled: false;
    in-out property <string> queue-schedule-start: "08:00";
    in-out property <string> queue-schedule-stop: "18:00";
    in-out property <bool> queue-day-sun: true;
    in-out property <bool> queue-day-mon: true;
    in-out property <bool> queue-day-tue: true;
    in-out property <bool> queue-day-wed: true;
    in-out property <bool> queue-day-thu: true;
    in-out property <bool> queue-day-fri: true;
    in-out property <bool> queue-day-sat: true;
    in-out property <int> active-menu: -1;
    property <length> menu-popup-width: 180px;
    property <length> menu-popup-x: 6px + (active-menu * 72px);
    property <length> menu-popup-height: active-menu == 0 ? 150px : (active-menu == 2 ? 176px : (active-menu == 5 ? 152px : 94px));
    in-out property <bool> toolbar-visible: true;
    in-out property <bool> status-bar-visible: true;
    in-out property <bool> merge-topbar-with-titlebar: false;
    in-out property <length> categories-panel-width: 200px;
    in-out property <bool> show-overlay-notification: false;
    in-out property <string> overlay-notification-text: "";
    in-out property <bool> drag-overlay-visible: false;
    in-out property <string> drag-overlay-text: "Drop URLs to queue download";
    callback categories-width-delta(delta: length);

    // Cyber Grid Background
    Rectangle {
        x: 0px; y: 0px; width: root.width; height: root.height;
        background: Palette.bg;
        opacity: 0.35;
        for col[i] in 100: Rectangle { x: i * 32px; y: 0px; width: 1px; height: root.height; background: Palette.border; }
        for row[i] in 80: Rectangle { x: 0px; y: i * 32px; width: root.width; height: 1px; background: Palette.border; }
    }

    VerticalLayout {
        spacing: 0;

        // Menu Bar (hidden when merged into titlebar region)
        if !root.merge-topbar-with-titlebar: Rectangle {
            height: 22px; background: Palette.surface;
            HorizontalLayout { padding-left: 0px; padding-right: 0px; spacing: 0px;
                MenuItem { text: "Tasks"; clicked => { if root.active-menu == 0 { root.active-menu = -1; } else { root.menu-tasks(); } } hover => { if root.active-menu >= 0 { root.active-menu = 0; } } }
                MenuItem { text: "File"; clicked => { if root.active-menu == 1 { root.active-menu = -1; } else { root.menu-file(); } } hover => { if root.active-menu >= 0 { root.active-menu = 1; } } }
                MenuItem { text: "Downloads"; clicked => { if root.active-menu == 2 { root.active-menu = -1; } else { root.menu-downloads(); } } hover => { if root.active-menu >= 0 { root.active-menu = 2; } } }
                MenuItem { text: "View"; clicked => { if root.active-menu == 3 { root.active-menu = -1; } else { root.menu-view(); } } hover => { if root.active-menu >= 0 { root.active-menu = 3; } } }
                MenuItem { text: "Tools"; clicked => { if root.active-menu == 4 { root.active-menu = -1; } else { root.menu-tools(); } } hover => { if root.active-menu >= 0 { root.active-menu = 4; } } }
                MenuItem { text: "Help"; clicked => { if root.active-menu == 5 { root.active-menu = -1; } else { root.menu-help(); } } hover => { if root.active-menu >= 0 { root.active-menu = 5; } } }
                Rectangle { width: 100%; }
            }
            Rectangle { y: parent.height - 1px; width: 100%; height: 1px; background: Palette.border; }
        }

        if root.merge-topbar-with-titlebar: Rectangle { height: 4px; background: Palette.bg; }

        // Toolbar - grouped actions and visible page switches
        // Toolbar
        if root.toolbar-visible: Rectangle {
            height: 72px; 
            background: Palette.panel;
            border-color: Palette.border;
            border-width: 1px;
            
            HorizontalLayout {
                padding-left: 12px; padding-right: 12px;
                spacing: 4px;
                alignment: start;

                // Group 1: Add
                ToolbarButton { text: "Add URL"; icon-type: "add"; clicked => { root.add-url(); current-tab = 0; } }
                
                Rectangle { width: 1px; height: 32px; background: Palette.border-bright; y: 20px; }

                // Group 2: Control
                ToolbarButton { text: "Resume"; icon-type: "resume"; enabled: root.can-resume-selected; clicked => { root.resume-selected(); current-tab = 0; } }
                ToolbarButton { text: "Stop"; icon-type: "stop"; enabled: root.can-stop-selected; clicked => { root.stop-selected(); current-tab = 0; } }
                ToolbarButton { text: "Stop All"; icon-type: "stop-all"; clicked => { root.stop-all(); current-tab = 0; } }
                
                Rectangle { width: 1px; height: 32px; background: Palette.border-bright; y: 20px; }

                // Group 3: File Ops
                ToolbarButton { text: "Delete"; icon-type: "delete"; enabled: root.can-delete-selected; clicked => { root.request-delete-selected(); current-tab = 0; } }
                ToolbarButton { text: "Cleanup"; icon-type: "cleanup"; clicked => { root.cleanup-finished(); current-tab = 0; } }
                
                Rectangle { width: 1px; height: 32px; background: Palette.border-bright; y: 20px; }

                // Group 4: Local
                ToolbarButton { text: "Open"; icon-type: "open"; enabled: root.can-open-selected; clicked => { root.open-selected(); } }
                ToolbarButton { text: "Folder"; icon-type: "folder"; enabled: root.can-open-selected-folder; clicked => { root.open-selected-folder(); } }
                
                Rectangle { width: 1px; height: 32px; background: Palette.border-bright; y: 20px; }

                // Group 5: View
                ToolbarButton { text: "Schedule"; icon-type: "scheduler"; active: current-tab == 1; clicked => { current-tab = 1; } }
                ToolbarButton { text: "Settings"; icon-type: "options"; active: current-tab == 2; clicked => { current-tab = 2; } }

                Rectangle { width: 100%; }
            }
        }

        HorizontalLayout {
            // Sidebar
            Rectangle {
                width: root.categories-panel-width; background: Palette.surface;
                Rectangle {
                    x: 0; y: 0; width: 100%; height: 100%;
                    background: @linear-gradient(180deg, #1E1E1E 0%, #0A0A0A 62%, #140A05 100%);
                }
                VerticalLayout {
                    padding: 8px;
                    spacing: 4px;
                    
                    HorizontalLayout {
                        padding-left: 12px;
                        Text { 
                            text: "CATEGORIES"; 
                            font-size: 10px; 
                            font-weight: 800; 
                            color: Palette.text-dim; 
                            letter-spacing: 1px;
                        }
                    }
                    Rectangle { height: 4px; }
                    
                    TreeItem { text: "All Downloads"; icon-type: "all"; active: root.selected-category-index == 0; clicked => { root.selected-category-index = 0; root.select-category(0); } }
                    TreeItem { text: "Unfinished"; icon-type: "unfinished"; active: root.selected-category-index == 1; clicked => { root.selected-category-index = 1; root.select-category(1); } }
                    TreeItem { text: "Finished"; icon-type: "finished"; active: root.selected-category-index == 2; clicked => { root.selected-category-index = 2; root.select-category(2); } }
                    
                    Rectangle { height: 16px; }
                    
                    HorizontalLayout {
                        padding-left: 12px;
                        Text { 
                            text: "QUEUES"; 
                            font-size: 10px; 
                            font-weight: 800; 
                            color: Palette.text-dim; 
                            letter-spacing: 1px;
                        }
                    }
                    Rectangle { height: 4px; }
                    
                    ScrollView {
                        VerticalLayout {
                            spacing: 2px;
                            for q[i] in root.queue-groups: TreeItem {
                                text: q;
                                icon-type: "queue";
                                active: i == root.selected-queue-index;
                                clicked => { root.select-queue(i); }
                            }
                        }
                    }
                }
                Rectangle { x: parent.width - 1px; y: 0; width: 1px; height: 100%; background: Palette.border; }
            }

            // Splitter handle (IDM-style side/content divider)
            Rectangle {
                width: 5px;
                background: Palette.bg;
                Rectangle { x: 2px; y: 0; width: 1px; height: parent.height; background: Palette.border; }
                TouchArea {
                    moved => {
                        root.categories-width-delta(self.mouse-x - self.pressed-x);
                    }
                }
            }

            // Main Content Area
            Rectangle {
                background: Palette.bg;
                VerticalLayout {
                    padding-left: 0px; padding-right: 0px; padding-top: 0px; padding-bottom: 0px;
                    spacing: 0px;
                if current-tab == 0: VerticalLayout {
                    padding-left: 2px; padding-right: 2px; padding-top: 0px; padding-bottom: 0px;
                    spacing: 0px;
                    Rectangle { height: 2px; background: transparent; }
                    // Header for Table
                    Rectangle {
                        height: 22px; background: Palette.panel;
                        HorizontalLayout {
                            padding-left: 6px; padding-right: 6px; spacing: 0;
                            Rectangle {
                                width: 28px;
                            }
                            Rectangle {
                                width: 272px;
                                Text { text: "File Name"; width: 100%; font-size: 10px; font-weight: 600; color: Palette.text-muted; vertical-alignment: center; }
                                TouchArea { clicked => { root.downloads-sort-by-name(); } }
                            }
                            Rectangle { width: 1px; background: Palette.border; }
                            Rectangle {
                                width: 80px;
                                Text { text: "Size"; width: 100%; font-size: 10px; font-weight: 600; color: Palette.text-muted; vertical-alignment: center; horizontal-alignment: center; }
                                TouchArea { clicked => { root.downloads-sort-by-size(); } }
                            }
                            Rectangle { width: 1px; background: Palette.border; }
                            Rectangle {
                                width: 100px;
                                Text { text: "Status"; width: 100%; font-size: 10px; font-weight: 600; color: Palette.text-muted; vertical-alignment: center; horizontal-alignment: center; }
                                TouchArea { clicked => { root.downloads-sort-by-status(); } }
                            }
                            Rectangle { width: 1px; background: Palette.border; }
                            Text { text: "Speed"; width: 80px; font-size: 10px; font-weight: 600; color: Palette.text-muted; vertical-alignment: center; horizontal-alignment: center; }
                            Rectangle { width: 1px; background: Palette.border; }
                            Text { text: "Time Left"; width: 80px; font-size: 10px; font-weight: 600; color: Palette.text-muted; vertical-alignment: center; horizontal-alignment: center; }
                            Rectangle { width: 1px; background: Palette.border; }
                            Rectangle {
                                width: 130px;
                                Text { text: "Date Added"; width: 100%; font-size: 10px; font-weight: 600; color: Palette.text-muted; vertical-alignment: center; horizontal-alignment: center; }
                                TouchArea { clicked => { root.downloads-sort-by-date-added(); } }
                            }
                            Rectangle { width: 100%; }
                        }
                        Rectangle { y: parent.height - 1px; width: 100%; height: 1px; background: Palette.border; }
                    }

                    // Table Body
                    ScrollView {
                        HorizontalLayout {
                            padding-left: 2px; padding-right: 2px; spacing: 0px;
                            VerticalLayout {
                                padding: 0; spacing: 0;
                            if root.download-rows.length == 0: Rectangle {
                                height: 116px;
                                background: transparent;
                                VerticalLayout {
                                    alignment: center;
                                    Text {
                                        text: root.selected-category-index == 1 ? "No unfinished downloads" : (root.selected-category-index == 2 ? "No finished downloads" : "No downloads yet");
                                        font-size: 12px;
                                        color: Palette.text-muted;
                                    }
                                }
                            }
                    for row[i] in root.download-rows: Rectangle {
                                height: 42px;
                                background: i == root.selected-download-index ? Palette.selection-bg : (ta.has-hover ? Palette.row-hover : (Math.mod(i, 2) == 1 ? Palette.row-even : Palette.row-odd));
                                border-width: i == root.selected-download-index ? 1px : 0px;
                                border-color: Palette.selection-border;
                                
                                HorizontalLayout {
                                    padding-left: 12px; padding-right: 12px; spacing: 0;
                                    
                                    // Checkbox
                                    Rectangle {
                                        width: 32px;
                                        Rectangle {
                                            x: 0px; y: 13px;
                                            width: 14px; height: 14px;
                                            border-width: 1.5px;
                                            border-color: row.checked ? Palette.accent-primary : Palette.border-bright;
                                            border-radius: 2px;
                                            background: row.checked ? Palette.accent-primary : transparent;
                                            if row.checked: Text {
                                                text: "✓";
                                                color: Palette.bg;
                                                font-size: 10px;
                                                font-weight: 900;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                        TouchArea { clicked => { root.toggle-download-checked(i); } }
                                    }
                                    
                                    Text { 
                                        text: row.name; width: 272px; font-size: 11px; vertical-alignment: center; 
                                        color: row.is-error ? Palette.error : Palette.text-primary; 
                                        overflow: elide; font-weight: 500;
                                    }
                                    
                                    Text { 
                                        text: row.size; width: 80px; font-size: 10px; vertical-alignment: center; 
                                        horizontal-alignment: right; color: Palette.text-secondary; font-family: Fonts.mono;
                                    }
                                    
                                    VerticalLayout {
                                        width: 100px; alignment: center; padding-left: 12px; padding-right: 12px; spacing: 4px;
                                        StatusBadge {
                                            text: row.status;
                                            text-color: row.is-error ? Palette.error : (row.status == "Completed" ? Palette.success : Palette.warning);
                                            bg-color: row.is-error ? Palette.error-bg : (row.status == "Completed" ? Palette.success-bg : Palette.warning-bg);
                                        }
                                        if row.has-progress: ProgressBar {
                                            progress: row.progress / 100.0;
                                            active: row.status == "Downloading";
                                            error: row.is-error;
                                        }
                                    }
                                    
                                    Text { 
                                        text: row.speed; width: 80px; font-size: 10px; vertical-alignment: center; 
                                        horizontal-alignment: center; color: Palette.text-secondary; font-family: Fonts.mono;
                                    }
                                    
                                    Text { 
                                        text: row.time-left; width: 80px; font-size: 10px; vertical-alignment: center; 
                                        horizontal-alignment: center; color: Palette.text-muted; font-family: Fonts.mono;
                                    }
                                    
                                    Text { 
                                        text: row.date-added; width: 130px; font-size: 10px; vertical-alignment: center; 
                                        horizontal-alignment: center; color: Palette.text-muted;
                                    }
                                    
                                    Rectangle { width: 100%; }
                                }
                                ta := TouchArea { clicked => { root.select-download(i); } }
                            }
                            }
                        }
                    }
                }
                
                if current-tab == 1: ScrollView {
                    VerticalLayout {
                        padding: 16px;
                        spacing: 16px;
                        alignment: start;
                        
                        SectionCard {
                            title: "Queue Status";
                            description: "Current activity and settings for " + root.queue-name-text;
                            active: true;
                            
                            HorizontalLayout {
                                spacing: 16px;
                                alignment: start;
                                VerticalLayout {
                                    spacing: 4px;
                                    Text { text: "Activity Status"; font-size: 10px; color: Palette.text-muted; }
                                    Text { text: root.status-message; font-size: 14px; font-weight: 700; color: Palette.text-primary; }
                                }
                                Rectangle { width: 1px; background: Palette.border; }
                                VerticalLayout {
                                    spacing: 4px;
                                    Text { text: "Queue Configuration"; font-size: 10px; color: Palette.text-muted; }
                                    Text { text: root.queue-config-summary; font-size: 11px; color: Palette.text-secondary; }
                                }
                            }
                        }

                        SectionCard {
                            title: "Queue Controls";
                            description: "Manage execution and item order";
                            
                            HorizontalLayout {
                                spacing: 12px;
                                ToolbarButton { text: "Start Queue"; icon-type: "resume"; height: 36px; clicked => { root.toggle-queue(); } }
                                ToolbarButton { text: "Delete Queue"; icon-type: "delete"; height: 36px; clicked => { root.queue-delete-confirm(); } }
                                ToolbarButton { text: "Rename"; height: 36px; clicked => { root.queue-rename(); } }
                                Rectangle { width: 1px; background: Palette.border; }
                                ToolbarButton { text: "Move Up"; icon-type: "up"; enabled: root.can-move-selected-up; height: 36px; clicked => { root.move-download-up(); } }
                                ToolbarButton { text: "Move Down"; icon-type: "down"; enabled: root.can-move-selected-down; height: 36px; clicked => { root.move-download-down(); } }
                                ToolbarButton { text: "Requeue"; icon-type: "retry"; enabled: root.can-requeue-selected; height: 36px; clicked => { root.requeue-download(); } }
                            }
                        }

                        SectionCard {
                            title: "Configuration";
                            description: "Concurrency and completion behavior";
                            
                            VerticalLayout {
                                spacing: 12px;
                                HorizontalLayout {
                                    spacing: 24px;
                                    VerticalLayout {
                                        spacing: 8px;
                                        Text { text: "Max Concurrent Downloads"; font-size: 11px; color: Palette.text-secondary; }
                                        HorizontalLayout {
                                            spacing: 12px; alignment: start;
                                            ToolbarButton { text: "-"; min-width: 32px; icon-type: "minus"; height: 28px; clicked => { root.queue-max-minus(); } }
                                            Text { text: root.max-concurrent; width: 40px; vertical-alignment: center; horizontal-alignment: center; font-size: 13px; font-weight: 800; color: Palette.accent-primary; font-family: Fonts.mono; }
                                            ToolbarButton { text: "+"; min-width: 32px; icon-type: "plus"; height: 28px; clicked => { root.queue-max-plus(); } }
                                        }
                                    }
                                    Rectangle { width: 1px; background: Palette.border; }
                                    VerticalLayout {
                                        spacing: 8px;
                                        Text { text: "Completion Policy"; font-size: 11px; color: Palette.text-secondary; }
                                        HorizontalLayout {
                                            spacing: 12px; alignment: start;
                                            ToggleSwitch { checked: root.queue-stop-on-empty; toggled => { root.queue-toggle-stop-on-empty(); } }
                                            Text { text: "Stop queue when empty"; font-size: 11px; vertical-alignment: center; color: Palette.text-primary; }
                                        }
                                    }
                                }
                            }
                        }

                        SectionCard {
                            title: "Schedule Settings";
                            description: "Automate start and stop times";
                            
                            VerticalLayout {
                                spacing: 16px;
                                HorizontalLayout {
                                    spacing: 12px; alignment: start;
                                    ToggleSwitch { checked: root.queue-schedule-enabled; toggled => { root.queue-schedule-toggle-enabled(); } }
                                    Text { text: "Enable Automation Schedule"; font-size: 11px; font-weight: 700; color: root.queue-schedule-enabled ? Palette.success : Palette.text-muted; vertical-alignment: center; }
                                }
                                
                                HorizontalLayout {
                                    spacing: 32px;
                                    VerticalLayout {
                                        spacing: 8px;
                                        Text { text: "Start At"; font-size: 10px; color: Palette.text-dim; }
                                        HorizontalLayout {
                                            spacing: 8px;
                                            ToolbarButton { text: "-"; min-width: 28px; height: 24px; clicked => { root.queue-schedule-start-minus(); } }
                                            Text { text: root.queue-schedule-start; width: 64px; vertical-alignment: center; horizontal-alignment: center; font-size: 14px; font-weight: 800; color: Palette.text-primary; font-family: Fonts.mono; }
                                            ToolbarButton { text: "+"; min-width: 28px; height: 24px; clicked => { root.queue-schedule-start-plus(); } }
                                        }
                                    }
                                    VerticalLayout {
                                        spacing: 8px;
                                        Text { text: "Stop At"; font-size: 10px; color: Palette.text-dim; }
                                        HorizontalLayout {
                                            spacing: 8px;
                                            ToolbarButton { text: "-"; min-width: 28px; height: 24px; clicked => { root.queue-schedule-stop-minus(); } }
                                            Text { text: root.queue-schedule-stop; width: 64px; vertical-alignment: center; horizontal-alignment: center; font-size: 14px; font-weight: 800; color: Palette.text-primary; font-family: Fonts.mono; }
                                            ToolbarButton { text: "+"; min-width: 28px; height: 24px; clicked => { root.queue-schedule-stop-plus(); } }
                                        }
                                    }
                                }
                                
                                VerticalLayout {
                                    spacing: 8px;
                                    Text { text: "Active Days"; font-size: 10px; color: Palette.text-dim; }
                                    HorizontalLayout {
                                        spacing: 6px;
                                        for day[i] in [
                                            { label: "Su", val: root.queue-day-sun },
                                            { label: "Mo", val: root.queue-day-mon },
                                            { label: "Tu", val: root.queue-day-tue },
                                            { label: "We", val: root.queue-day-wed },
                                            { label: "Th", val: root.queue-day-thu },
                                            { label: "Fr", val: root.queue-day-fri },
                                            { label: "Sa", val: root.queue-day-sat }
                                        ]: Rectangle {
                                            width: 36px; height: 28px;
                                            background: day.val ? Palette.accent-active : Palette.panel;
                                            border-width: 1px;
                                            border-color: day.val ? Palette.accent-primary : Palette.border;
                                            Text { text: day.label; font-size: 11px; font-weight: 800; color: day.val ? Palette.text-primary : Palette.text-muted; horizontal-alignment: center; vertical-alignment: center; }
                                            TouchArea { clicked => { root.queue-schedule-toggle-day(i); } }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                if current-tab == 2: ScrollView {
                    VerticalLayout {
                        padding: 16px;
                        spacing: 16px;
                        alignment: start;

                        SectionCard {
                            title: "Application Behavior";
                            description: "General system and startup options";
                            
                            HorizontalLayout {
                                spacing: 32px;
                                alignment: start;
                                HorizontalLayout {
                                    spacing: 12px; alignment: start;
                                    ToggleSwitch { checked: root.auto-start-enabled; toggled => { root.toggle-auto-start(); } }
                                    Text { text: "Auto-Start with Windows"; font-size: 11px; vertical-alignment: center; color: Palette.text-primary; }
                                }
                                HorizontalLayout {
                                    spacing: 12px; alignment: start;
                                    ToggleSwitch { checked: root.system-tray-enabled; toggled => { root.toggle-system-tray(); } }
                                    Text { text: "Minimize to System Tray"; font-size: 11px; vertical-alignment: center; color: Palette.text-primary; }
                                }
                            }
                        }

                        SectionCard {
                            title: "Download Preferences";
                            description: "Storage and performance limits";
                            
                            VerticalLayout {
                                spacing: 16px;
                                HorizontalLayout {
                                    spacing: 12px; alignment: start;
                                    Text { text: "Default Folder"; width: 100px; vertical-alignment: center; font-size: 11px; color: Palette.text-secondary; }
                                    StandardInput { width: 400px; text: root.default-folder-text; }
                                    ToolbarButton { text: "..."; min-width: 40px; height: 32px; clicked => { root.settings-use-downloads-folder(); } }
                                }
                                
                                HorizontalLayout {
                                    spacing: 32px;
                                    VerticalLayout {
                                        spacing: 8px;
                                        Text { text: "Global Thread Count"; font-size: 11px; color: Palette.text-secondary; }
                                        HorizontalLayout {
                                            spacing: 12px; alignment: start;
                                            ToolbarButton { text: "-"; min-width: 32px; icon-type: "minus"; height: 28px; clicked => { root.settings-thread-minus(); } }
                                            Text { text: root.thread-count; width: 40px; vertical-alignment: center; horizontal-alignment: center; font-size: 13px; font-weight: 800; color: Palette.accent-primary; font-family: Fonts.mono; }
                                            ToolbarButton { text: "+"; min-width: 32px; icon-type: "plus"; height: 28px; clicked => { root.settings-thread-plus(); } }
                                        }
                                    }
                                    VerticalLayout {
                                        spacing: 8px;
                                        Text { text: "Max Concurrent Jobs"; font-size: 11px; color: Palette.text-secondary; }
                                        HorizontalLayout {
                                            spacing: 12px; alignment: start;
                                            ToolbarButton { text: "-"; min-width: 32px; icon-type: "minus"; height: 28px; clicked => { root.settings-max-minus(); } }
                                            Text { text: root.max-concurrent; width: 40px; vertical-alignment: center; horizontal-alignment: center; font-size: 13px; font-weight: 800; color: Palette.accent-primary; font-family: Fonts.mono; }
                                            ToolbarButton { text: "+"; min-width: 32px; icon-type: "plus"; height: 28px; clicked => { root.settings-max-plus(); } }
                                        }
                                    }
                                }
                            }
                        }

                        SectionCard {
                            title: "Integration & Monitoring";
                            description: "Connect with browsers and watch clipboard";
                            
                            VerticalLayout {
                                spacing: 16px;
                                HorizontalLayout {
                                    spacing: 32px;
                                    HorizontalLayout {
                                        spacing: 12px; alignment: start;
                                        ToggleSwitch { checked: root.browser-integration-enabled; toggled => { root.toggle-browser-integration(); } }
                                        Text { text: "Browser Integration"; font-size: 11px; vertical-alignment: center; color: Palette.text-primary; }
                                    }
                                    HorizontalLayout {
                                        spacing: 12px; alignment: start;
                                        ToggleSwitch { checked: root.clipboard-monitoring-enabled; toggled => { root.toggle-clipboard-monitoring(); } }
                                        Text { text: "Clipboard Monitoring"; font-size: 11px; vertical-alignment: center; color: Palette.text-primary; }
                                    }
                                }
                                
                                if root.browser-integration-enabled: HorizontalLayout {
                                    spacing: 12px; alignment: start;
                                    Text { text: "Extension ID"; width: 100px; vertical-alignment: center; font-size: 11px; color: Palette.text-secondary; }
                                    StandardInput { width: 340px; text: root.browser-extension-id-text; }
                                    ToolbarButton { text: "Register Host"; height: 32px; clicked => { root.register-browser-host(); } }
                                }
                            }
                        }

                        SectionCard {
                            title: "Proxy Settings";
                            description: "Network routing and connection tunnel";
                            
                            VerticalLayout {
                                spacing: 16px;
                                HorizontalLayout {
                                    spacing: 12px; alignment: start;
                                    for mode[i] in ["Direct", "System", "Manual"]: Rectangle {
                                        width: 100px; height: 32px;
                                        background: root.proxy-mode == i ? Palette.accent-active : Palette.panel;
                                        border-width: 1px;
                                        border-color: root.proxy-mode == i ? Palette.accent-primary : Palette.border;
                                        Text { text: mode; font-size: 11px; font-weight: 700; color: root.proxy-mode == i ? Palette.text-primary : Palette.text-muted; horizontal-alignment: center; vertical-alignment: center; }
                                        TouchArea { clicked => { root.proxy-mode-changed(i); } }
                                    }
                                }
                                
                                if root.proxy-mode == 2: HorizontalLayout {
                                    spacing: 24px;
                                    alignment: start;
                                    VerticalLayout {
                                        spacing: 6px;
                                        Text { text: "Host"; font-size: 10px; color: Palette.text-dim; }
                                        StandardInput { width: 220px; placeholder: "proxy.nexus.net"; }
                                    }
                                    VerticalLayout {
                                        spacing: 6px;
                                        Text { text: "Port"; font-size: 10px; color: Palette.text-dim; }
                                        HorizontalLayout {
                                            spacing: 12px;
                                            StandardInput { width: 80px; placeholder: "8080"; }
                                            ToolbarButton { text: "Test"; height: 32px; clicked => { root.proxy-test-connection(); } }
                                        }
                                    }
                                }
                            }
                        }
                        
                        Rectangle { height: 32px; }
                    }
                }

                // Right-column footer stats strip (IDM ordering: toolbar/list/separator/footer)
                Rectangle {
                    height: 2px;
                    background: Palette.border;
                }
                if root.status-bar-visible: Rectangle {
                    height: 22px; background: Palette.panel;
                    HorizontalLayout {
                        padding-left: 10px; padding-right: 10px; spacing: 12px;
                        Text { text: root.status-message; font-size: 10px; vertical-alignment: center; color: Palette.text-primary; font-weight: 400; }
                        Rectangle { width: 1px; background: Palette.border; height: 12px; y: 5px; }
                        Rectangle { width: 100%; }
                        Text { text: "Active: " + footer-active-count; font-size: 10px; vertical-alignment: center; color: Palette.text-muted; }
                        Text { text: "Downloaded: " + footer-speed-text; font-size: 10px; vertical-alignment: center; color: Palette.text-muted; }
                        Text { text: "Total: " + footer-total-text; font-size: 10px; vertical-alignment: center; color: Palette.text-muted; }
                    }
                }
            }
            }
        }

    }

    // Overlay stack: notifications -> drag overlay -> menu/popup -> dialogs
    if root.show-overlay-notification: Rectangle {
        x: root.width - 290px;
        y: 58px;
        width: 270px;
        height: 34px;
        background: #121212EE;
        border-color: Palette.border;
        border-width: 1px;
        border-radius: 0px;
        HorizontalLayout {
            padding-left: 12px; padding-right: 12px;
            Text {
                text: root.overlay-notification-text;
                color: Palette.text-primary;
                font-size: 10px;
                vertical-alignment: center;
            }
        }
    }

    if root.drag-overlay-visible: Rectangle {
        x: 0; y: 0; width: root.width; height: root.height;
        background: #000000AA;
        Rectangle {
            x: (parent.width - 260px) / 2;
            y: (parent.height - 96px) / 2;
            width: 260px;
            height: 96px;
            background: #121212DD;
            border-color: Palette.accent-primary;
            border-width: 1px;
            border-radius: 0px;
            VerticalLayout {
                alignment: center;
                Text {
                    text: root.drag-overlay-text;
                    color: Palette.text-primary;
                    font-size: 14px;
                    font-weight: 700;
                    horizontal-alignment: center;
                }
                Text {
                    text: "Release to add items to the active queue";
                    color: Palette.text-muted;
                    font-size: 10px;
                    horizontal-alignment: center;
                }
            }
        }
    }

    if active-menu >= 0: Rectangle {
        x: 0; y: 0; width: root.width; height: root.height;
        background: #00000000;
        TouchArea { clicked => { root.active-menu = -1; } }
    }

    if active-menu >= 0: Rectangle {
        x: root.menu-popup-x; y: 28px;
        width: root.menu-popup-width; height: root.menu-popup-height;
        background: Palette.surface;
        border-color: Palette.border;
        border-width: 1px;

        VerticalLayout {
            padding-left: 4px; padding-right: 4px; padding-top: 4px; padding-bottom: 4px;
            spacing: 2px;

            if active-menu == 0: VerticalLayout {
                spacing: 2px;
                MenuItem { text: "Start All"; clicked => { root.tasks-start-all(); root.active-menu = -1; } }
                MenuItem { text: "Pause All"; clicked => { root.tasks-pause-all(); root.active-menu = -1; } }
                MenuItem { text: "Stop All"; clicked => { root.stop-all(); root.active-menu = -1; } }
                MenuItem { text: "Retry Failed"; clicked => { root.retry-failed(); root.active-menu = -1; } }
                MenuItem { text: "Delete Finished"; clicked => { root.tasks-delete-finished(); root.active-menu = -1; } }
                MenuItem { text: "Delete Unfinished"; clicked => { root.tasks-delete-unfinished(); root.active-menu = -1; } }
                MenuItem { text: "Delete Current Queue"; clicked => { root.tasks-delete-current-queue(); root.active-menu = -1; } }
                MenuItem { text: "Cleanup"; clicked => { root.cleanup-finished(); root.active-menu = -1; } }
            }

            if active-menu == 1: VerticalLayout {
                spacing: 2px;
                MenuItem { text: "Add URL"; clicked => { root.file-open-add-url(); current-tab = 0; root.active-menu = -1; } }
                MenuItem { text: "Batch Download"; clicked => { root.file-open-batch-download(); root.active-menu = -1; } }
                MenuItem { text: "Settings"; clicked => { root.file-open-settings(); current-tab = 2; root.active-menu = -1; } }
                MenuItem { text: "Exit"; clicked => { root.app-exit(); root.active-menu = -1; } }
            }
            if active-menu == 2: DownloadsMenuPopup {
                rows: root.downloads-menu-rows;
                submenu_rows: root.downloads-submenu-rows;

                select-all => { root.downloads-select-all(); root.active-menu = -1; }
                clear-selection => { root.downloads-clear-selection(); root.active-menu = -1; }
                open-submenu(parent-index) => { root.downloads-menu-open-submenu(parent-index); }
                invoke(command-id, target-index) => { root.downloads-menu-command(command-id, target-index); root.active-menu = -1; }
                sort-name => { root.downloads-sort-by-name(); root.active-menu = -1; }
                sort-size => { root.downloads-sort-by-size(); root.active-menu = -1; }
                sort-status => { root.downloads-sort-by-status(); root.active-menu = -1; }
                sort-date-added => { root.downloads-sort-by-date-added(); root.active-menu = -1; }
            }

            if active-menu == 3: VerticalLayout {
                spacing: 2px;
                MenuItem { text: "Refresh"; clicked => { root.view-refresh(); root.active-menu = -1; } }
                MenuItem { text: "Sort by Name"; clicked => { root.downloads-sort-by-name(); root.active-menu = -1; } }
                MenuItem { text: "Sort by Size"; clicked => { root.downloads-sort-by-size(); root.active-menu = -1; } }
                MenuItem { text: "Show Toolbar"; clicked => { root.view-toggle-toolbar(); root.active-menu = -1; } }
                MenuItem { text: "Show Status Bar"; clicked => { root.view-toggle-status-bar(); root.active-menu = -1; } }
            }

            if active-menu == 4: VerticalLayout {
                spacing: 2px;
                MenuItem { text: "Browser Integration"; clicked => { current-tab = 2; root.tools-browser-integration(); root.active-menu = -1; } }
                MenuItem { text: "Per-host Settings"; clicked => { current-tab = 2; root.tools-per-host-settings(); root.active-menu = -1; } }
                MenuItem { text: "Settings"; clicked => { current-tab = 2; root.tools-open-settings(); root.active-menu = -1; } }
            }

            if active-menu == 5: VerticalLayout {
                spacing: 2px;
                MenuItem { text: "About"; clicked => { root.help-about(); root.active-menu = -1; } }
                MenuItem { text: "Check Updates"; clicked => { root.help-check-updates(); root.active-menu = -1; } }
                MenuItem { text: "Donate"; clicked => { root.help-donate(); root.active-menu = -1; } }
                MenuItem { text: "Translators"; clicked => { root.help-translators(); root.active-menu = -1; } }
                MenuItem { text: "Online Help"; clicked => { root.help-online-help(); root.active-menu = -1; } }
            }
        }
    }

    if root.show-delete-confirm || root.show-properties-dialog || root.show-file-checksum-dialog: Rectangle {
        x: 0; y: 0; width: root.width; height: root.height;
        background: #000000aa;

        if root.show-delete-confirm: Rectangle {
            x: (parent.width - 440px) / 2;
            y: (parent.height - 200px) / 2;
            width: 440px; height: 200px;
            background: Palette.surface; border-color: Palette.border; border-width: 1px;
            VerticalLayout {
                padding: 0; spacing: 0;
                Rectangle {
                    height: 48px; background: Palette.panel;
                    HorizontalLayout {
                        padding-left: 20px; padding-right: 20px; alignment: center;
                        Text { text: "⚠️ ACTION REQUIRED"; font-size: 11px; font-weight: 800; color: Palette.warning; letter-spacing: 1px; }
                        Rectangle { width: 100%; }
                    }
                    Rectangle { y: parent.height - 1px; width: 100%; height: 1px; background: Palette.border; }
                }
                VerticalLayout {
                    padding: 24px; spacing: 18px;
                    Text { text: "Are you sure you want to remove the selected download task from the list? This action cannot be undone."; font-size: 12px; color: Palette.text-primary; wrap: word-wrap; }
                    HorizontalLayout {
                        spacing: 12px; alignment: end;
                        ToolbarButton { text: "KEEP TASK"; height: 32px; clicked => { root.cancel-delete-selected(); } }
                        ToolbarButton { text: "DELETE PERMANENTLY"; active: true; height: 32px; clicked => { root.confirm-delete-selected(); } }
                    }
                }
            }
        }

        if root.show-properties-dialog: Rectangle {
            x: (parent.width - 560px) / 2;
            y: (parent.height - 340px) / 2;
            width: 560px; height: 340px;
            background: Palette.surface; border-color: Palette.border; border-width: 1px;
            VerticalLayout {
                padding: 0; spacing: 0;
                Rectangle {
                    height: 48px; background: Palette.panel;
                    HorizontalLayout {
                        padding-left: 20px; padding-right: 20px; alignment: center;
                        Text { text: "📋 DOWNLOAD DATA DUMP"; font-size: 11px; font-weight: 800; color: Palette.accent-primary; letter-spacing: 1px; }
                        Rectangle { width: 100%; }
                    }
                    Rectangle { y: parent.height - 1px; width: 100%; height: 1px; background: Palette.border; }
                }
                VerticalLayout {
                    padding: 20px; spacing: 12px;
                    Rectangle {
                        border-width: 1px; border-color: Palette.border; background: Palette.bg;
                        height: 200px;
                        ScrollView {
                            VerticalLayout {
                                padding: 12px;
                                Text {
                                    text: root.properties-summary;
                                    color: Palette.text-primary;
                                    font-size: 11px;
                                    font-family: Fonts.mono;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 12px; alignment: end;
                        ToolbarButton { text: "CLOSE"; active: true; height: 32px; clicked => { root.close-properties-dialog(); } }
                    }
                }
            }
        }

        if root.show-file-checksum-dialog: Rectangle {
            x: (parent.width - 560px) / 2;
            y: (parent.height - 340px) / 2;
            width: 560px; height: 340px;
            background: Palette.surface; border-color: Palette.border; border-width: 1px;
            VerticalLayout {
                padding: 0; spacing: 0;
                Rectangle {
                    height: 48px; background: Palette.panel;
                    HorizontalLayout {
                        padding-left: 20px; padding-right: 20px; alignment: center;
                        Text { text: "🛡️ INTEGRITY SIGNATURE"; font-size: 11px; font-weight: 800; color: Palette.success; letter-spacing: 1px; }
                        Rectangle { width: 100%; }
                    }
                    Rectangle { y: parent.height - 1px; width: 100%; height: 1px; background: Palette.border; }
                }
                VerticalLayout {
                    padding: 20px; spacing: 12px;
                    Rectangle {
                        border-width: 1px; border-color: Palette.border; background: Palette.bg;
                        height: 200px;
                        ScrollView {
                            VerticalLayout {
                                padding: 12px;
                                Text {
                                    text: root.file-checksum-summary;
                                    color: Palette.text-primary;
                                    font-size: 11px;
                                    font-family: Fonts.mono;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 12px; alignment: end;
                        ToolbarButton { text: "CLOSE"; active: true; height: 32px; clicked => { root.close-file-checksum-dialog(); } }
                    }
                }
            }
        }
    }
}


export component AddUrlDialog inherits Window {
    width: 600px; height: 420px;
    title: "Add New URL";
    background: Palette.bg;
    default-font-family: Fonts.main;

    in-out property <string> url: "";
    in-out property <string> file-name: "";
    in-out property <string> output-dir: "";
    in property <string> resolved-file-name: "download.bin";
    in property <string> resolved-output-dir: "";
    in property <string> category-hint: "General";
    in property <string> dialog-hint: "Input a direct download link.";
    in property <bool> url-valid: true;
    in property <[string]> queue-options: ["Main"];
    in-out property <int> queue-index: 0;
    in-out property <string> category: "General";
    private property <bool> can-submit: root.url != "";

    callback download_later(string, string, string, int, string);
    callback start_now(string, string, string, int, string);
    callback choose-folder();
    callback cancel();
    callback preview_update(string, string, string, string);

    VerticalLayout {
        padding: 0; spacing: 0;
        
        // Header
        Rectangle {
            height: 64px; background: Palette.panel;
            HorizontalLayout {
                padding-left: 20px; padding-right: 20px;
                alignment: center;
                VerticalLayout {
                    alignment: center;
                    Text { text: "INITIALIZE NEW TRANSFER"; font-size: 14px; font-weight: 800; color: Palette.accent-primary; letter-spacing: 1.2px; }
                    Text { text: "Establish a connection to the remote resource"; font-size: 10px; color: Palette.text-muted; }
                }
                Rectangle { width: 100%; }
            }
            Rectangle { y: parent.height - 1px; width: 100%; height: 1px; background: Palette.border; }
        }

        // Content
        ScrollView {
            VerticalLayout {
                padding: 20px; spacing: 16px;

                SectionCard {
                    title: "Source URL";
                    description: root.dialog-hint;
                    active: !root.url-valid;
                    
                    StandardInput { 
                        width: 100%; 
                        text: root.url; 
                        placeholder: "https://example.com/file.zip"; 
                        edited(t) => { root.url = t; root.preview_update(t, root.file-name, root.output-dir, root.category); } 
                    }
                }
                
                SectionCard {
                    title: "Metadata & Destination";
                    description: "Resolved: " + root.resolved-file-name;
                    
                    VerticalLayout {
                        spacing: 12px;
                        VerticalLayout {
                            spacing: 4px;
                            Text { text: "File Name"; font-size: 10px; color: Palette.text-dim; }
                            StandardInput { 
                                text: root.file-name; 
                                placeholder: "Auto-detected"; 
                                edited(t) => { root.file-name = t; root.preview_update(root.url, root.file-name, root.output-dir, root.category); } 
                            }
                        }
                        VerticalLayout {
                            spacing: 4px;
                            Text { text: "Save To"; font-size: 10px; color: Palette.text-dim; }
                            HorizontalLayout {
                                spacing: 8px;
                                StandardInput { 
                                    width: 100%; text: root.output-dir; 
                                    placeholder: "Default Downloads folder"; 
                                    edited(t) => { root.output-dir = t; root.preview_update(root.url, root.file-name, root.output-dir, root.category); } 
                                }
                                ToolbarButton { text: "..."; min-width: 40px; height: 32px; clicked => { root.choose-folder(); } }
                            }
                        }
                        VerticalLayout {
                            spacing: 4px;
                            Text { text: "Category"; font-size: 10px; color: Palette.text-dim; }
                            StandardInput {
                                text: root.category;
                                edited(t) => { root.category = t; root.preview_update(root.url, root.file-name, root.output-dir, root.category); }
                            }
                        }
                    }
                }
            }
        }

        // Footer
        Rectangle {
            height: 64px; background: Palette.panel;
            HorizontalLayout {
                padding-left: 20px; padding-right: 20px;
                spacing: 12px;
                alignment: end;
                ToolbarButton { text: "CANCEL"; height: 36px; clicked => { root.cancel(); } }
                ToolbarButton { text: "QUEUE LATER"; height: 36px; enabled: root.can-submit; clicked => { root.download_later(root.url, root.file-name, root.output-dir, root.queue-index, root.category); } }
                ToolbarButton { text: "DOWNLOAD NOW"; active: true; height: 36px; enabled: root.can-submit; clicked => { root.start_now(root.url, root.file-name, root.output-dir, root.queue-index, root.category); } }
            }
            Rectangle { y: 0; width: 100%; height: 1px; background: Palette.border; }
        }
    }

}

export component ClipboardDialog inherits Window {
    width: 560px; height: 380px;
    title: "Clipboard Detection";
    background: Palette.bg;
    default-font-family: Fonts.main;

    in property <string> url: "";
    in-out property <string> file-name: "";
    in-out property <string> output-dir: "";
    in property <string> resolved-file-name: "download.bin";
    in property <string> resolved-output-dir: "";
    in property <string> category-hint: "General";
    in property <string> dialog-hint: "Review detected download details.";
    in property <bool> url-valid: true;
    in property <[string]> queue-options: ["Main"];
    in-out property <int> queue-index: 0;
    in-out property <string> category: "General";

    callback choose-folder();
    callback queue_later(string, string, int, string);
    callback start_now(string, string, int, string);
    callback dismiss();

    VerticalLayout {
        padding: 0; spacing: 0;
        
        Rectangle {
            height: 64px; background: Palette.panel;
            HorizontalLayout {
                padding-left: 20px; padding-right: 20px;
                alignment: center;
                VerticalLayout {
                    alignment: center;
                    Text { text: "📋 CLIPBOARD RESOURCE DETECTED"; font-size: 13px; font-weight: 800; color: Palette.accent-primary; letter-spacing: 1px; }
                    Text { text: "A valid transfer link was identified in system memory"; font-size: 10px; color: Palette.text-muted; }
                }
                Rectangle { width: 100%; }
            }
            Rectangle { y: parent.height - 1px; width: 100%; height: 1px; background: Palette.border; }
        }

        ScrollView {
            VerticalLayout {
                padding: 20px; spacing: 16px;
                
                SectionCard {
                    title: "Detected Link";
                    description: root.url;
                    active: true;
                    Rectangle { height: 1px; }
                }
                
                SectionCard {
                    title: "Transfer Details";
                    description: "Target destination and categorization";
                    
                    VerticalLayout {
                        spacing: 12px;
                        VerticalLayout {
                            spacing: 4px;
                            Text { text: "File Name"; font-size: 10px; color: Palette.text-dim; }
                            StandardInput { text: root.file-name; edited(t) => { root.file-name = t; } }
                        }
                        VerticalLayout {
                            spacing: 4px;
                            Text { text: "Save To"; font-size: 10px; color: Palette.text-dim; }
                            HorizontalLayout {
                                spacing: 8px;
                                StandardInput { width: 100%; text: root.output-dir; edited(t) => { root.output-dir = t; } }
                                ToolbarButton { text: "..."; min-width: 40px; height: 32px; clicked => { root.choose-folder(); } }
                            }
                        }
                    }
                }
            }
        }

        Rectangle {
            height: 64px; background: Palette.panel;
            HorizontalLayout {
                padding-left: 20px; padding-right: 20px; spacing: 12px; alignment: end;
                ToolbarButton { text: "DISMISS"; height: 36px; clicked => { root.dismiss(); } }
                ToolbarButton { text: "QUEUE LATER"; height: 36px; clicked => { root.queue_later(root.file-name, root.output-dir, root.queue-index, root.category); } }
                ToolbarButton { text: "START NOW"; active: true; height: 36px; clicked => { root.start_now(root.file-name, root.output-dir, root.queue-index, root.category); } }
            }
            Rectangle { y: 0; width: 100%; height: 1px; background: Palette.border; }
        }
    }
}

export component RenameQueueDialog inherits Window {
    width: 420px; height: 220px;
    title: "Rename Queue";
    background: Palette.bg;
    default-font-family: Fonts.main;

    in-out property <string> queue-name: "";

    callback save(string);
    callback cancel();

    VerticalLayout {
        padding: 0; spacing: 0;

        Rectangle {
            height: 64px; background: Palette.panel;
            HorizontalLayout {
                padding-left: 20px; padding-right: 20px;
                alignment: center;
                VerticalLayout {
                    alignment: center;
                    Text { text: "RENAME QUEUE"; font-size: 13px; font-weight: 800; color: Palette.accent-primary; letter-spacing: 1px; }
                    Text { text: "Enter a unique identifier for this queue"; font-size: 10px; color: Palette.text-muted; }
                }
                Rectangle { width: 100%; }
            }
            Rectangle { y: parent.height - 1px; width: 100%; height: 1px; background: Palette.border; }
        }

        VerticalLayout {
            padding: 20px; spacing: 16px;
            SectionCard {
                title: "Queue Identity";
                description: "Name used for scheduling and grouping";
                StandardInput {
                    width: 100%;
                    text: root.queue-name;
                    placeholder: "Queue label";
                    edited(t) => { root.queue-name = t; }
                }
            }
            Rectangle { height: 100%; }
        }

        Rectangle {
            height: 64px; background: Palette.panel;
            HorizontalLayout {
                padding-left: 20px; padding-right: 20px; spacing: 12px; alignment: end;
                ToolbarButton { text: "CANCEL"; height: 36px; clicked => { root.cancel(); } }
                ToolbarButton { text: "SAVE"; active: true; height: 36px; clicked => { root.save(root.queue-name); } }
            }
            Rectangle { y: 0; width: 100%; height: 1px; background: Palette.border; }
        }
    }
}

export component EditDownloadDialog inherits Window {
    width: 540px; height: 420px;
    title: "Edit Properties";
    background: Palette.bg;
    default-font-family: Fonts.main;

    in-out property <string> file-name: "";
    in-out property <string> output-dir: "";
    in-out property <int> priority: 0; // 0: Normal, 1: High, -1: Low

    callback save(string, string, int);
    callback cancel();
    callback choose-folder();
    callback set-priority(int);

    VerticalLayout {
        padding: 0; spacing: 0;
        
        Rectangle {
            height: 64px; background: Palette.panel;
            HorizontalLayout {
                padding-left: 20px; padding-right: 20px;
                alignment: center;
                VerticalLayout {
                    alignment: center;
                    Text { text: "TRANSFER PROPERTIES"; font-size: 13px; font-weight: 800; color: Palette.accent-primary; letter-spacing: 1px; }
                    Text { text: "Modify execution priority and metadata"; font-size: 10px; color: Palette.text-muted; }
                }
                Rectangle { width: 100%; }
            }
            Rectangle { y: parent.height - 1px; width: 100%; height: 1px; background: Palette.border; }
        }

        ScrollView {
            VerticalLayout {
                padding: 20px; spacing: 16px;

                SectionCard {
                    title: "File Identity";
                    description: "Target filename for the resulting local file";
                    StandardInput { text: root.file-name; edited(t) => { root.file-name = t; } }
                }

                SectionCard {
                    title: "Storage Destination";
                    description: "Directory where the payload will be reconstructed";
                    HorizontalLayout {
                        spacing: 8px;
                        StandardInput { width: 100%; text: root.output-dir; edited(t) => { root.output-dir = t; } }
                        ToolbarButton { text: "..."; min-width: 40px; height: 32px; clicked => { root.choose-folder(); } }
                    }
                }

                SectionCard {
                    title: "Execution Priority";
                    description: "Resource allocation strategy";
                    HorizontalLayout {
                        spacing: 8px;
                        ToolbarButton { text: "LOW"; active: root.priority == -1; height: 32px; clicked => { root.set-priority(-1); } }
                        ToolbarButton { text: "NORMAL"; active: root.priority == 0; height: 32px; clicked => { root.set-priority(0); } }
                        ToolbarButton { text: "HIGH"; active: root.priority == 1; height: 32px; clicked => { root.set-priority(1); } }
                    }
                }
            }
        }

        Rectangle {
            height: 64px; background: Palette.panel;
            HorizontalLayout {
                padding-left: 20px; padding-right: 20px; spacing: 12px; alignment: end;
                ToolbarButton { text: "CANCEL"; height: 36px; clicked => { root.cancel(); } }
                ToolbarButton { text: "APPLY CHANGES"; active: true; height: 36px; clicked => { root.save(root.file-name, root.output-dir, root.priority); } }
            }
            Rectangle { y: 0; width: 100%; height: 1px; background: Palette.border; }
        }
    }
}

export component FileChecksumDialog inherits Window {
    width: 720px; height: 480px;
    title: "Checksum Verification";
    background: Palette.bg;
    default-font-family: Fonts.main;

    in property <[FileChecksumRow]> rows: [];
    in property <string> status-text: "Preparing checksum verification...";
    callback close-dialog();

    VerticalLayout {
        padding: 0; spacing: 0;

        Rectangle {
            height: 64px; background: Palette.panel;
            HorizontalLayout {
                padding-left: 20px; padding-right: 20px;
                alignment: center;
                VerticalLayout {
                    alignment: center;
                    Text { text: "INTEGRITY AUDIT"; font-size: 13px; font-weight: 800; color: Palette.accent-primary; letter-spacing: 1px; }
                    Text { text: "Verify SHA-256 signatures for downloaded assets"; font-size: 10px; color: Palette.text-muted; }
                }
                Rectangle { width: 100%; }
            }
            Rectangle { y: parent.height - 1px; width: 100%; height: 1px; background: Palette.border; }
        }

        VerticalLayout {
            padding: 20px; spacing: 12px;
            
            SectionCard {
                title: "Active Process";
                description: root.status-text;
                Rectangle { height: 1px; }
            }

            Rectangle {
                background: Palette.surface-card;
                border-width: 1px;
                border-color: Palette.border;
                VerticalLayout {
                    spacing: 0;
                    Rectangle {
                        height: 32px;
                        background: Palette.panel;
                        HorizontalLayout {
                            padding-left: 12px; padding-right: 12px;
                            Text { text: "FILE NAME"; width: 180px; font-size: 10px; font-weight: 800; color: Palette.text-dim; vertical-alignment: center; }
                            Text { text: "EXPECTED HASH"; width: 180px; font-size: 10px; font-weight: 800; color: Palette.text-dim; vertical-alignment: center; }
                            Text { text: "ACTUAL HASH"; width: 180px; font-size: 10px; font-weight: 800; color: Palette.text-dim; vertical-alignment: center; }
                            Text { text: "RESULT"; width: 100px; font-size: 10px; font-weight: 800; color: Palette.text-dim; vertical-alignment: center; }
                        }
                    }
                    ScrollView {
                        VerticalLayout {
                            for row[index] in root.rows: Rectangle {
                                height: 38px;
                                background: Math.mod(index, 2) == 0 ? Palette.row-odd : Palette.row-even;
                                HorizontalLayout {
                                    padding-left: 12px; padding-right: 12px;
                                    Text { text: row.file_name; width: 180px; font-size: 10px; color: Palette.text-primary; vertical-alignment: center; overflow: elide; }
                                    Text { text: row.expected; width: 180px; font-size: 9px; color: Palette.text-muted; vertical-alignment: center; font-family: Fonts.mono; overflow: elide; }
                                    Text { text: row.actual; width: 180px; font-size: 9px; color: Palette.text-muted; vertical-alignment: center; font-family: Fonts.mono; overflow: elide; }
                                    HorizontalLayout {
                                        width: 100px;
                                        StatusBadge {
                                            text: row.result;
                                            text-color: row.result == "Match" ? Palette.success : (row.result == "Checking" ? Palette.warning : Palette.error);
                                            bg-color: row.result == "Match" ? Palette.success-bg : (row.result == "Checking" ? Palette.warning-bg : Palette.error-bg);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        Rectangle {
            height: 64px; background: Palette.panel;
            HorizontalLayout {
                padding-left: 20px; padding-right: 20px; alignment: end;
                ToolbarButton { text: "CLOSE"; active: true; height: 36px; clicked => { root.close-dialog(); } }
            }
            Rectangle { y: 0; width: 100%; height: 1px; background: Palette.border; }
        }
    }
}

export component QueueSettingsDialog inherits Window {
    width: 520px; height: 400px;
    title: "Queue Settings";
    background: Palette.bg;
    default-font-family: Fonts.main;

    in property <string> queue-name: "Main";
    in property <int> max-concurrent: 3;
    in property <bool> stop-on-empty: false;

    callback save(string, int, bool);
    callback cancel();

    VerticalLayout {
        padding: 0; spacing: 0;
        
        Rectangle {
            height: 64px; background: Palette.panel;
            HorizontalLayout {
                padding-left: 20px; padding-right: 20px;
                alignment: center;
                VerticalLayout {
                    alignment: center;
                    Text { text: "QUEUE CONFIGURATION"; font-size: 13px; font-weight: 800; color: Palette.accent-primary; letter-spacing: 1px; }
                    Text { text: "Define behavior and resource limits for the queue"; font-size: 10px; color: Palette.text-muted; }
                }
                Rectangle { width: 100%; }
            }
            Rectangle { y: parent.height - 1px; width: 100%; height: 1px; background: Palette.border; }
        }

        ScrollView {
            VerticalLayout {
                padding: 20px; spacing: 16px;
                
                SectionCard {
                    title: "Queue Label";
                    description: "Primary identifier for this processing group";
                    StandardInput { 
                        width: 100%; 
                        text: root.queue-name; 
                    }
                }
                
                SectionCard {
                    title: "Performance Limits";
                    description: "Maximum simultaneous transfer threads";
                    HorizontalLayout {
                        spacing: 24px;
                        VerticalLayout {
                            spacing: 8px;
                            Text { text: "Max Concurrent Jobs"; font-size: 10px; color: Palette.text-dim; }
                            HorizontalLayout {
                                spacing: 12px; alignment: start;
                                ToolbarButton { text: "-"; min-width: 32px; icon-type: "minus"; height: 28px; }
                                Text { text: root.max-concurrent; width: 40px; vertical-alignment: center; horizontal-alignment: center; font-size: 14px; font-weight: 800; color: Palette.accent-primary; font-family: Fonts.mono; }
                                ToolbarButton { text: "+"; min-width: 32px; icon-type: "plus"; height: 28px; }
                            }
                        }
                    }
                }
                
                SectionCard {
                    title: "Completion Policy";
                    description: "Automated actions upon task completion";
                    HorizontalLayout {
                        spacing: 12px; alignment: start;
                        ToggleSwitch { checked: root.stop-on-empty; }
                        Text { text: "Deactivate queue when processing list is empty"; font-size: 11px; vertical-alignment: center; color: Palette.text-primary; }
                    }
                }
                
                Rectangle { height: 100%; }
            }
        }

        Rectangle {
            height: 64px; background: Palette.panel;
            HorizontalLayout {
                padding-left: 20px; padding-right: 20px; spacing: 12px; alignment: end;
                ToolbarButton { text: "CANCEL"; height: 36px; clicked => { root.cancel(); } }
                ToolbarButton { text: "SAVE SETTINGS"; active: true; height: 36px; clicked => { root.save(root.queue-name, root.max-concurrent, root.stop-on-empty); } }
            }
            Rectangle { y: 0; width: 100%; height: 1px; background: Palette.border; }
        }
    }
}

export component PerHostSettingsDialog inherits Window {
    width: 640px; height: 480px;
    title: "Host Overrides";
    background: Palette.bg;
    default-font-family: Fonts.main;

    in property <string> entry-position: "0/0";
    in property <string> dialog-summary: "No host rule selected";
    in property <bool> has-entry: false;
    in property <bool> can-go-prev: false;
    in property <bool> can-go-next: false;
    in property <bool> can-delete-entry: false;
    in-out property <string> host-pattern: "";
    in-out property <string> username: "";
    in-out property <string> password: "";
    in-out property <string> user-agent: "";
    in-out property <string> thread-count-text: "";

    callback prev-entry();
    callback next-entry();
    callback add-entry();
    callback save-entry(string, string, string, string, string);
    callback delete-entry();
    callback close-dialog();

    VerticalLayout {
        padding: 0; spacing: 0;

        Rectangle {
            height: 64px; background: Palette.panel;
            HorizontalLayout {
                padding-left: 20px; padding-right: 20px;
                alignment: center;
                VerticalLayout {
                    alignment: center;
                    Text { text: "PER-HOST OVERRIDES"; font-size: 13px; font-weight: 800; color: Palette.accent-primary; letter-spacing: 1px; }
                    Text { text: "Custom credentials and network behavior for specific domains"; font-size: 10px; color: Palette.text-muted; }
                }
                Rectangle { width: 100%; }
                Text { text: "ENTRY [" + root.entry-position + "]"; font-size: 10px; font-weight: 800; color: Palette.accent-primary; font-family: Fonts.mono; }
            }
            Rectangle { y: parent.height - 1px; width: 100%; height: 1px; background: Palette.border; }
        }

        ScrollView {
            VerticalLayout {
                padding: 20px; spacing: 16px;

                SectionCard {
                    title: "Navigation & Management";
                    description: root.dialog-summary;
                    HorizontalLayout {
                        spacing: 12px;
                        ToolbarButton { text: "PREV"; icon-type: "up"; height: 32px; enabled: root.can-go-prev; clicked => { root.prev-entry(); } }
                        ToolbarButton { text: "NEXT"; icon-type: "down"; height: 32px; enabled: root.can-go-next; clicked => { root.next-entry(); } }
                        Rectangle { width: 1px; background: Palette.border; }
                        ToolbarButton { text: "ADD NEW"; icon-type: "plus"; height: 32px; clicked => { root.add-entry(); } }
                        ToolbarButton { text: "DELETE"; icon-type: "delete"; height: 32px; enabled: root.can-delete-entry; clicked => { root.delete-entry(); } }
                    }
                }

                SectionCard {
                    title: "Matching Pattern";
                    description: "Target domain (e.g., *.github.com)";
                    StandardInput { width: 100%; text: root.host-pattern; placeholder: "*.example.com"; edited(t) => { root.host-pattern = t; } }
                }

                SectionCard {
                    title: "Authentication";
                    description: "Credentials for secured endpoints";
                    HorizontalLayout {
                        spacing: 16px;
                        VerticalLayout {
                            spacing: 4px;
                            Text { text: "Username"; font-size: 10px; color: Palette.text-dim; }
                            StandardInput { text: root.username; placeholder: "User ID"; edited(t) => { root.username = t; } }
                        }
                        VerticalLayout {
                            spacing: 4px;
                            Text { text: "Password"; font-size: 10px; color: Palette.text-dim; }
                            StandardInput { text: root.password; placeholder: "Token/Pass"; edited(t) => { root.password = t; } }
                        }
                    }
                }

                SectionCard {
                    title: "Network Parameters";
                    description: "Agent identification and concurrency";
                    VerticalLayout {
                        spacing: 12px;
                        VerticalLayout {
                            spacing: 4px;
                            Text { text: "User Agent"; font-size: 10px; color: Palette.text-dim; }
                            StandardInput { width: 100%; text: root.user-agent; placeholder: "Nexus/1.0.0"; edited(t) => { root.user-agent = t; } }
                        }
                        VerticalLayout {
                            spacing: 4px;
                            Text { text: "Thread Override"; font-size: 10px; color: Palette.text-dim; }
                            StandardInput { width: 120px; text: root.thread-count-text; placeholder: "Global default"; edited(t) => { root.thread-count-text = t; } }
                        }
                    }
                }
            }
        }

        Rectangle {
            height: 64px; background: Palette.panel;
            HorizontalLayout {
                padding-left: 20px; padding-right: 20px; spacing: 12px; alignment: end;
                ToolbarButton { text: "CLOSE"; height: 36px; clicked => { root.close-dialog(); } }
                ToolbarButton { text: "SAVE OVERRIDE"; active: true; height: 36px; clicked => { root.save-entry(root.host-pattern, root.username, root.password, root.user-agent, root.thread-count-text); } }
            }
            Rectangle { y: 0; width: 100%; height: 1px; background: Palette.border; }
        }
    }
}

export component BatchDownloadDialog inherits Window {
    width: 700px; height: 520px;
    title: "Batch Download";
    background: Palette.bg;

    in-out property <string> urls-text: "";
    in-out property <string> output-dir: "";
    in property <int> parsed-url-count: 0;
    in property <string> resolved-output-dir: "";
    in property <string> category-hint: "General";
    in property <string> dialog-hint: "Paste one or more HTTP/HTTPS links.";
    in property <bool> urls-valid: true;
    in property <[string]> queue-options: ["Main"];
    in-out property <int> queue-index: 0;
    in-out property <string> category: "General";

    callback choose-folder();
    callback queue-all(string, string, int, string);
    callback start-all(string, string, int, string);
    callback preview-update(string, string, string);
    callback close-dialog();

    VerticalLayout {
        padding: 0; spacing: 0;

        Rectangle {
            height: 64px; background: Palette.panel;
            HorizontalLayout {
                padding-left: 20px; padding-right: 20px;
                alignment: center;
                VerticalLayout {
                    alignment: center;
                    Text { text: "BATCH TRANSFER INITIALIZATION"; font-size: 13px; font-weight: 800; color: Palette.accent-primary; letter-spacing: 1px; }
                    Text { text: "Queue multiple resources for parallel processing"; font-size: 10px; color: Palette.text-muted; }
                }
                Rectangle { width: 100%; }
            }
            Rectangle { y: parent.height - 1px; width: 100%; height: 1px; background: Palette.border; }
        }

        ScrollView {
            VerticalLayout {
                padding: 20px; spacing: 16px;

                SectionCard {
                    title: "Resource Detection";
                    description: root.dialog-hint;
                    HorizontalLayout {
                        spacing: 24px;
                        VerticalLayout {
                            spacing: 4px;
                            Text { text: "LINK COUNT"; font-size: 10px; color: Palette.text-dim; }
                            Text { text: root.parsed-url-count; font-size: 16px; font-weight: 800; color: Palette.accent-primary; font-family: Fonts.mono; }
                        }
                        Rectangle { width: 1px; background: Palette.border; }
                        VerticalLayout {
                            spacing: 4px;
                            Text { text: "TARGET DIRECTORY"; font-size: 10px; color: Palette.text-dim; }
                            Text { text: root.resolved-output-dir; font-size: 11px; color: Palette.text-primary; overflow: elide; }
                        }
                    }
                }

                SectionCard {
                    title: "URL Manifest";
                    description: "Input domains separated by newlines or commas";
                    Rectangle {
                        height: 180px;
                        background: Palette.panel;
                        border-width: 1px;
                        border-color: Palette.border;
                        ScrollView {
                            HorizontalLayout {
                                padding: 8px;
                                TextInput {
                                    text <=> root.urls-text;
                                    font-size: 11px;
                                    font-family: Fonts.mono;
                                    color: Palette.text-primary;
                                    selection-background-color: Palette.selection-bg;
                                    single-line: false;
                                    wrap: no-wrap;
                                    edited => { root.preview-update(root.urls-text, root.output-dir, root.category); }
                                }
                            }
                        }
                    }
                }

                SectionCard {
                    title: "Batch Parameters";
                    description: "Shared categorization and destination";
                    VerticalLayout {
                        spacing: 12px;
                        HorizontalLayout {
                            spacing: 16px;
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: "Category"; font-size: 10px; color: Palette.text-dim; }
                                StandardInput { width: 180px; text: root.category; edited(t) => { root.category = t; root.preview-update(root.urls-text, root.output-dir, root.category); } }
                            }
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: "Queue"; font-size: 10px; color: Palette.text-dim; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    ToolbarButton { text: "-"; min-width: 32px; height: 32px; icon-type: "minus"; enabled: root.queue-index > 0; clicked => { root.queue-index -= 1; } }
                                    Rectangle {
                                        width: 120px; height: 32px; background: Palette.panel; border-color: Palette.border; border-width: 1px;
                                        Text { text: root.queue-options[root.queue-index]; horizontal-alignment: center; vertical-alignment: center; font-size: 11px; font-weight: 700; color: Palette.text-primary; }
                                    }
                                    ToolbarButton { text: "+"; min-width: 32px; height: 32px; icon-type: "plus"; enabled: root.queue-index + 1 < root.queue-options.length; clicked => { root.queue-index += 1; } }
                                }
                            }
                        }
                        VerticalLayout {
                            spacing: 4px;
                            Text { text: "Save To"; font-size: 10px; color: Palette.text-dim; }
                            HorizontalLayout {
                                spacing: 8px;
                                StandardInput { width: 100%; text: root.output-dir; edited(t) => { root.output-dir = t; root.preview-update(root.urls-text, root.output-dir, root.category); } }
                                ToolbarButton { text: "..."; min-width: 40px; height: 32px; clicked => { root.choose-folder(); } }
                            }
                        }
                    }
                }
            }
        }

        Rectangle {
            height: 64px; background: Palette.panel;
            HorizontalLayout {
                padding-left: 20px; padding-right: 20px; spacing: 12px; alignment: end;
                ToolbarButton { text: "CLOSE"; height: 36px; clicked => { root.close-dialog(); } }
                ToolbarButton { text: "QUEUE ALL"; height: 36px; clicked => { root.queue-all(root.urls-text, root.output-dir, root.queue-index, root.category); } }
                ToolbarButton { text: "START ALL"; active: true; height: 36px; clicked => { root.start-all(root.urls-text, root.output-dir, root.queue-index, root.category); } }
            }
            Rectangle { y: 0; width: 100%; height: 1px; background: Palette.border; }
        }
    }
}
