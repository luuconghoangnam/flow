export component EditDownloadDialog inherits Window {
    width: 540px; height: 392px;
    title: "Edit Download";
    background: #ece9d8;

    in-out property <string> file-name: "";
    in-out property <string> output-dir: "";
    in-out property <int> priority: 0; // 0: Normal, 1: High, -1: Low

    callback save(string, string, int);
    callback cancel();
    callback choose-folder();
    callback set-priority(int);

    VerticalLayout {
        padding: 0; spacing: 0;
        
        Rectangle {
            height: 34px; background: #0a246a;
            HorizontalLayout {
                padding-left: 12px; padding-right: 12px;
                alignment: center;
                Text { text: "Edit Download Properties"; font-size: 13px; font-weight: 700; color: white; }
                Rectangle { width: 100%; }
            }
            Rectangle { y: parent.height - 1px; width: 100%; height: 1px; background: #7f9db9; }
        }

        VerticalLayout {
            padding: 14px; spacing: 12px;
            Rectangle {
                height: 52px;
                background: #f7f3e8;
                border-color: #c3b78f;
                border-width: 1px;
                VerticalLayout {
                    padding-left: 10px; padding-right: 10px; padding-top: 6px; padding-bottom: 6px;
                    spacing: 2px;
                    Text { text: "Change file name, save folder, or queue priority for the selected download."; font-size: 11px; color: #2b2b2b; }
                    Text { text: "These values are applied to the selected item immediately after saving."; font-size: 10px; color: #5a5a5a; }
                }
            }

            VerticalLayout {
                spacing: 4px;
                Text { text: "File Name"; font-size: 11px; font-weight: 600; color: #2b2b2b; }
                StandardInput { width: 100%; text: root.file-name; placeholder: "Enter file name..."; edited(t) => { root.file-name = t; } }
            }

            VerticalLayout {
                spacing: 4px;
                Text { text: "Save To"; font-size: 11px; font-weight: 600; color: #2b2b2b; }
                HorizontalLayout {
                    spacing: 6px;
                    StandardInput { width: 100%; text: root.output-dir; placeholder: "Select folder..."; edited(t) => { root.output-dir = t; } }
                    ToolbarButton { text: "Browse..."; min-width: 80px; height: 30px; icon-type: "open"; clicked => { root.choose-folder(); } }
                }
            }

            VerticalLayout {
                spacing: 4px;
                Text { text: "Priority"; font-size: 11px; font-weight: 600; color: #2b2b2b; }
                HorizontalLayout {
                    spacing: 6px;
                    ToolbarButton { text: "Low"; min-width: 64px; height: 28px; active: root.priority == -1; clicked => { root.set-priority(-1); } }
                    ToolbarButton { text: "Normal"; min-width: 74px; height: 28px; active: root.priority == 0; clicked => { root.set-priority(0); } }
                    ToolbarButton { text: "High"; min-width: 64px; height: 28px; active: root.priority == 1; clicked => { root.set-priority(1); } }
                    Rectangle { width: 100%; }
                }
            }

            Rectangle { height: 100%; }
        }

        Rectangle {
            height: 46px; background: #ece9d8;
            HorizontalLayout {
                padding-left: 14px; padding-right: 14px; padding-top: 8px; padding-bottom: 8px;
                spacing: 8px;
                Rectangle { width: 100%; }
                ToolbarButton { text: "OK"; min-width: 78px; height: 28px; clicked => { root.save(root.file-name, root.output-dir, root.priority); } }
                ToolbarButton { text: "Cancel"; min-width: 78px; height: 28px; clicked => { root.cancel(); } }
            }
            Rectangle { y: 0; width: 100%; height: 1px; background: #aca899; }
        }
    }
}

export component FileChecksumDialog inherits Window {
    width: 720px; height: 460px;
    title: "File Checksum";
    background: #ece9d8;

    in property <[FileChecksumRow]> rows: [];
    in property <string> status-text: "Preparing checksum verification...";
    callback close-dialog();

    VerticalLayout {
        padding: 0; spacing: 0;

        Rectangle {
            height: 34px; background: #0a246a;
            HorizontalLayout {
                padding-left: 12px; padding-right: 12px;
                Text { text: "File Checksum"; font-size: 13px; font-weight: 700; color: white; }
                Rectangle { width: 100%; }
            }
            Rectangle { y: parent.height - 1px; width: 100%; height: 1px; background: #7f9db9; }
        }

        VerticalLayout {
            padding: 14px; spacing: 10px;
            Rectangle {
                height: 46px;
                background: #f7f3e8;
                border-color: #c3b78f;
                border-width: 1px;
                VerticalLayout {
                    padding-left: 10px; padding-right: 10px; padding-top: 6px; padding-bottom: 6px;
                    Text { text: "Verify SHA-256 for selected finished downloads."; font-size: 11px; color: #2b2b2b; }
                    Text { text: root.status-text; font-size: 10px; color: #5a5a5a; }
                }
            }
            Rectangle {
                border-width: 1px;
                border-color: #7f9db9;
                background: white;
                VerticalLayout {
                    spacing: 0;
                    Rectangle {
                        height: 28px;
                        background: #eef3fb;
                        HorizontalLayout {
                            padding-left: 8px; padding-right: 8px;
                            Text { text: "File"; width: 170px; font-size: 10px; font-weight: 700; color: #1f2d4d; }
                            Text { text: "Expected"; width: 170px; font-size: 10px; font-weight: 700; color: #1f2d4d; }
                            Text { text: "Actual"; width: 170px; font-size: 10px; font-weight: 700; color: #1f2d4d; }
                            Text { text: "Result"; width: 90px; font-size: 10px; font-weight: 700; color: #1f2d4d; }
                        }
                    }
                    ScrollView {
                        VerticalLayout {
                            for row[index] in root.rows: Rectangle {
                                height: 34px;
                                background: Math.mod(index, 2) == 0 ? #ffffff : #f9fbff;
                                HorizontalLayout {
                                    padding-left: 8px; padding-right: 8px;
                                    Text { text: row.file_name; width: 170px; font-size: 10px; color: #202020; }
                                    Text { text: row.expected; width: 170px; font-size: 10px; color: #2f2f2f; }
                                    Text { text: row.actual; width: 170px; font-size: 10px; color: #2f2f2f; }
                                    Text { text: row.result; width: 90px; font-size: 10px; color: row.result == "Match" ? #1f7a3a : (row.result == "Checking" ? #8a6b16 : #a02727); }
                                }
                            }
                        }
                    }
                }
            }
        }

        Rectangle {
            height: 46px; background: #ece9d8;
            HorizontalLayout {
                padding-left: 14px; padding-right: 14px; padding-top: 8px; padding-bottom: 8px;
                Rectangle { width: 100%; }
                ToolbarButton { text: "Close"; min-width: 78px; height: 28px; clicked => { root.close-dialog(); } }
            }
            Rectangle { y: 0; width: 100%; height: 1px; background: #aca899; }
        }
    }
}

export component QueueSettingsDialog inherits Window {
    width: 480px; height: 360px;
    title: "Queue Settings";
    background: Palette.bg;

    in property <string> queue-name: "Main";
    in property <int> max-concurrent: 3;
    in property <bool> stop-on-empty: false;

    callback save(string, int, bool);
    callback cancel();

    VerticalLayout {
        padding: 0; spacing: 0;
        
        // Header
        Rectangle {
            height: 48px; background: Palette.panel;
            HorizontalLayout {
                padding-left: 20px; padding-right: 20px;
                alignment: center;
                Text { text: "Queue Settings"; font-size: 14px; font-weight: 700; color: Palette.text-primary; }
                Rectangle { width: 100%; }
            }
            Rectangle { y: parent.height - 1px; width: 100%; height: 1px; background: Palette.border; }
        }

        // Content
        ScrollView {
            VerticalLayout {
                padding: 20px; spacing: 16px;
                
                // Queue Name
                VerticalLayout {
                    spacing: 6px;
                    Text { text: "Queue Name"; font-size: 11px; font-weight: 600; color: Palette.text-light; letter-spacing: 0.3px; }
                    StandardInput { 
                        width: 100%; 
                        text: root.queue-name; 
                        placeholder: "Enter queue name..."; 
                    }
                }
                
                // Max Concurrent
                VerticalLayout {
                    spacing: 6px;
                    Text { text: "Max Concurrent Downloads"; font-size: 11px; font-weight: 600; color: Palette.text-light; letter-spacing: 0.3px; }
                    HorizontalLayout {
                        spacing: 12px;
                        alignment: start;
                        ToolbarButton { text: "-"; min-width: 36px; height: 32px; icon-type: "minus"; }
                        Text { 
                            text: root.max-concurrent; 
                            width: 50px; 
                            vertical-alignment: center; 
                            horizontal-alignment: center; 
                            font-size: 12px; 
                            font-weight: 600;
                            color: Palette.accent-primary;
                        }
                        ToolbarButton { text: "+"; min-width: 36px; height: 32px; icon-type: "plus"; }
                        Text { text: "(1-10)"; vertical-alignment: center; font-size: 10px; color: Palette.text-muted; }
                    }
                }
                
                // Stop on Empty
                VerticalLayout {
                    spacing: 10px;
                    Text { text: "Options"; font-size: 11px; font-weight: 600; color: Palette.text-light; letter-spacing: 0.3px; }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        Rectangle {
                            width: 20px; height: 20px;
                            background: root.stop-on-empty ? Palette.accent-primary : Palette.panel;
                            border-color: Palette.border;
                            border-width: 1px;
                        }
                        Text { 
                            text: "Stop queue when empty"; 
                            vertical-alignment: center; 
                            font-size: 11px; 
                            color: Palette.text-primary;
                        }
                    }
                }
                
                Rectangle { height: 100%; }
            }
        }

        // Footer with Buttons
        Rectangle {
            height: 52px; background: Palette.panel;
            HorizontalLayout {
                padding-left: 20px; padding-right: 20px; padding-top: 12px; padding-bottom: 12px;
                spacing: 8px;
                alignment: end;
                Rectangle { width: 100%; }
                ToolbarButton { text: "Save"; height: 36px; clicked => { root.save(root.queue-name, root.max-concurrent, root.stop-on-empty); } }
                ToolbarButton { text: "Cancel"; height: 36px; clicked => { root.cancel(); } }
            }
            Rectangle { y: 0; width: 100%; height: 1px; background: Palette.border; }
        }
    }
}

export component PerHostSettingsDialog inherits Window {
    width: 620px; height: 420px;
    title: "Per-host Settings";
    background: Palette.bg;

    in property <string> entry-position: "0/0";
    in property <string> dialog-summary: "No host rule selected";
    in property <bool> has-entry: false;
    in property <bool> can-go-prev: false;
    in property <bool> can-go-next: false;
    in property <bool> can-delete-entry: false;
    in-out property <string> host-pattern: "";
    in-out property <string> username: "";
    in-out property <string> password: "";
    in-out property <string> user-agent: "";
    in-out property <string> thread-count-text: "";

    callback prev-entry();
    callback next-entry();
    callback add-entry();
    callback save-entry(string, string, string, string, string);
    callback delete-entry();
    callback close-dialog();

    VerticalLayout {
        padding: 0; spacing: 0;

        Rectangle {
            height: 52px; background: Palette.panel;
            HorizontalLayout {
                padding-left: 16px; padding-right: 16px;
                Text { text: "Per-host Settings"; font-size: 14px; font-weight: 700; color: Palette.text-primary; }
                Rectangle { width: 100%; }
                Text { text: "Entry " + root.entry-position; font-size: 11px; color: Palette.text-muted; }
            }
            Rectangle { y: parent.height - 1px; width: 100%; height: 1px; background: Palette.border; }
        }

        VerticalLayout {
            padding: 16px; spacing: 10px;

            HorizontalLayout {
                spacing: 8px;
                ToolbarButton { text: "Prev"; height: 30px; enabled: root.can-go-prev; clicked => { root.prev-entry(); } }
                ToolbarButton { text: "Next"; height: 30px; enabled: root.can-go-next; clicked => { root.next-entry(); } }
                ToolbarButton { text: "Add New"; height: 30px; clicked => { root.add-entry(); } }
                Rectangle { width: 100%; }
            }

            Rectangle {
                height: 56px;
                background: Palette.panel;
                border-color: Palette.border;
                border-width: 1px;
                VerticalLayout {
                    padding-left: 12px; padding-right: 12px; padding-top: 8px; padding-bottom: 8px;
                    spacing: 4px;
                    Text { text: root.dialog-summary; font-size: 11px; font-weight: 600; color: Palette.text-primary; overflow: elide; }
                    Text { text: root.has-entry ? "Set credentials, custom user agent, or thread limits for this host rule." : "No rules yet. Click Add New to create your first host-specific override."; font-size: 10px; color: Palette.text-muted; overflow: elide; }
                }
            }

            VerticalLayout {
                spacing: 6px;
                Text { text: "Host Pattern"; font-size: 11px; color: Palette.text-muted; }
                StandardInput { width: 100%; text: root.host-pattern; placeholder: "*.example.com"; edited(t) => { root.host-pattern = t; } }
            }

            VerticalLayout {
                spacing: 6px;
                Text { text: "Username"; font-size: 11px; color: Palette.text-muted; }
                StandardInput { width: 100%; text: root.username; placeholder: "optional"; edited(t) => { root.username = t; } }
            }

            VerticalLayout {
                spacing: 6px;
                Text { text: "Password"; font-size: 11px; color: Palette.text-muted; }
                StandardInput { width: 100%; text: root.password; placeholder: "optional"; edited(t) => { root.password = t; } }
            }

            VerticalLayout {
                spacing: 6px;
                Text { text: "User Agent"; font-size: 11px; color: Palette.text-muted; }
                StandardInput { width: 100%; text: root.user-agent; placeholder: "optional"; edited(t) => { root.user-agent = t; } }
            }

            VerticalLayout {
                spacing: 6px;
                Text { text: "Thread Count"; font-size: 11px; color: Palette.text-muted; }
                StandardInput { width: 120px; text: root.thread-count-text; placeholder: "optional"; edited(t) => { root.thread-count-text = t; } }
            }

            Rectangle { height: 100%; }
        }

        Rectangle {
            height: 56px; background: Palette.panel;
            HorizontalLayout {
                padding-left: 16px; padding-right: 16px; spacing: 8px;
                ToolbarButton { text: "Delete"; height: 34px; enabled: root.can-delete-entry; clicked => { root.delete-entry(); } }
                Rectangle { width: 100%; }
                ToolbarButton { text: "Save"; height: 34px; clicked => { root.save-entry(root.host-pattern, root.username, root.password, root.user-agent, root.thread-count-text); } }
                ToolbarButton { text: "Close"; height: 34px; clicked => { root.close-dialog(); } }
            }
            Rectangle { y: 0; width: 100%; height: 1px; background: Palette.border; }
        }
    }
}

export component BatchDownloadDialog inherits Window {
    width: 700px; height: 520px;
    title: "Batch Download";
    background: Palette.bg;

    in-out property <string> urls-text: "";
    in-out property <string> output-dir: "";
    in property <int> parsed-url-count: 0;
    in property <string> resolved-output-dir: "";
    in property <string> category-hint: "General";
    in property <string> dialog-hint: "Paste one or more HTTP/HTTPS links.";
    in property <bool> urls-valid: true;
    in property <[string]> queue-options: ["Main"];
    in-out property <int> queue-index: 0;
    in-out property <string> category: "General";

    callback choose-folder();
    callback queue-all(string, string, int, string);
    callback start-all(string, string, int, string);
    callback preview-update(string, string, string);
    callback close-dialog();

    VerticalLayout {
        padding: 0; spacing: 0;

        Rectangle {
            height: 50px; background: Palette.panel;
            HorizontalLayout {
                padding-left: 16px; padding-right: 16px;
                Text { text: "Batch Download"; font-size: 14px; font-weight: 700; color: Palette.text-primary; }
                Rectangle { width: 100%; }
            }
            Rectangle { y: parent.height - 1px; width: 100%; height: 1px; background: Palette.border; }
        }

        VerticalLayout {
            padding: 16px; spacing: 10px;

            Rectangle {
                height: 64px;
                background: Palette.panel;
                border-color: root.urls-valid ? Palette.border : Palette.error;
                border-width: 1px;
                VerticalLayout {
                    padding-left: 12px; padding-right: 12px; padding-top: 8px; padding-bottom: 8px;
                    spacing: 4px;
                    Text { text: root.dialog-hint; font-size: 11px; font-weight: 600; color: root.urls-valid ? Palette.text-primary : Palette.error; overflow: elide; }
                    Text { text: "Detected links: " + root.parsed-url-count; font-size: 10px; color: Palette.text-muted; overflow: elide; }
                    Text { text: "Save to: " + root.resolved-output-dir + "  •  Category: " + root.category-hint; font-size: 10px; color: Palette.text-muted; overflow: elide; }
                }
            }

            Text { text: "Paste URLs (one per line, comma, or space separated)"; font-size: 11px; color: Palette.text-muted; }
            Rectangle {
                height: 220px;
                border-width: 1px;
                border-color: Palette.border;
                background: Palette.panel;
                ScrollView {
                    TextInput {
                        width: parent.width - 12px;
                        text <=> root.urls-text;
                        edited => {
                            root.preview-update(root.urls-text, root.output-dir, root.category);
                        }
                        color: Palette.text-primary;
                        selection-foreground-color: Palette.text-primary;
                        selection-background-color: Palette.selection-bg;
                        single-line: false;
                    }
                }
            }

            HorizontalLayout {
                spacing: 8px;
                Text { text: "Category"; width: 80px; vertical-alignment: center; font-size: 11px; color: Palette.text-muted; }
                StandardInput { width: 180px; text: root.category; placeholder: "General"; edited(t) => { root.category = t; root.preview-update(root.urls-text, root.output-dir, root.category); } }
                Rectangle { width: 100%; }
            }

            HorizontalLayout {
                spacing: 8px;
                Text { text: "Queue"; width: 80px; vertical-alignment: center; font-size: 11px; color: Palette.text-muted; }
                ToolbarButton { text: "-"; min-width: 36px; height: 30px; icon-type: "minus"; enabled: root.queue-index > 0; clicked => { root.queue-index -= 1; } }
                Rectangle {
                    width: 220px; height: 30px;
                    background: Palette.panel;
                    border-color: Palette.border;
                    border-width: 1px;
                    Text {
                        text: root.queue-index >= 0 && root.queue-index < root.queue-options.length ? root.queue-options[root.queue-index] : "Main";
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        font-size: 11px;
                        color: Palette.text-primary;
                    }
                }
                ToolbarButton { text: "+"; min-width: 36px; height: 30px; icon-type: "plus"; enabled: root.queue-index + 1 < root.queue-options.length; clicked => { root.queue-index += 1; } }
                Rectangle { width: 100%; }
            }

            HorizontalLayout {
                spacing: 8px;
                Text { text: "Save To"; width: 80px; vertical-alignment: center; font-size: 11px; color: Palette.text-muted; }
                StandardInput { width: 100%; text: root.output-dir; placeholder: "Downloads folder"; edited(t) => { root.output-dir = t; root.preview-update(root.urls-text, root.output-dir, root.category); } }
                ToolbarButton { text: "..."; min-width: 36px; height: 30px; icon-type: "open"; clicked => { root.choose-folder(); } }
            }
        }

        Rectangle {
            height: 56px; background: Palette.panel;
            HorizontalLayout {
                padding-left: 16px; padding-right: 16px; spacing: 8px;
                ToolbarButton { text: "Queue All"; height: 34px; clicked => { root.queue-all(root.urls-text, root.output-dir, root.queue-index, root.category); } }
                ToolbarButton { text: "Start All"; height: 34px; clicked => { root.start-all(root.urls-text, root.output-dir, root.queue-index, root.category); } }
                Rectangle { width: 100%; }
                ToolbarButton { text: "Close"; height: 34px; clicked => { root.close-dialog(); } }
            }
            Rectangle { y: 0; width: 100%; height: 1px; background: Palette.border; }
        }
    }
}
