import { LineEdit, ScrollView } from "std-widgets.slint";

export struct DownloadRow {
    checked: bool,
    name: string,
    category: string,
    size: string,
    status: string,
    speed: string,
    time-left: string,
    date-added: string,
    description: string,
    progress: int,
    has-progress: bool,
    is-error: bool,
}

global Palette {
    out property <color> bg: #F5F7FA;
    out property <color> surface: #FFFFFF;
    out property <color> panel: #F0F2F5;
    out property <color> border: #E1E4E8;
    out property <color> text-primary: #1F2937;
    out property <color> text-muted: #6B7280;
    out property <color> text-light: #9CA3AF;
    out property <color> accent-primary: #3B82F6;
    out property <color> accent-hover: #2563EB;
    out property <color> accent-active: #1D4ED8;
    out property <color> success: #10B981;
    out property <color> warning: #F59E0B;
    out property <color> error: #EF4444;
    out property <color> selection-bg: #DBEAFE;
    out property <color> selection-border: #93C5FD;
}

component IconAdd inherits Rectangle {
    width: 24px; height: 24px;
    Rectangle { width: 12px; height: 2px; y: 11px; x: 6px; background: #3B82F6; }
    Rectangle { width: 2px; height: 12px; x: 11px; y: 6px; background: #3B82F6; }
}

component IconResume inherits Rectangle {
    width: 24px; height: 24px;
    Path {
        viewbox-width: 100; viewbox-height: 100;
        commands: "M 30,20 L 80,50 L 30,80 Z";
        fill: #10B981;
    }
}

component IconStop inherits Rectangle {
    width: 24px; height: 24px;
    Rectangle { width: 10px; height: 10px; x: 7px; y: 7px; background: #EF4444; border-radius: 2px; }
}

component IconStopAll inherits Rectangle {
    width: 24px; height: 24px;
    Rectangle { x: 3px; width: 8px; height: 10px; background: #EF4444; border-radius: 1px; }
    Rectangle { x: 13px; width: 8px; height: 10px; background: #EF4444; border-radius: 1px; }
}

component IconDelete inherits Rectangle {
    width: 24px; height: 24px;
    Path {
        viewbox-width: 100; viewbox-height: 100;
        commands: "M 20,20 L 80,80 M 80,20 L 20,80";
        stroke: #EF4444;
        stroke-width: 6px;
    }
}

component IconCleanup inherits Rectangle {
    width: 24px; height: 24px;
    Rectangle { width: 12px; height: 3px; background: #6B7280; y: 17px; x: 6px; border-radius: 1px; }
    Rectangle { width: 8px; height: 8px; background: #9CA3AF; y: 8px; x: 8px; border-radius: 1px; }
}

component IconOptions inherits Rectangle {
    width: 24px; height: 24px;
    Rectangle { width: 3px; height: 3px; background: #3B82F6; x: 2px; y: 10px; border-radius: 1px; }
    Rectangle { width: 3px; height: 3px; background: #3B82F6; x: 10px; y: 10px; border-radius: 1px; }
    Rectangle { width: 3px; height: 3px; background: #3B82F6; x: 18px; y: 10px; border-radius: 1px; }
}

component IconScheduler inherits Rectangle {
    width: 24px; height: 24px;
    Rectangle { width: 14px; height: 14px; border-width: 2px; border-color: #3B82F6; border-radius: 2px; x: 5px; y: 5px; }
    Rectangle { width: 1px; height: 4px; background: #3B82F6; y: 7px; x: 11px; }
    Rectangle { width: 3px; height: 1px; background: #3B82F6; x: 13px; y: 12px; }
}

component IconOpen inherits Rectangle {
    width: 24px; height: 24px;
    Path {
        viewbox-width: 100; viewbox-height: 100;
        commands: "M 30,20 L 30,70 L 80,70 L 80,35 L 65,20 Z M 65,20 L 65,35 L 80,35";
        stroke: #3B82F6;
        stroke-width: 3px;
    }
}

component IconFolder inherits Rectangle {
    width: 24px; height: 24px;
    Path {
        viewbox-width: 100; viewbox-height: 100;
        commands: "M 10,30 L 10,80 L 90,80 L 90,35 L 40,35 L 30,20 L 10,20 Z";
        stroke: #3B82F6;
        stroke-width: 3px;
    }
}

component IconUp inherits Rectangle {
    width: 24px; height: 24px;
    Path {
        viewbox-width: 100; viewbox-height: 100;
        commands: "M 50,20 L 30,50 L 40,50 L 40,80 L 60,80 L 60,50 L 70,50 Z";
        fill: #6B7280;
    }
}

component IconDown inherits Rectangle {
    width: 24px; height: 24px;
    Path {
        viewbox-width: 100; viewbox-height: 100;
        commands: "M 50,80 L 30,50 L 40,50 L 40,20 L 60,20 L 60,50 L 70,50 Z";
        fill: #6B7280;
    }
}

component IconRetry inherits Rectangle {
    width: 24px; height: 24px;
    Path {
        viewbox-width: 100; viewbox-height: 100;
        commands: "M 70,30 L 80,30 L 75,15 L 65,25 L 70,25 A 30,30 0 1 0 30,60";
        stroke: #10B981;
        stroke-width: 3px;
    }
}

component IconPlus inherits Rectangle {
    width: 24px; height: 24px;
    Rectangle { width: 12px; height: 2px; y: 11px; x: 6px; background: #3B82F6; }
    Rectangle { width: 2px; height: 12px; x: 11px; y: 6px; background: #3B82F6; }
}

component IconMinus inherits Rectangle {
    width: 24px; height: 24px;
    Rectangle { width: 12px; height: 2px; y: 11px; x: 6px; background: #EF4444; }
}

component ToolbarButton inherits Rectangle {
    in property <string> text;
    in property <bool> active: false;
    in property <bool> enabled: true;
    in property <string> icon-type;
    callback clicked;
    height: 32px;
    min-width: 36px;
    
    background: !enabled ? transparent : (ta.pressed ? Palette.accent-active : (ta.has-hover ? Palette.accent-hover : (active ? Palette.accent-primary : Palette.panel)));
    border-color: active ? Palette.accent-primary : transparent;
    border-width: active ? 1px : 0px;
    border-radius: 4px;

    HorizontalLayout {
        alignment: center;
        spacing: 1px;
        padding: 2px;
        Rectangle {
            height: 20px; width: 20px;
            opacity: root.enabled ? 1.0 : 0.4;
            if icon-type == "add": IconAdd {}
            if icon-type == "resume": IconResume {}
            if icon-type == "stop": IconStop {}
            if icon-type == "stop-all": IconStopAll {}
            if icon-type == "delete": IconDelete {}
            if icon-type == "cleanup": IconCleanup {}
            if icon-type == "options": IconOptions {}
            if icon-type == "scheduler": IconScheduler {}
            if icon-type == "open": IconOpen {}
            if icon-type == "folder": IconFolder {}
            if icon-type == "up": IconUp {}
            if icon-type == "down": IconDown {}
            if icon-type == "retry": IconRetry {}
            if icon-type == "plus": IconPlus {}
            if icon-type == "minus": IconMinus {}
        }
        if text != "": Text { 
            text: root.text; 
            color: !enabled ? Palette.text-light : (active || ta.has-hover ? #FFFFFF : Palette.text-primary); 
            font-size: 10px; 
            font-weight: 600;
            horizontal-alignment: center; 
        }
    }
    
    ta := TouchArea { 
        width: 100%; height: 100%; 
        clicked => { if root.enabled { root.clicked(); } } 
    }
}

component TreeItem inherits Rectangle {
    in property <string> text;
    in property <bool> active: false;
    in property <string> icon-type;
    callback clicked <=> ta.clicked;
    height: 28px;
    background: active ? Palette.selection-bg : (ta.has-hover ? #E8EFFE : transparent);
    border-color: active ? Palette.accent-primary : transparent;
    border-width: active ? 1px : 0px;
    border-radius: 3px;
    
    HorizontalLayout {
        padding-left: 6px; padding-right: 6px;
        spacing: 6px;
        alignment: start;
        Rectangle { 
            width: 12px; height: 12px; 
            VerticalLayout {
                alignment: center;
                if icon-type == "all": Rectangle { width: 8px; height: 8px; border-width: 1px; border-color: Palette.accent-primary; border-radius: 1px; }
                if icon-type == "unfinished": Rectangle { width: 8px; height: 8px; background: Palette.warning; border-radius: 1px; }
                if icon-type == "finished": Rectangle { width: 8px; height: 8px; background: Palette.success; border-radius: 1px; }
                if icon-type == "queue": Rectangle { width: 8px; height: 8px; border-width: 1px; border-color: Palette.text-muted; border-radius: 1px; }
            }
        }
        Text { 
            text: root.text; 
            color: Palette.text-primary; 
            vertical-alignment: center; 
            font-size: 11px; 
            font-weight: active ? 700 : 500;
        }
    }
    ta := TouchArea { width: 100%; height: 100%; }
}

component StandardInput inherits Rectangle {
    in property <string> text;
    in property <string> placeholder;
    callback edited(string);
    height: 32px;
    background: Palette.surface;
    border-color: editor.has-focus ? Palette.accent-primary : Palette.border;
    border-width: editor.has-focus ? 2px : 1px;
    border-radius: 6px;
    
    editor := LineEdit { 
        x: 8px; y: 0; width: parent.width - 16px; height: parent.height;
        text: root.text; 
        placeholder-text: root.placeholder; 
        edited(t) => { root.edited(t); } 
    }
    
    ta := TouchArea { width: 100%; height: 100%; }
}

export component MainWindow inherits Window {
    width: 1200px;
    height: 680px;
    title: "Flow Download Manager";
    background: Palette.bg;
    default-font-family: "Segoe UI";

    in property <[DownloadRow]> download-rows: [];
    in property <[string]> queue-groups: ["Main"];
    in property <int> selected-queue-index: 0;
    in property <string> queue-config-summary: "";
    in property <string> queue-name-text: "Main";
    in property <string> browser-extension-id-text: "";
    in property <string> default-folder-text: "";
    in property <int> selected-download-index: -1;
    in property <string> status-message: "Ready";
    in property <bool> show-delete-confirm: false;
    
    // Settings properties
    in property <int> thread-count: 4;
    in property <int> max-concurrent: 2;
    in property <bool> auto-start-enabled: false;
    in property <bool> system-tray-enabled: false;
    in property <bool> browser-integration-enabled: false;
    in property <bool> clipboard-monitoring-enabled: false;
    in property <int> proxy-mode: 0; // 0: Direct, 1: System, 2: Manual

    callback retry-failed(); callback cleanup-finished(); callback select-queue(index: int); callback create-queue();
    callback toggle-queue(); callback delete-queue(); callback select-download(index: int); callback move-download-up();
    callback move-download-down(); callback requeue-download(); callback queue-max-minus(); callback queue-max-plus();
    callback queue-toggle-stop-on-empty(); callback queue-name-changed(value: string); callback toggle-auto-start();
    callback add-url(); callback resume-selected(); callback stop-selected(); callback stop-all(); callback delete-selected();
    callback request-delete-selected(); callback confirm-delete-selected(); callback cancel-delete-selected();
    callback open-selected(); callback open-selected-folder(); callback retry-selected();
    callback toggle-system-tray(); callback toggle-browser-integration(); callback toggle-clipboard-monitoring();
    callback settings-thread-minus(); callback settings-thread-plus(); callback settings-max-minus(); callback settings-max-plus();
    callback settings-use-downloads-folder(); callback register-browser-host();
    callback queue-create-new(); callback queue-rename(); callback queue-delete-confirm();
    callback proxy-mode-changed(mode: int); callback proxy-test-connection();

    property <int> current-tab: 0; // 0 downloads, 1 scheduler, 2 settings

    VerticalLayout {
        spacing: 0;

        // Menu Bar
        Rectangle {
            height: 32px; background: Palette.surface;
            HorizontalLayout { padding-left: 12px; padding-right: 12px; spacing: 20px;
                Text { text: "Tasks"; color: Palette.text-primary; font-size: 12px; font-weight: 600; vertical-alignment: center; }
                Text { text: "File"; color: Palette.text-primary; font-size: 12px; font-weight: 600; vertical-alignment: center; }
                Text { text: "Downloads"; color: Palette.text-primary; font-size: 12px; font-weight: 600; vertical-alignment: center; }
                Text { text: "View"; color: Palette.text-primary; font-size: 12px; font-weight: 600; vertical-alignment: center; }
                Text { text: "Help"; color: Palette.text-primary; font-size: 12px; font-weight: 600; vertical-alignment: center; }
            }
        }

        // Toolbar
        Rectangle {
            height: 72px; background: Palette.panel;
            HorizontalLayout { 
                padding: 8px; spacing: 4px;
                ToolbarButton { text: "Add URL"; icon-type: "add"; clicked => { root.add-url(); current-tab = 0; } }
                Rectangle { width: 8px; }
                Rectangle { width: 1px; height: 48px; background: Palette.border; }
                Rectangle { width: 8px; }
                ToolbarButton { text: "Resume"; icon-type: "resume"; enabled: root.selected-download-index >= 0; clicked => { root.resume-selected(); current-tab = 0; } }
                ToolbarButton { text: "Stop"; icon-type: "stop"; enabled: root.selected-download-index >= 0; clicked => { root.stop-selected(); current-tab = 0; } }
                ToolbarButton { text: "Stop All"; icon-type: "stop-all"; clicked => { root.stop-all(); current-tab = 0; } }
                Rectangle { width: 8px; }
                Rectangle { width: 1px; height: 48px; background: Palette.border; }
                Rectangle { width: 8px; }
                ToolbarButton { text: "Delete"; icon-type: "delete"; enabled: root.selected-download-index >= 0; clicked => { root.request-delete-selected(); current-tab = 0; } }
                ToolbarButton { text: "Cleanup"; icon-type: "cleanup"; clicked => { root.cleanup-finished(); current-tab = 0; } }
                Rectangle { width: 8px; }
                Rectangle { width: 1px; height: 48px; background: Palette.border; }
                Rectangle { width: 8px; }
                ToolbarButton { text: "Open"; icon-type: "open"; enabled: root.selected-download-index >= 0; clicked => { root.open-selected(); } }
                ToolbarButton { text: "Open Folder"; icon-type: "folder"; enabled: root.selected-download-index >= 0; clicked => { root.open-selected-folder(); } }
                Rectangle { width: 8px; }
                Rectangle { width: 1px; height: 48px; background: Palette.border; }
                Rectangle { width: 8px; }
                ToolbarButton { text: "Options"; icon-type: "options"; active: current-tab == 2; clicked => { current-tab = 2; } }
                ToolbarButton { text: "Scheduler"; icon-type: "scheduler"; active: current-tab == 1; clicked => { current-tab = 1; } }
                Rectangle { width: 100%; }
            }
        }

        HorizontalLayout {
            // Sidebar
            Rectangle {
                width: 200px; background: Palette.surface;
                VerticalLayout {
                    padding-left: 6px; padding-right: 6px; padding-top: 8px; padding-bottom: 8px;
                    spacing: 3px;
                    
                    Text { text: "CATEGORIES"; font-size: 10px; font-weight: 700; color: Palette.text-light; letter-spacing: 0.5px; }
                    TreeItem { text: "All Downloads"; icon-type: "all"; active: true; }
                    TreeItem { text: "Unfinished"; icon-type: "unfinished"; }
                    TreeItem { text: "Finished"; icon-type: "finished"; }
                    
                    Rectangle { height: 8px; }
                    
                    HorizontalLayout {
                        spacing: 4px; alignment: start;
                        Text { text: "QUEUES"; font-size: 10px; font-weight: 700; color: Palette.text-light; letter-spacing: 0.5px; }
                        Rectangle { width: 100%; }
                    }
                    
                    ScrollView {
                        VerticalLayout {
                            spacing: 1px;
                            for q[i] in root.queue-groups: Rectangle {
                                height: 28px;
                                background: i == root.selected-queue-index ? Palette.selection-bg : transparent;
                                border-color: i == root.selected-queue-index ? Palette.accent-primary : transparent;
                                border-width: i == root.selected-queue-index ? 1px : 0px;
                                border-radius: 3px;
                                
                                HorizontalLayout {
                                    padding-left: 6px; padding-right: 6px; spacing: 6px;
                                    Rectangle { 
                                        width: 12px; height: 12px; 
                                        VerticalLayout { alignment: center;
                                            Rectangle { width: 8px; height: 8px; border-width: 1px; border-color: Palette.text-muted; border-radius: 1px; }
                                        }
                                    }
                                    Text { 
                                        text: q; 
                                        color: Palette.text-primary; 
                                        vertical-alignment: center; 
                                        font-size: 11px; 
                                        font-weight: i == root.selected-queue-index ? 700 : 500;
                                        width: 100%;
                                    }
                                }
                                TouchArea { clicked => { root.select-queue(i); } }
                            }
                        }
                    }
                }
                Rectangle { x: parent.width - 1px; y: 0; width: 1px; height: 100%; background: Palette.border; }
            }

            // Main Content Area
            Rectangle {
                background: #FFFFFF;
                if current-tab == 0: VerticalLayout {
                    // Header for Table
                    Rectangle {
                        height: 36px; background: Palette.panel;
                        HorizontalLayout {
                            padding-left: 12px; spacing: 0;
                            Text { text: "File Name"; width: 320px; font-size: 11px; font-weight: 600; color: Palette.text-muted; vertical-alignment: center; }
                            Rectangle { width: 1px; background: Palette.border; }
                            Text { text: "Size"; width: 80px; font-size: 11px; font-weight: 600; color: Palette.text-muted; vertical-alignment: center; horizontal-alignment: center; }
                            Rectangle { width: 1px; background: Palette.border; }
                            Text { text: "Status"; width: 120px; font-size: 11px; font-weight: 600; color: Palette.text-muted; vertical-alignment: center; horizontal-alignment: center; }
                            Rectangle { width: 1px; background: Palette.border; }
                            Text { text: "Time Left"; width: 90px; font-size: 11px; font-weight: 600; color: Palette.text-muted; vertical-alignment: center; horizontal-alignment: center; }
                            Rectangle { width: 1px; background: Palette.border; }
                            Text { text: "Speed"; width: 100px; font-size: 11px; font-weight: 600; color: Palette.text-muted; vertical-alignment: center; horizontal-alignment: center; }
                            Rectangle { width: 1px; background: Palette.border; }
                            Text { text: "Date Added"; width: 140px; font-size: 11px; font-weight: 600; color: Palette.text-muted; vertical-alignment: center; horizontal-alignment: center; }
                            Rectangle { width: 1px; background: Palette.border; }
                            Text { text: "Description"; font-size: 11px; font-weight: 600; color: Palette.text-muted; vertical-alignment: center; }
                        }
                    }

                    // Table Body
                    ScrollView {
                        VerticalLayout {
                            padding: 0; spacing: 0;
                            for row[i] in root.download-rows: Rectangle {
                                height: 40px;
                                background: i == root.selected-download-index ? Palette.selection-bg : (Math.mod(i, 2) == 1 ? Palette.panel : Palette.surface);
                                
                                HorizontalLayout {
                                    padding-left: 12px; spacing: 0;
                                    Text { text: row.name; width: 320px; font-size: 11px; vertical-alignment: center; color: Palette.text-primary; overflow: elide; font-weight: 500; }
                                    Text { text: row.size; width: 80px; font-size: 11px; vertical-alignment: center; horizontal-alignment: right; color: Palette.text-muted; }
                                    VerticalLayout {
                                        width: 120px; alignment: center; padding-left: 6px; padding-right: 6px;
                                        Text { text: row.status; font-size: 10px; font-weight: 600; color: (row.is-error ? Palette.error : Palette.success); horizontal-alignment: center; }
                                        if row.has-progress: Rectangle {
                                            height: 4px; background: Palette.panel; border-radius: 2px;
                                            Rectangle { x: 0; width: parent.width * row.progress / 100; background: Palette.accent-primary; border-radius: 2px; height: 100%; }
                                        }
                                    }
                                    Text { text: row.time-left; width: 90px; font-size: 11px; vertical-alignment: center; horizontal-alignment: center; color: Palette.text-muted; }
                                    Text { text: row.speed; width: 100px; font-size: 11px; vertical-alignment: center; horizontal-alignment: center; color: Palette.text-muted; }
                                    Text { text: row.date-added; width: 140px; font-size: 11px; vertical-alignment: center; horizontal-alignment: center; color: Palette.text-muted; }
                                    Text { text: row.description; font-size: 10px; vertical-alignment: center; color: Palette.text-light; overflow: elide; }
                                }
                                TouchArea { clicked => { root.select-download(i); } }
                            }
                        }
                    }
                }
                
                if current-tab == 1: VerticalLayout {
                    padding: 20px; spacing: 18px;
                    ScrollView {
                        VerticalLayout {
                            padding: 0; spacing: 16px;
                            Text { text: "Queue Scheduler"; font-size: 20px; font-weight: 700; color: #004080; }
                            Rectangle { height: 1px; background: #D0D0D0; }
                            
                            Text { text: "Queue Name: " + root.queue-name-text; font-size: 13px; font-weight: 600; }
                            Text { text: root.queue-config-summary; font-size: 12px; color: #555; }
                            
                            Rectangle {
                                height: 1px; background: #D0D0D0;
                            }
                            
                            VerticalLayout {
                                spacing: 10px;
                                Text { text: "Queue Controls"; font-size: 12px; font-weight: 600; color: #333; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    ToolbarButton { text: "Start Queue"; icon-type: "resume"; height: 40px; clicked => { root.toggle-queue(); } }
                                    ToolbarButton { text: "Delete Queue"; icon-type: "delete"; height: 40px; clicked => { root.queue-delete-confirm(); } }
                                    ToolbarButton { text: "Rename"; height: 40px; clicked => { root.queue-rename(); } }
                                }
                            }
                            
                            Rectangle {
                                height: 1px; background: #D0D0D0;
                            }
                            
                            VerticalLayout {
                                spacing: 10px;
                                Text { text: "Selected Item Controls"; font-size: 12px; font-weight: 600; color: #333; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    ToolbarButton { text: "Move Up"; icon-type: "up"; enabled: root.selected-download-index > 0; height: 40px; clicked => { root.move-download-up(); } }
                                    ToolbarButton { text: "Move Down"; icon-type: "down"; enabled: root.selected-download-index >= 0; height: 40px; clicked => { root.move-download-down(); } }
                                    ToolbarButton { text: "Requeue"; icon-type: "retry"; enabled: root.selected-download-index >= 0; height: 40px; clicked => { root.requeue-download(); } }
                                }
                            }
                            
                            Rectangle {
                                height: 1px; background: #D0D0D0;
                            }
                            
                            VerticalLayout {
                                spacing: 10px;
                                Text { text: "Queue Configuration"; font-size: 12px; font-weight: 600; color: #333; }
                                HorizontalLayout {
                                    spacing: 12px; alignment: start;
                                    Text { text: "Max Concurrent:"; width: 120px; vertical-alignment: center; font-size: 11px; }
                                    ToolbarButton { text: "-"; min-width: 32px; icon-type: "minus"; height: 26px; clicked => { root.queue-max-minus(); } }
                                    Text { text: root.max-concurrent; width: 40px; vertical-alignment: center; horizontal-alignment: center; font-size: 11px; font-weight: 600; }
                                    ToolbarButton { text: "+"; min-width: 32px; icon-type: "plus"; height: 26px; clicked => { root.queue-max-plus(); } }
                                }
                                HorizontalLayout {
                                    spacing: 12px; alignment: start;
                                    Text { text: "Stop on Empty:"; width: 120px; vertical-alignment: center; font-size: 11px; }
                                    Rectangle {
                                        width: 40px; height: 20px; border-width: 1px; border-color: #999;
                                        background: #EEE; border-radius: 3px;
                                        TouchArea { clicked => { root.queue-toggle-stop-on-empty(); } }
                                    }
                                }
                            }
                            
                            Rectangle { height: 100%; }
                        }
                    }
                }

                if current-tab == 2: VerticalLayout {
                    padding: 20px; spacing: 0;
                    ScrollView {
                        VerticalLayout {
                            padding: 0; spacing: 24px;
                            Text { text: "Options / Settings"; font-size: 20px; font-weight: 700; color: #004080; }
                            Rectangle { height: 1px; background: #D0D0D0; }
                            
                            // Application Settings Section
                            VerticalLayout {
                                spacing: 12px;
                                Text { text: "Application Settings"; font-size: 14px; font-weight: 600; color: #333; }
                                Rectangle { height: 1px; background: #E0E0E0; }
                                
                                HorizontalLayout {
                                    alignment: start; spacing: 12px;
                                    Text { text: "Auto-Start:"; width: 140px; vertical-alignment: center; font-size: 11px; }
                                    Rectangle {
                                        width: 50px; height: 20px; border-width: 1px; border-color: #999;
                                        background: root.auto-start-enabled ? #00AA00 : #EEE; border-radius: 3px;
                                        TouchArea { clicked => { root.toggle-auto-start(); } }
                                        Text { text: root.auto-start-enabled ? "ON" : "OFF"; horizontal-alignment: center; vertical-alignment: center; font-size: 10px; color: white; }
                                    }
                                }
                                
                                HorizontalLayout {
                                    alignment: start; spacing: 12px;
                                    Text { text: "System Tray:"; width: 140px; vertical-alignment: center; font-size: 11px; }
                                    Rectangle {
                                        width: 50px; height: 20px; border-width: 1px; border-color: #999;
                                        background: root.system-tray-enabled ? #00AA00 : #EEE; border-radius: 3px;
                                        TouchArea { clicked => { root.toggle-system-tray(); } }
                                        Text { text: root.system-tray-enabled ? "ON" : "OFF"; horizontal-alignment: center; vertical-alignment: center; font-size: 10px; color: white; }
                                    }
                                }
                            }
                            
                            // Download Settings Section
                            VerticalLayout {
                                spacing: 12px;
                                Text { text: "Download Settings"; font-size: 14px; font-weight: 600; color: #333; }
                                Rectangle { height: 1px; background: #E0E0E0; }
                                
                                HorizontalLayout {
                                    alignment: start; spacing: 12px;
                                    Text { text: "Default Folder:"; width: 140px; vertical-alignment: center; font-size: 11px; }
                                    StandardInput { width: 350px; text: root.default-folder-text; placeholder: "Select download folder..."; }
                                    ToolbarButton { text: "..."; min-width: 40px; height: 26px; clicked => { root.settings-use-downloads-folder(); } }
                                }
                                
                                HorizontalLayout {
                                    alignment: start; spacing: 12px;
                                    Text { text: "Thread Count:"; width: 140px; vertical-alignment: center; font-size: 11px; }
                                    ToolbarButton { text: "-"; min-width: 32px; icon-type: "minus"; height: 26px; clicked => { root.settings-thread-minus(); } }
                                    Text { text: root.thread-count; width: 40px; vertical-alignment: center; horizontal-alignment: center; font-size: 11px; font-weight: 600; }
                                    ToolbarButton { text: "+"; min-width: 32px; icon-type: "plus"; height: 26px; clicked => { root.settings-thread-plus(); } }
                                    Text { text: "(1-32)"; width: 80px; vertical-alignment: center; font-size: 10px; color: #666; }
                                }
                                
                                HorizontalLayout {
                                    alignment: start; spacing: 12px;
                                    Text { text: "Max Concurrent:"; width: 140px; vertical-alignment: center; font-size: 11px; }
                                    ToolbarButton { text: "-"; min-width: 32px; icon-type: "minus"; height: 26px; clicked => { root.settings-max-minus(); } }
                                    Text { text: root.max-concurrent; width: 40px; vertical-alignment: center; horizontal-alignment: center; font-size: 11px; font-weight: 600; }
                                    ToolbarButton { text: "+"; min-width: 32px; icon-type: "plus"; height: 26px; clicked => { root.settings-max-plus(); } }
                                    Text { text: "(1-10)"; width: 80px; vertical-alignment: center; font-size: 10px; color: #666; }
                                }
                            }
                            
                            // Browser Integration Section
                            VerticalLayout {
                                spacing: 12px;
                                Text { text: "Browser Integration"; font-size: 14px; font-weight: 600; color: #333; }
                                Rectangle { height: 1px; background: #E0E0E0; }
                                
                                HorizontalLayout {
                                    alignment: start; spacing: 12px;
                                    Text { text: "Enable Integration:"; width: 140px; vertical-alignment: center; font-size: 11px; }
                                    Rectangle {
                                        width: 50px; height: 20px; border-width: 1px; border-color: #999;
                                        background: root.browser-integration-enabled ? #00AA00 : #EEE; border-radius: 3px;
                                        TouchArea { clicked => { root.toggle-browser-integration(); } }
                                        Text { text: root.browser-integration-enabled ? "ON" : "OFF"; horizontal-alignment: center; vertical-alignment: center; font-size: 10px; color: white; }
                                    }
                                }
                                
                                HorizontalLayout {
                                    alignment: start; spacing: 12px;
                                    Text { text: "Extension ID:"; width: 140px; vertical-alignment: center; font-size: 11px; }
                                    StandardInput { width: 350px; text: root.browser-extension-id-text; placeholder: "Enter extension ID..."; }
                                }
                                
                                HorizontalLayout {
                                    alignment: start; spacing: 12px; padding-left: 152px;
                                    ToolbarButton { text: "Register Host"; height: 26px; clicked => { root.register-browser-host(); } }
                                }
                            }
                            
                            // Clipboard Monitoring Section
                            VerticalLayout {
                                spacing: 12px;
                                Text { text: "Clipboard Monitoring"; font-size: 14px; font-weight: 600; color: #333; }
                                Rectangle { height: 1px; background: #E0E0E0; }
                                
                                HorizontalLayout {
                                    alignment: start; spacing: 12px;
                                    Text { text: "Enable Monitoring:"; width: 140px; vertical-alignment: center; font-size: 11px; }
                                    Rectangle {
                                        width: 50px; height: 20px; border-width: 1px; border-color: #999;
                                        background: root.clipboard-monitoring-enabled ? #00AA00 : #EEE; border-radius: 3px;
                                        TouchArea { clicked => { root.toggle-clipboard-monitoring(); } }
                                        Text { text: root.clipboard-monitoring-enabled ? "ON" : "OFF"; horizontal-alignment: center; vertical-alignment: center; font-size: 10px; color: white; }
                                    }
                                }
                                
                                Text { text: "Automatically detect URLs in clipboard and show a download confirmation dialog."; font-size: 10px; color: #777; }
                            }
                            
                            // Proxy Settings Section
                            VerticalLayout {
                                spacing: 12px;
                                Text { text: "Proxy Settings"; font-size: 14px; font-weight: 600; color: #333; }
                                Rectangle { height: 1px; background: #E0E0E0; }
                                
                                HorizontalLayout {
                                    alignment: start; spacing: 12px;
                                    Text { text: "Proxy Mode:"; width: 140px; vertical-alignment: center; font-size: 11px; }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Rectangle {
                                            width: 80px; height: 26px; border-width: 1px; border-color: root.proxy-mode == 0 ? #0066CC : #999;
                                            background: root.proxy-mode == 0 ? #E5F1FB : transparent; border-radius: 3px;
                                            TouchArea { clicked => { root.proxy-mode-changed(0); } }
                                            Text { text: "Direct"; horizontal-alignment: center; vertical-alignment: center; font-size: 11px; }
                                        }
                                        Rectangle {
                                            width: 80px; height: 26px; border-width: 1px; border-color: root.proxy-mode == 1 ? #0066CC : #999;
                                            background: root.proxy-mode == 1 ? #E5F1FB : transparent; border-radius: 3px;
                                            TouchArea { clicked => { root.proxy-mode-changed(1); } }
                                            Text { text: "System"; horizontal-alignment: center; vertical-alignment: center; font-size: 11px; }
                                        }
                                        Rectangle {
                                            width: 80px; height: 26px; border-width: 1px; border-color: root.proxy-mode == 2 ? #0066CC : #999;
                                            background: root.proxy-mode == 2 ? #E5F1FB : transparent; border-radius: 3px;
                                            TouchArea { clicked => { root.proxy-mode-changed(2); } }
                                            Text { text: "Manual"; horizontal-alignment: center; vertical-alignment: center; font-size: 11px; }
                                        }
                                    }
                                }
                                
                                if root.proxy-mode == 2: VerticalLayout {
                                    spacing: 8px;
                                    HorizontalLayout {
                                        alignment: start; spacing: 12px;
                                        Text { text: "Proxy Host:"; width: 140px; vertical-alignment: center; font-size: 11px; }
                                        StandardInput { width: 200px; placeholder: "Enter proxy host..."; }
                                    }
                                    HorizontalLayout {
                                        alignment: start; spacing: 12px;
                                        Text { text: "Proxy Port:"; width: 140px; vertical-alignment: center; font-size: 11px; }
                                        StandardInput { width: 100px; placeholder: "8080"; }
                                        ToolbarButton { text: "Test Connection"; height: 26px; clicked => { root.proxy-test-connection(); } }
                                    }
                                }
                            }
                            
                            Rectangle { height: 50px; }
                        }
                    }
                }
            }
        }

        // Status Bar
        Rectangle {
            height: 32px; background: Palette.panel;
            HorizontalLayout {
                padding-left: 12px; padding-right: 12px; spacing: 16px;
                Text { text: root.status-message; font-size: 11px; vertical-alignment: center; color: Palette.text-primary; font-weight: 500; }
                Rectangle { width: 1px; background: Palette.border; }
                Rectangle { width: 100%; }
                Text { text: "Total Jobs: " + download-rows.length; font-size: 11px; vertical-alignment: center; color: Palette.text-muted; }
            }
            Rectangle { y: 0; width: 100%; height: 1px; background: Palette.border; }
        }
    }

    // Delete Confirmation Overlay
    if root.show-delete-confirm: Rectangle {
        background: #00000088;
        Rectangle {
            width: 420px; height: 180px;
            background: Palette.surface; border-color: Palette.border; border-width: 1px;
            border-radius: 8px;
            VerticalLayout {
                padding: 24px; spacing: 18px;
                Text { text: "Confirm Delete"; font-size: 16px; font-weight: 700; color: Palette.text-primary; }
                Text { text: "Are you sure you want to remove the selected download task from the list?"; font-size: 13px; color: Palette.text-muted; }
                HorizontalLayout {
                    spacing: 12px; alignment: end;
                    ToolbarButton { text: "Yes, Delete"; height: 36px; clicked => { root.confirm-delete-selected(); } }
                    ToolbarButton { text: "No, Keep"; height: 36px; clicked => { root.cancel-delete-selected(); } }
                }
            }
        }
    }
}

export component AddUrlDialog inherits Window {
    width: 540px; height: 240px;
    title: "Add Download";
    background: Palette.bg;
    
    in-out property <string> url: "";
    in-out property <string> file-name: "";
    in-out property <string> output-dir: "";

    callback download_later(string, string, string);
    callback start_now(string, string, string);
    callback cancel();

    VerticalLayout {
        padding: 24px; spacing: 16px;
        
        Text { text: "Add New Download"; font-size: 16px; font-weight: 700; color: Palette.text-primary; }
        Rectangle { height: 1px; background: Palette.border; }
        
        VerticalLayout {
            spacing: 6px;
            Text { text: "Address (URL):"; font-size: 12px; font-weight: 600; color: Palette.text-primary; }
            StandardInput { text: root.url; placeholder: "https://..."; edited(t) => { root.url = t; } }
        }
        
        VerticalLayout {
            spacing: 6px;
            Text { text: "Save To Folder:"; font-size: 12px; font-weight: 600; color: Palette.text-primary; }
            HorizontalLayout {
                spacing: 8px;
                StandardInput { text: root.output-dir; placeholder: "Select folder..."; edited(t) => { root.output-dir = t; } }
                ToolbarButton { text: "..."; min-width: 44px; height: 32px; }
            }
        }

        Rectangle { height: 1px; background: Palette.border; }
        
        HorizontalLayout {
            spacing: 12px; alignment: end;
            ToolbarButton { text: "Start Now"; height: 36px; clicked => { root.start_now(root.url, root.file-name, root.output-dir); } }
            ToolbarButton { text: "Queue Later"; height: 36px; clicked => { root.download_later(root.url, root.file-name, root.output-dir); } }
            ToolbarButton { text: "Cancel"; height: 36px; clicked => { root.cancel(); } }
        }
    }
}

export component ClipboardDialog inherits Window {
    width: 640px; height: 320px;
    title: "Download Detected";
    background: Palette.bg;

    in property <string> url: "";
    in property <string> file-name: "";
    in property <string> output-dir: "";

    callback queue_later();
    callback start_now();
    callback dismiss();

    VerticalLayout {
        padding: 24px; spacing: 18px;
        
        Text { text: "New Download Detected"; font-size: 18px; font-weight: 700; color: Palette.accent-primary; }
        Rectangle { height: 1px; background: Palette.border; }
        
        Text { text: "URL: " + root.url; font-size: 12px; color: Palette.text-muted; overflow: elide; font-family: "Consolas"; }
        
        VerticalLayout {
            spacing: 6px;
            Text { text: "File Name:"; font-size: 12px; font-weight: 600; color: Palette.text-primary; }
            StandardInput { text: root.file-name; }
        }

        VerticalLayout {
            spacing: 6px;
            Text { text: "Save To Folder:"; font-size: 12px; font-weight: 600; color: Palette.text-primary; }
            StandardInput { text: root.output-dir; }
        }

        Rectangle { height: 100%; }

        HorizontalLayout {
            spacing: 12px; alignment: center;
            ToolbarButton { text: "Download Now"; height: 40px; clicked => { root.start_now(); } }
            ToolbarButton { text: "Queue Later"; height: 40px; clicked => { root.queue_later(); } }
            ToolbarButton { text: "Cancel"; height: 40px; clicked => { root.dismiss(); } }
        }
    }
}
