# Flow Download Manager - systemd user service
# Install to: ~/.config/systemd/user/flow-service.service
# Enable: systemctl --user enable flow-service
# Start: systemctl --user start flow-service

[Unit]
Description=Flow Download Manager Service
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/flow-service --background
Restart=on-failure
RestartSec=5
Environment=DISPLAY=:0

[Install]
WantedBy=default.target
