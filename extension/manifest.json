{
  "manifest_version": 3,
  "author": "Luu Cong Hoang Nam <flowspeed.link>",
  "name": "Flow Download Manager",
  "version": "1.0.0",
  "description": "Intercept downloads and send them to Flow Download Manager for faster, managed downloads.",
  "permissions": [
    "downloads",
    "downloads.shelf",
    "activeTab",
    "storage",
    "notifications",
    "webRequest"
  ],
  "host_permissions": [
    "http://localhost/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["overlay.css"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Flow Download Manager"
  },
  "homepage_url": "https://luuconghoangnam.github.io/flowspeed.link/",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
